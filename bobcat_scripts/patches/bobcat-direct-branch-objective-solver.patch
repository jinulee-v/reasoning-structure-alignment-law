+  { direct_ctx = ctx;
+    direct_input_ty = input_ty;
+    direct_input_expr = input_expr;
+    direct_solver = solver;
+    direct_objectives = StringMap.empty;
+    direct_last_input = None;
+    direct_unknowns = StringMap.empty }
