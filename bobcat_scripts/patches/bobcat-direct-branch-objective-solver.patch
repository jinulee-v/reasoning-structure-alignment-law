+declaration scope DayOfWeek:
+  input value content date
+  output is_sunday content boolean
+
+scope DayOfWeek:
+  definition is_sunday equals
+    match (Date.day_of_week of value) with pattern
+    -- Sunday: true
+    -- anything: false
