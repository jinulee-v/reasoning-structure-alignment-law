+     safely blocks that exact Catala-visible input before the next query. *)
   let rec take n = function
     | _ when n <= 0 -> []
     | [] -> []
     | x :: xs -> x :: take (n - 1) xs
   in
+  (* Compile one requested reachability formula at a time. Unioning unrelated
+     backward slices makes a batch inherit the largest historical/default
+     closure before any member can be queried. A successful replay still
+     credits every observed source outcome, so this does not force one test per
+     objective; it only keeps formula construction demand-driven. *)
