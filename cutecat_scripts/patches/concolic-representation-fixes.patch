+        ~constraints:[PathConstraint.mk_z3 SymbExpr.incomplete pos true]
+        concrete
+      |> make_ok
+    end
+  | _ ->
+    Message.error ~pos
+      "Unexpected arguments or result for List_internal.nth_element"
