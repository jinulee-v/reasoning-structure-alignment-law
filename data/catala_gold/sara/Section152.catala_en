<!-- rtdf-document-id: sara/section152 -->

> Module Section152
> Using Definitions as W

```catala-metadata
declaration scope QualifyingChild:
  input world content W.World
  input taxpayer content W.Entity
  input individual content W.Entity
  input period content W.TaxPeriod
  output holds content boolean

declaration scope QualifyingRelative:
  input world content W.World
  input taxpayer content W.Entity
  input individual content W.Entity
  input period content W.TaxPeriod
  input qualifying_children_of_others content list of W.Entity
  output holds content boolean

declaration scope Dependent:
  input world content W.World
  input taxpayer content W.Entity
  input individual content W.Entity
  input period content W.TaxPeriod
  input qualifying_children_of_others content list of W.Entity
  output holds content boolean

declaration scope DependentsOf:
  input world content W.World
  input taxpayer content W.Entity
  input candidates content list of W.Entity
  input period content W.TaxPeriod
  output dependents content list of W.Entity

declaration child_or_descendant content boolean
  depends on world content W.World,
             individual content W.Entity,
             ancestor content W.Entity,
             period content W.TaxPeriod

declaration family_relationship content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod

declaration same_household content boolean
  depends on world content W.World,
             one content W.Entity,
             other content W.Entity,
             period content W.TaxPeriod

declaration qualifying_relative_relationship content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod

declaration were_spouses content boolean
  depends on world content W.World,
             one content W.Entity,
             other content W.Entity,
             period content W.TaxPeriod

declaration filed_joint_return content boolean
  depends on world content W.World,
             individual content W.Entity,
             period content W.TaxPeriod

declaration qualifying_child_holds content boolean
  depends on world content W.World,
             taxpayer content W.Entity,
             individual content W.Entity,
             period content W.TaxPeriod
```

```catala
declaration direct_child content boolean
  depends on world content W.World,
             child content W.Entity,
             parent content W.Entity,
             period content W.TaxPeriod
  equals
    exists event among (W.relationship_and_return_events of world) such that
      ((event.kind = W.EventKind.Son or event.kind = W.EventKind.Daughter)
       and W.has_agent of event, child
       and W.has_patient of event, parent
       and W.overlaps_period of event.starts, event.ends, period)
      or
      ((event.kind = W.EventKind.Father or event.kind = W.EventKind.Mother)
       and W.has_agent of event, parent
       and W.has_patient of event, child
       and W.overlaps_period of event.starts, event.ends, period)

declaration sibling_of content boolean
  depends on world content W.World,
             one content W.Entity,
             other content W.Entity,
             period content W.TaxPeriod
  equals
    exists event among (W.relationship_and_return_events of world) such that
      (event.kind = W.EventKind.Brother
       or event.kind = W.EventKind.Sister
       or event.kind = W.EventKind.Sibling)
      and ((W.has_agent of event, one and W.has_patient of event, other)
           or (W.has_agent of event, other and W.has_patient of event, one))
      and W.overlaps_period of event.starts, event.ends, period

declaration child_or_descendant content boolean
  depends on world content W.World,
             individual content W.Entity,
             ancestor content W.Entity,
             period content W.TaxPeriod
  equals
    direct_child of world, individual, ancestor, period
    or (exists middle among
          (combine all event among (W.relationship_and_return_events of world)
           in people initially []
           with people ++ event.agents ++ event.patients)
        such that direct_child of world, middle, ancestor, period
                  and direct_child of world, individual, middle, period)

declaration same_household content boolean
  depends on world content W.World,
             one content W.Entity,
             other content W.Entity,
             period content W.TaxPeriod
  equals
    exists left among (W.relationship_events_of_kind of world, W.EventKind.Residence)
    such that W.has_agent of left, one
      and W.overlaps_period of left.starts, left.ends, period
      and exists right among (W.relationship_events_of_kind of world, W.EventKind.Residence)
          such that W.has_agent of right, other
            and W.overlaps_period of right.starts, right.ends, period
            and exists home among left.patients
                such that W.has_patient of right, home

declaration age_at_end content optional of integer
  depends on world content W.World,
             individual content W.Entity,
             period content W.TaxPeriod
  equals
    match (List.first_element of
      (combine all event among (W.relationship_and_return_events of world)
       in dates initially []
       with if (event.kind = W.EventKind.Birth
                or event.kind = W.EventKind.Son
                or event.kind = W.EventKind.Daughter)
               and W.has_agent of event, individual
            then dates ++ event.starts else dates))
    with pattern
    -- Absent: Absent
    -- Present content born:
       Present content (period.tax_year - (Date.get_year of born))

declaration relationship_for_relative content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod
  equals
    qualifying_relative_relationship of world, individual, taxpayer, period

declaration family_relationship content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod
  equals
    child_or_descendant of world, individual, taxpayer, period
    or sibling_of of world, individual, taxpayer, period
    or child_or_descendant of world, taxpayer, individual, period
    or (exists middle among (W.dependency_candidates of world) such that
          (direct_child of world, taxpayer, middle, period
           and sibling_of of world, individual, middle, period)
          or (direct_child of world, individual, middle, period
              and sibling_of of world, middle, taxpayer, period))

declaration were_spouses content boolean
  depends on world content W.World,
             one content W.Entity,
             other content W.Entity,
             period content W.TaxPeriod
  equals exists marriage among (W.relationship_events_of_kind of world, W.EventKind.Marriage)
         such that W.has_agent of marriage, one
                   and W.has_agent of marriage, other
                   and W.overlaps_period of marriage.starts, marriage.ends, period

declaration qualifying_child_holds content boolean
  depends on world content W.World,
             taxpayer content W.Entity,
             individual content W.Entity,
             period content W.TaxPeriod
  equals qualifying_child_requirements of
    (qualifying_child_relationship of world, individual, taxpayer, period),
    (qualifying_child_residence of world, individual, taxpayer, period),
    (qualifying_child_age of world, individual, taxpayer, period),
    (qualifying_child_no_joint_return of world, individual, period)

declaration qualifying_relative_holds content boolean
  depends on world content W.World,
             taxpayer content W.Entity,
             individual content W.Entity,
             period content W.TaxPeriod,
             qualifying_children_of_others content list of W.Entity
  equals qualifying_relative_requirements of
    (relationship_for_relative of world, individual, taxpayer, period),
    (qualifying_relative_no_income of world, individual, period),
    (not_qualifying_child_of_any_taxpayer of
       individual, qualifying_children_of_others),
    (not (were_spouses of world, individual, taxpayer, period)),
    (not (filed_joint_return of world, individual, period))

declaration dependent_holds content boolean
  depends on world content W.World,
             taxpayer content W.Entity,
             individual content W.Entity,
             period content W.TaxPeriod,
             qualifying_children_of_others content list of W.Entity
  equals qualifying_child_holds of world, taxpayer, individual, period
         or qualifying_relative_holds of world, taxpayer, individual, period,
                                        qualifying_children_of_others
```

§152. Dependent defined

(a) In general

For purposes of this subtitle, the term "dependent" means-


```catala
scope Dependent:
  definition holds equals
    dependent_holds of world, taxpayer, individual, period,
                       qualifying_children_of_others
```

    (1) a qualifying child, or


<!-- rtdf-block-id: sara/section152:b0004; role: provision; provision-id: sara/section152(a)(1); source-lines: 7-7; relation: formalizes-preceding -->
```catala
declaration qualifying_child_alternative content boolean
  depends on is_qualifying_child content boolean
  equals is_qualifying_child
```

    (2) a qualifying relative.


<!-- rtdf-block-id: sara/section152:b0005; role: provision; provision-id: sara/section152(a)(2); source-lines: 9-9; relation: formalizes-preceding -->
```catala
declaration qualifying_relative_alternative content boolean
  depends on is_qualifying_relative content boolean
  equals is_qualifying_relative
```

(b) Exceptions

For purposes of this section-


```catala
declaration dependency_exceptions_clear content boolean
  depends on claimant_is_dependent content boolean,
             candidate_filed_joint_return content boolean
  equals not claimant_is_dependent and not candidate_filed_joint_return
```

    (1) Dependents ineligible

    If an individual is a dependent of a taxpayer for any taxable year of such taxpayer beginning in a calendar year, such individual shall be treated as having no dependents for any taxable year of such individual beginning in such calendar year.


<!-- rtdf-block-id: sara/section152:b0007; role: provision; provision-id: sara/section152(b)(1); source-lines: 15-17; relation: formalizes-preceding -->
```catala
declaration dependent_may_claim_no_dependents content boolean
  depends on claimant_is_dependent content boolean
  equals claimant_is_dependent
```

    (2) Married dependents

    An individual shall not be treated as a dependent of a taxpayer under subsection (a) if such individual has made a joint return with the individual's spouse for the taxable year beginning in the calendar year in which the taxable year of the taxpayer begins.


<!-- rtdf-block-id: sara/section152:b0008; role: provision; provision-id: sara/section152(b)(2); source-lines: 19-21; relation: formalizes-preceding -->
```catala
declaration filed_joint_return content boolean
  depends on world content W.World,
             individual content W.Entity,
             period content W.TaxPeriod
  equals
    exists event among (W.relationship_events_of_kind of world, W.EventKind.JointReturn)
    such that W.has_agent of event, individual
              and (event.agents != [individual])
              and W.covers_period of event.starts, event.ends, period
```

(c) Qualifying child

For purposes of this section-


```catala
declaration qualifying_child_requirements content boolean
  depends on relationship content boolean,
             residence content boolean,
             age_requirement content boolean,
             no_joint_return content boolean
  equals relationship and residence and age_requirement and no_joint_return
```

    (1) In general

    The term "qualifying child" means, with respect to any taxpayer for any taxable year, an individual-


```catala
scope QualifyingChild:
  definition holds equals
    qualifying_child_holds of world, taxpayer, individual, period
```

        (A) who bears a relationship to the taxpayer described in paragraph (2),


<!-- rtdf-block-id: sara/section152:b0011; role: provision; provision-id: sara/section152(c)(1)(A); source-lines: 31-31; relation: formalizes-preceding -->
```catala
declaration qualifying_child_relationship content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod
  equals relationship_described_for_child of world, individual, taxpayer, period
```

        (B) who has the same principal place of abode as the taxpayer for more than one-half of such taxable year,


<!-- rtdf-block-id: sara/section152:b0012; role: provision; provision-id: sara/section152(c)(1)(B); source-lines: 33-33; relation: formalizes-preceding -->
```catala
declaration qualifying_child_residence content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod
  equals same_household of world, individual, taxpayer, period
```

        (C) who meets the age requirements of paragraph (3), and


<!-- rtdf-block-id: sara/section152:b0013; role: provision; provision-id: sara/section152(c)(1)(C); source-lines: 35-35; relation: formalizes-preceding -->
```catala
declaration qualifying_child_age content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod
  equals
    let child_age equals age_at_end of world, individual, period in
    let taxpayer_age equals age_at_end of world, taxpayer, period in
    match child_age with pattern
    -- Absent: false
    -- Present content years:
        years < 25
        and (match taxpayer_age with pattern
             -- Absent: true
             -- Present content older_years: years < older_years)
```

        (E) who has not filed a joint return (other than only for a claim of refund) with the individual's spouse for the taxable year beginning in the calendar year in which the taxable year of the taxpayer begins.


<!-- rtdf-block-id: sara/section152:b0014; role: provision; provision-id: sara/section152(c)(1)(E); source-lines: 37-37; relation: formalizes-preceding -->
```catala
declaration qualifying_child_no_joint_return content boolean
  depends on world content W.World,
             individual content W.Entity,
             period content W.TaxPeriod
  equals not (filed_joint_return of world, individual, period)
```

    (2) Relationship

    For purposes of paragraph (1)(A), an individual bears a relationship to the taxpayer described in this paragraph if such individual is-


```catala
declaration relationship_described_for_child content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod
  equals child_relationship_clause of world, individual, taxpayer, period
         or sibling_relationship_clause of world, individual, taxpayer, period
```

        (A) a child of the taxpayer or a descendant of such a child, or


<!-- rtdf-block-id: sara/section152:b0016; role: provision; provision-id: sara/section152(c)(2)(A); source-lines: 43-43; relation: formalizes-preceding -->
```catala
declaration child_relationship_clause content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod
  equals child_or_descendant of world, individual, taxpayer, period
```

        (B) a brother, sister, stepbrother, or stepsister of the taxpayer or a descendant of any such relative.


<!-- rtdf-block-id: sara/section152:b0017; role: provision; provision-id: sara/section152(c)(2)(B); source-lines: 45-45; relation: formalizes-preceding -->
```catala
declaration sibling_relationship_clause content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod
  equals
    sibling_of of world, individual, taxpayer, period
    or (exists sibling among (W.dependency_candidates of world) such that
          sibling_of of world, sibling, taxpayer, period
          and child_or_descendant of world, individual, sibling, period)
```

    (3) Age requirements

    For purposes of paragraph (1)(C), an individual meets the requirements of this paragraph if such individual is younger than the taxpayer claiming such individual as a qualifying child and is less than 25 years old at the end of the taxable year.


<!-- rtdf-block-id: sara/section152:b0018; role: provision; provision-id: sara/section152(c)(3); source-lines: 47-49; relation: formalizes-preceding -->
```catala
declaration child_age_requirement content boolean
  depends on child_age content optional of integer,
             taxpayer_age content optional of integer
  equals match child_age with pattern
    -- Absent: true
    -- Present content years:
        years < 25
        and (match taxpayer_age with pattern
             -- Absent: true
             -- Present content taxpayer_years: years < taxpayer_years)
```

(d) Qualifying relative

For purposes of this section-


```catala
scope QualifyingRelative:
  definition holds equals
    qualifying_relative_holds of world, taxpayer, individual, period,
                                 qualifying_children_of_others
```

    (1) In general

    The term "qualifying relative" means, with respect to any taxpayer for any taxable year, an individual-


```catala
declaration qualifying_relative_requirements content boolean
  depends on relationship content boolean,
             no_income content boolean,
             not_qualifying_child content boolean,
             not_spouse content boolean,
             no_joint_return content boolean
  equals relationship and no_income and not_qualifying_child
         and not_spouse and no_joint_return
```

        (A) who bears a relationship to the taxpayer described in paragraph (2),


<!-- rtdf-block-id: sara/section152:b0021; role: provision; provision-id: sara/section152(d)(1)(A); source-lines: 59-59; relation: formalizes-preceding -->
```catala
declaration qualifying_relative_relationship_requirement content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod
  equals qualifying_relative_relationship of world, individual, taxpayer, period
```

        (B) who has no income for the calendar year in which such taxable year begins, and


<!-- rtdf-block-id: sara/section152:b0022; role: provision; provision-id: sara/section152(d)(1)(B); source-lines: 61-61; relation: formalizes-preceding -->
```catala
declaration qualifying_relative_no_income content boolean
  depends on world content W.World,
             individual content W.Entity,
             period content W.TaxPeriod
  equals (W.gross_income_individual of world, individual, period) = $0
```

        (D) who is not a qualifying child of such taxpayer or of any other taxpayer for any taxable year beginning in the calendar year in which such taxable year begins.


<!-- rtdf-block-id: sara/section152:b0023; role: provision; provision-id: sara/section152(d)(1)(D); source-lines: 63-63; relation: formalizes-preceding -->
```catala
declaration not_qualifying_child_of_any_taxpayer content boolean
  depends on individual content W.Entity,
             qualifying_children_of_others content list of W.Entity
  equals not (qualifying_children_of_others contains individual)
```

    (2) Relationship

    For purposes of paragraph (1)(A), an individual bears a relationship to the taxpayer described in this paragraph if the individual is any of the following with respect to the taxpayer:


```catala
declaration qualifying_relative_relationship content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod
  equals relative_child_relationship of world, individual, taxpayer, period
         or relative_sibling_relationship of world, individual, taxpayer, period
         or relative_parent_relationship of world, individual, taxpayer, period
         or relative_step_parent_relationship of world, individual, taxpayer, period
         or relative_niece_nephew_relationship of world, individual, taxpayer, period
         or relative_aunt_uncle_relationship of world, individual, taxpayer, period
         or relative_in_law_relationship of world, individual, taxpayer, period
         or household_member_relationship of world, individual, taxpayer, period
```

        (A) A child or a descendant of a child.


<!-- rtdf-block-id: sara/section152:b0025; role: provision; provision-id: sara/section152(d)(2)(A); source-lines: 69-69; relation: formalizes-preceding -->
```catala
declaration relative_child_relationship content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod
  equals child_or_descendant of world, individual, taxpayer, period
```

        (B) A brother, sister, stepbrother, or stepsister.


<!-- rtdf-block-id: sara/section152:b0026; role: provision; provision-id: sara/section152(d)(2)(B); source-lines: 71-71; relation: formalizes-preceding -->
```catala
declaration relative_sibling_relationship content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod
  equals sibling_of of world, individual, taxpayer, period
```

        (C) The father or mother, or an ancestor of either.


<!-- rtdf-block-id: sara/section152:b0027; role: provision; provision-id: sara/section152(d)(2)(C); source-lines: 73-73; relation: formalizes-preceding -->
```catala
declaration relative_parent_relationship content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod
  equals child_or_descendant of world, taxpayer, individual, period
```

        (D) A stepfather or stepmother.


<!-- rtdf-block-id: sara/section152:b0028; role: provision; provision-id: sara/section152(d)(2)(D); source-lines: 75-75; relation: formalizes-preceding -->
```catala
declaration relative_step_parent_relationship content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod
  equals exists parent among (W.dependency_candidates of world) such that
    direct_child of world, taxpayer, parent, period
    and were_spouses of world, individual, parent, period
```

        (E) A son or daughter of a brother or sister of the taxpayer.


<!-- rtdf-block-id: sara/section152:b0029; role: provision; provision-id: sara/section152(d)(2)(E); source-lines: 77-77; relation: formalizes-preceding -->
```catala
declaration relative_niece_nephew_relationship content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod
  equals exists sibling among (W.dependency_candidates of world) such that
    sibling_of of world, sibling, taxpayer, period
    and direct_child of world, individual, sibling, period
```

        (F) A brother or sister of the father or mother of the taxpayer.


<!-- rtdf-block-id: sara/section152:b0030; role: provision; provision-id: sara/section152(d)(2)(F); source-lines: 79-79; relation: formalizes-preceding -->
```catala
declaration relative_aunt_uncle_relationship content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod
  equals exists parent among (W.dependency_candidates of world) such that
    direct_child of world, taxpayer, parent, period
    and sibling_of of world, individual, parent, period
```

        (G) A son-in-law, daughter-in-law, father-in-law, mother-in-law, brother-in-law, or sister-in-law.


<!-- rtdf-block-id: sara/section152:b0031; role: provision; provision-id: sara/section152(d)(2)(G); source-lines: 81-81; relation: formalizes-preceding -->
```catala
declaration relative_in_law_relationship content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod
  equals exists bridge among (W.dependency_candidates of world) such that
    (were_spouses of world, individual, bridge, period
     and (direct_child of world, bridge, taxpayer, period
          or sibling_of of world, bridge, taxpayer, period))
    or (were_spouses of world, taxpayer, bridge, period
        and (direct_child of world, bridge, individual, period
             or sibling_of of world, individual, bridge, period))

scope DependentsOf:
  definition dependents equals
    let qualifying_children equals
      list of child among candidates such that
        exists other_taxpayer among candidates such that
          not (W.same_entity of child, other_taxpayer)
          and qualifying_child_holds of
                world, other_taxpayer, child, period in
    list of individual among candidates such that
      not (W.same_entity of individual, taxpayer)
      and dependent_holds of world, taxpayer, individual, period,
                             qualifying_children
```

        (H) An individual (other than an individual who at any time during the taxable year was the spouse, determined without regard to section 7703, of the taxpayer) who, for the taxable year of the taxpayer, has the same principal place of abode as the taxpayer and is a member of the taxpayer's household.

<!-- rtdf-block-id: sara/section152:b0032; role: provision; provision-id: sara/section152(d)(2)(H); source-lines: 83-83; relation: formalizes-preceding -->
```catala
declaration household_member_relationship content boolean
  depends on world content W.World,
             individual content W.Entity,
             taxpayer content W.Entity,
             period content W.TaxPeriod
  equals not (were_spouses of world, individual, taxpayer, period)
         and same_household of world, individual, taxpayer, period
```
