## Preserve the public §63 query surface while the whole-tax path calls the
## scalar core directly.

scope TaxableIncome:
  definition gross equals core.gross

scope TaxableIncome:
  definition itemizes equals core.itemizes

scope TaxableIncome:
  definition itemized_total equals core.itemized_total

scope TaxableIncome:
  definition deductions_allowed equals core.deductions_allowed

scope TaxableIncome:
  definition exemptions equals core.exemptions

scope TaxableIncome:
  definition income_a equals core.income_a

scope TaxableIncome:
  definition income_b equals core.income_b

scope TaxableIncome:
  definition standard_component equals core.standard_component

scope TaxableIncome:
  definition exemption_component equals core.exemption_component

scope TaxableIncome:
  definition income equals core.income

scope TaxableIncome:
  definition applies equals core.applies

  ## §63(a) and (b) read `gross_income/3`, not `gross_income_individual/3`, so
  ## a taxpayer filing jointly is taxed on both incomes. §68 sees the same
  ## figure as its adjusted gross income, because this is what it is passed.

scope TaxableIncomeHolds:
  definition holds equals
    (let ti equals
       (output of TaxableIncome with {
          -- world: world -- injections: injections -- taxpayer: taxpayer
          -- taxable_year: taxable_year
          -- child_of: child_of -- sibling_of: sibling_of
          -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
          -- stepparent_of: stepparent_of
          -- child_in_law_of: child_in_law_of
          -- parent_in_law_of: parent_in_law_of
          -- sibling_in_law_of: sibling_in_law_of }) in
     match clause with pattern
     # (a) needs §63(d) to succeed, i.e. the taxpayer itemizes
     -- SubsectionA: ti.itemizes and ti.income_a = claimed
     # (b) needs it to fail
     -- SubsectionB: (not ti.itemizes) and ti.income_b = claimed)

scope StandardDeductionHolds:

scope StandardDeductionHolds:
  definition holds equals
    let individual_result equals
      (output of S151.Individual with {
         -- world: world -- injections: injections -- taxpayer: taxpayer
         -- taxable_year: taxable_year
         -- child_of: child_of -- sibling_of: sibling_of
         -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
         -- stepparent_of: stepparent_of
         -- child_in_law_of: child_in_law_of
         -- parent_in_law_of: parent_in_law_of
         -- sibling_in_law_of: sibling_in_law_of })
    in (output of StandardDeduction with {
          -- world: world -- injections: injections -- taxpayer: taxpayer
          -- taxable_year: taxable_year
          -- child_of: child_of -- sibling_of: sibling_of
          -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
          -- stepparent_of: stepparent_of
          -- child_in_law_of: child_in_law_of
          -- parent_in_law_of: parent_in_law_of
          -- sibling_in_law_of: sibling_in_law_of
          -- individual_all_spouses: individual_result.all_spouses
          -- individual_exempt_spouses: individual_result.exempt_spouses
          -- individual_disallowed: individual_result.disallowed }).amount = claimed

scope ExemptionListHolds:

scope ExemptionListHolds:
  definition granted_unconstrained equals
    exists inj among
      ((W.injections_for_5_15 of injections, P.pred_s151_5, taxpayer.id, W.num_key of taxable_year))
    such that W.s151_exemption_amounts_unbound of inj

scope ExemptionListHolds:
  definition holds equals
    granted_unconstrained
    or ((let ti equals
           (output of TaxableIncome with {
              -- world: world -- injections: injections -- taxpayer: taxpayer
              -- taxable_year: taxable_year
              -- child_of: child_of -- sibling_of: sibling_of
              -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
              -- stepparent_of: stepparent_of
              -- child_in_law_of: child_in_law_of
              -- parent_in_law_of: parent_in_law_of
              -- sibling_in_law_of: sibling_in_law_of }) in
         # `s63_d_2(Taxp,Ded151,Taxy) :- s151(Taxp,_,_,Ded151,Taxy)`: with
         # `s151/5` replaced and no row for this taxpayer the call fails, and
         # an empty list of exemptions is not the same answer. See D39.
         ti.applies and ti.exemption_amounts = claimed))
```

§63. Taxable income defined

(a) In general

Except as provided in subsection (b), for purposes of this subtitle, the term "taxable income" means gross income minus the deductions allowed by this chapter (other than the standard deduction).


<!-- rtdf-block-id: sara/section63:b0003; role: provision; provision-id: sara/section63(a); source-lines: 3-5; relation: formalizes-preceding -->
```catala
scope TaxableIncomeDetails:
  definition gross equals
    (output of Inc.GrossIncome with {
       -- world: world -- person: taxpayer
       -- taxable_year: taxable_year
       -- joint_spouse: personal_exemptions.joint_spouse
     }).total

scope TaxableIncomeForTax:
  definition gross equals
    (output of Inc.GrossIncome with {
       -- world: world -- person: taxpayer
       -- taxable_year: taxable_year
       -- joint_spouse: personal_exemptions.joint_spouse
     }).total

scope TaxableIncomeDetails:
  definition itemized_injections equals
    W.injections_for_4_14 of injections, P.pred_s63_d_4, taxpayer.id, W.num_key of taxable_year

scope TaxableIncomeForTax:
  definition itemized_injections equals
    W.injections_for_4_14 of injections, P.pred_s63_d_4, taxpayer.id, W.num_key of taxable_year

scope TaxableIncomeDetails:
  definition injected_itemizes equals
    W.injected_holds of itemized_injections

scope TaxableIncomeForTax:
  definition injected_itemizes equals
    W.injected_holds of itemized_injections

scope TaxableIncomeDetails:
  definition itemizes equals
    # A case may grant `s63_d/4` outright, which makes the taxpayer an itemizer
    # even with no deduction events of their own. Test that direct grant first:
    # it is the first Prolog clause and avoids traversing deduction evidence
    # after it has already answered the relation.
    injected_itemizes
    or (itemizes_from_world of world, taxpayer, taxable_year)

scope TaxableIncomeForTax:
  definition itemizes equals
    injected_itemizes
    or (itemizes_from_world of world, taxpayer, taxable_year)

scope TaxableIncomeDetails:
  definition itemized_total equals
    if injected_itemizes
    then
      (match (W.injected_money of itemized_injections, 3) with pattern
       -- Absent: $0
       -- Present content m: m)
    else itemized_deductions.total

scope TaxableIncomeDetails:
  definition deductions_allowed equals
    (output of S68.Section68 with {
       -- taxable_year: taxable_year
       -- status: S68.status_of_filing of
                    standard_deduction.status
       -- agi: gross
       -- itemized_deductions: itemized_total }).deductions_out

scope TaxableIncomeDetails:
  definition exemptions equals
    personal_exemptions.total

scope TaxableIncomeForTax:
  definition exemptions equals
    personal_exemptions.total

scope TaxableIncomeDetails:
  definition surviving_spouse equals standard_deduction.surviving_spouse

scope TaxableIncomeForTax:
  definition surviving_spouse equals filing_status.surviving_spouse

scope TaxableIncomeDetails:
  definition head_of_household equals standard_deduction.head_of_household

scope TaxableIncomeForTax:
  definition head_of_household equals filing_status.head_of_household

scope TaxableIncomeDetails:
  definition spouses equals personal_exemptions.all_spouses

scope TaxableIncomeForTax:
  definition spouses equals personal_exemptions.all_spouses

scope TaxableIncome:
  definition exemption_amounts equals
    personal_exemptions.amounts

  # `s63(Taxp,Taxy,Taxinc) :- ( s63_b(...) ; ( \+ s63_b(...), s63_a(...) ) )`.
  # The standard-deduction branch needs §63(c); when a case *replaces* that
  # predicate (D22) and names nobody relevant, (b) fails, and with no itemized
  # deductions to fall back on §63 fails outright — so §1 does too and `tax/3`
  # reports zero. §63 itself can be replaced the same way.

scope TaxableIncomeDetails:
  definition applies equals
    (W.pred_available of injections, P.pred_s63_3, (W.injections_for_3_12 of injections, P.pred_s63_3, taxpayer.id, W.num_key of taxable_year))
    and (itemizes
         or ((W.pred_available of injections, P.pred_s63_c_3, (W.injections_for_3_12 of injections, P.pred_s63_c_3, taxpayer.id, W.num_key of taxable_year))
             and (W.pred_available of injections, P.pred_s63_c_1_3, (W.injections_for_3_12 of injections, P.pred_s63_c_1_3, taxpayer.id, W.num_key of taxable_year))
             and (W.pred_available of injections, P.pred_s63_c_2_3, (W.injections_for_3_12 of injections, P.pred_s63_c_2_3, taxpayer.id, W.num_key of taxable_year))
             and (W.pred_available of injections, P.pred_s63_c_3_3, (W.injections_for_3_13 of injections, P.pred_s63_c_3_3, taxpayer.id, W.num_key of taxable_year))))
    and personal_exemptions.applies

scope TaxableIncomeForTax:
  definition applies equals
    (W.pred_available of injections, P.pred_s63_3,
       (W.injections_for_3_12 of injections, P.pred_s63_3,
          taxpayer.id, W.num_key of taxable_year))
    and (itemizes
         or ((W.pred_available of injections, P.pred_s63_c_3,
                (W.injections_for_3_12 of injections, P.pred_s63_c_3,
                   taxpayer.id, W.num_key of taxable_year))
             and (W.pred_available of injections, P.pred_s63_c_1_3,
                    (W.injections_for_3_12 of injections, P.pred_s63_c_1_3,
                       taxpayer.id, W.num_key of taxable_year))
             and (W.pred_available of injections, P.pred_s63_c_2_3,
                    (W.injections_for_3_12 of injections, P.pred_s63_c_2_3,
                       taxpayer.id, W.num_key of taxable_year))
             and (W.pred_available of injections, P.pred_s63_c_3_3,
                    (W.injections_for_3_13 of injections, P.pred_s63_c_3_3,
                       taxpayer.id, W.num_key of taxable_year))))
    and personal_exemptions.applies

scope TaxableIncomeDetails:
  definition income_a equals
    Money.max of $0, (gross - (deductions_allowed + exemptions))

```

```catala-metadata
declaration scope TaxableIncome:
  input world content W.World
  input injections content list of W.Injection
  input taxpayer content W.Entity
  input taxable_year content integer
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input stepparent_of content list of K.Kinship
  input child_in_law_of content list of K.Kinship
  input parent_in_law_of content list of K.Kinship
  input sibling_in_law_of content list of K.Kinship
  personal_exemptions scope S151.Personal
  core scope TaxableIncomeDetails
  output gross content money
  output itemizes content boolean
  output itemized_total content money
  ## after §68
  output deductions_allowed content money
  ## §151, both the total and the list of amounts (a) and (d)(2) need
  output exemptions content money
  output exemption_amounts content list of money
  ## s63_a/5 — the third argument
  output income_a content money
  ## s63_b/4 — the third argument
  output income_b content money
  ## §63(b)(1) and (b)(2), kept explicit so their provisions appear in traces.
  output standard_component content money
  output exemption_component content money
  ## s63/3
  output income content money
  ## §63 needs §151 to succeed. A *replaced* `s151/5` that names nobody
  ## relevant makes it fail rather than contribute zero -- see D39.
  output applies content boolean

## Scalar tax path: it deliberately omits `exemption_amounts`, the
## taxpayer-plus-spouse compatibility list that §1 never consumes.

declaration scope TaxableIncomeDetails:
  input world content W.World
  input injections content list of W.Injection
  input taxpayer content W.Entity
  input taxable_year content integer
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input stepparent_of content list of K.Kinship
  input child_in_law_of content list of K.Kinship
  input parent_in_law_of content list of K.Kinship
  input sibling_in_law_of content list of K.Kinship
  itemized_deductions scope ItemizedDeductions
  personal_exemptions scope S151.PersonalTotal
  standard_deduction scope StandardDeduction
  internal itemized_injections content list of W.Injection
  internal injected_itemizes content boolean
  output gross content money
  output itemizes content boolean
  output itemized_total content money
  output deductions_allowed content money
  output exemptions content money
  output income_a content money
  output income_b content money
  output standard_component content money
  output exemption_component content money
  output income content money
  output applies content boolean
  ## Filing-status facts already computed by the standard-deduction path and
  ## reused by §1 instead of evaluating the same determination a second time.
  output surviving_spouse content boolean
  output head_of_household content boolean
  output spouses content list of W.Entity

## Minimal §63 result used only by §1.  Unlike TaxableIncomeDetails, this
## scope does not materialize both subsection results and every public
## intermediate before choosing the applicable statutory route.
declaration scope TaxableIncomeForTax:
  input world content W.World
  input injections content list of W.Injection
  input taxpayer content W.Entity
  input taxable_year content integer
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input stepparent_of content list of K.Kinship
  input child_in_law_of content list of K.Kinship
  input parent_in_law_of content list of K.Kinship
  input sibling_in_law_of content list of K.Kinship
  personal_exemptions scope S151.PersonalTotal
  filing_status scope St.StatusDeterminationFromRelations
  internal itemized_injections content list of W.Injection
  internal injected_itemizes content boolean
  internal gross content money
  internal exemptions content money
  internal itemizes content boolean
  output income content money
  output applies content boolean
  output surviving_spouse content boolean
  output head_of_household content boolean
  output spouses content list of W.Entity
```



(b) Individuals who do not itemize their deductions

In the case of an individual who does not elect to itemize his deductions for the taxable year, for purposes of this subtitle, the term "taxable income" means adjusted gross income, minus-


<!-- rtdf-block-id: sara/section63:b0004; role: provision; provision-id: sara/section63(b); source-lines: 7-9; relation: formalizes-preceding -->
```catala
scope TaxableIncomeDetails:
  definition income_b equals
    Money.max of $0, (gross - standard_component - exemption_component)

  ## §63 prefers (b) where it applies, and falls back to (a). Evaluating this
  ## definition checks the non-itemizer condition even when subsection (a)
  ## ultimately supplies the result.
scope TaxableIncomeDetails:
  definition income equals if itemizes then income_a else income_b

scope TaxableIncomeForTax:
  definition income equals
    if itemizes
    then
      # §63(a): decode an injected total only on the injected route; otherwise
      # evaluate the itemized-deduction scope only on this branch.
      let itemized_total equals
        if injected_itemizes
        then
          (match (W.injected_money of itemized_injections, 3) with pattern
           -- Absent: $0
           -- Present content m: m)
        else
          (output of ItemizedDeductions with {
             -- world: world -- taxpayer: taxpayer
             -- taxable_year: taxable_year }).total
      in let deductions_allowed equals
        (output of S68.Section68 with {
           -- taxable_year: taxable_year
           -- status: S68.status_of_filing of filing_status.status
           -- agi: gross
           -- itemized_deductions: itemized_total }).deductions_out
      in Money.max of $0, (gross - (deductions_allowed + exemptions))
    else
      # §63(b): the entire standard-deduction calculation is branch-local.
      let standard_component equals
        (output of StandardDeductionForTax with {
           -- world: world -- injections: injections -- taxpayer: taxpayer
           -- taxable_year: taxable_year
           -- status: filing_status.status
           -- married: filing_status.married
           -- joint_return: filing_status.joint_return
           -- surviving_spouse: filing_status.surviving_spouse
           -- spouses_under_a: filing_status.spouses_under_a
           -- individual_all_spouses: personal_exemptions.all_spouses
           -- individual_exempt_spouses: personal_exemptions.exempt_spouses
           -- individual_disallowed: personal_exemptions.disallowed }).amount
      in Money.max of $0, (gross - standard_component - exemptions)

```

    (1) the standard deduction, and


<!-- rtdf-block-id: sara/section63:b0005; role: provision; provision-id: sara/section63(b)(1); source-lines: 11-11; relation: formalizes-preceding -->
```catala
scope TaxableIncomeDetails:
  definition standard_component equals standard_deduction.amount
```

    (2) the deduction for personal exemptions provided in section 151.


<!-- rtdf-block-id: sara/section63:b0006; role: provision; provision-id: sara/section63(b)(2); source-lines: 13-13; relation: formalizes-preceding -->
```catala
scope TaxableIncomeDetails:
  definition exemption_component equals exemptions
```

(c) Standard deduction

For purposes of this subtitle-


<!-- rtdf-block-id: sara/section63:b0007; role: provision; provision-id: sara/section63(c); source-lines: 15-17; relation: formalizes-preceding -->
```catala
scope StandardDeduction:
  definition status equals
    filing_status.status

scope StandardDeduction:
  definition surviving_spouse equals filing_status.surviving_spouse

scope StandardDeduction:
  definition head_of_household equals filing_status.head_of_household

scope StandardDeduction:
  definition not_eligible equals
    (output of NotEligible with {
       -- world: world -- taxpayer: taxpayer -- taxable_year: taxable_year
       -- married: filing_status.married
       -- joint_return: filing_status.joint_return
       -- spouses: filing_status.spouses_under_a }).not_eligible

  # Every spouse for whom `s151_b_applies(Taxp,Spouse,Taxy)` holds: §151
  # derives the set, and a grant contributes the spouse it names --- or, where
  # it left that argument free, every spouse §7703 offers, because the free
  # variable unifies with each in turn. Replacing the predicate leaves nothing
  # but the rows. See D22 and D80.

scope StandardDeduction:
  definition exempt_spouses equals
    (let granted equals
        (combine all r
           among (map each inj among
                   ((W.injections_for_3_13 of injections, P.pred_s151_b_applies_3, taxpayer.id, W.num_key of taxable_year))
                  to (match (W.injection_entity of inj, 2) with pattern
                      -- Absent: individual_all_spouses
                      -- Present content sp: [sp]))
           in acc initially [] with acc ++ r) in
      if W.pred_overridden of injections, P.pred_s151_b_applies_3
      then granted
      else granted ++ individual_exempt_spouses)

```

```catala-metadata
declaration scope StandardDeduction:
  input world content W.World
  input injections content list of W.Injection
  input taxpayer content W.Entity
  input taxable_year content integer
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input stepparent_of content list of K.Kinship
  input child_in_law_of content list of K.Kinship
  input parent_in_law_of content list of K.Kinship
  input sibling_in_law_of content list of K.Kinship
  filing_status scope St.StatusDeterminationFromRelations
  ## §151 has already computed these facts for the same taxpayer and year on
  ## the whole-tax path. They remain explicit inputs so standalone §63 queries
  ## can supply the same §151 result without changing this provision's logic.
  input individual_all_spouses content list of W.Entity
  input individual_exempt_spouses content list of W.Entity
  input individual_disallowed content boolean
  output status content St.Status
  ## (c)(6)
  output not_eligible content boolean
  ## (c)(2), before the (c)(5) cap
  output basic_uncapped content money
  ## (c)(1)(A)
  output basic content money
  ## The §7703 spouses §151(b) allows an additional exemption for
  output exempt_spouses content list of W.Entity
  ## (c)(1)(B) = s63_c_3 = §63(f)
  output additional content money
  output additional_under_c3 content money
  ## s63_c_1/3 and s63_c/3
  output amount content money
  output surviving_spouse content boolean
  output head_of_household content boolean

## Scalar form used by §63(b) when only the final deduction is consumed.  Its
## filing facts are supplied by the caller so §7703 is not evaluated twice,
## and its component scopes remain inside the statutory branches below.
declaration scope StandardDeductionForTax:
  input world content W.World
  input injections content list of W.Injection
  input taxpayer content W.Entity
  input taxable_year content integer
  input status content St.Status
  input married content boolean
  input joint_return content boolean
  input surviving_spouse content boolean
  input spouses_under_a content list of W.Entity
  input individual_all_spouses content list of W.Entity
  input individual_exempt_spouses content list of W.Entity
  input individual_disallowed content boolean
  output amount content money
```



    (1) In general

    Except as otherwise provided in this subsection, the term "standard deduction" means the sum of-


<!-- rtdf-block-id: sara/section63:b0008; role: provision; provision-id: sara/section63(c)(1); source-lines: 19-21; relation: formalizes-preceding -->
```catala
scope StandardDeduction:
  definition amount equals
    # `s63_c/3` is the outer call and therefore precedes its `s63_c_1/3`
    # fallback when both predicates are injected.
    let outer_grants equals
      W.injections_for_3_12 of injections, P.pred_s63_c_3, taxpayer.id, W.num_key of taxable_year
    in if W.injected_holds of outer_grants
       then
         (match (W.injected_money of outer_grants, 3) with pattern
          -- Absent: $0
          -- Present content m: m)
       else
         let fallback_grants equals
           W.injections_for_3_12 of injections, P.pred_s63_c_1_3, taxpayer.id, W.num_key of taxable_year
         in if W.injected_holds of fallback_grants
            then
              (match (W.injected_money of fallback_grants, 3) with pattern
               -- Absent: $0
               -- Present content m: m)
            else if not_eligible then $0 else basic + additional

scope StandardDeductionForTax:
  definition amount equals
    # Preserve the Prolog clause order: a grant of the outer §63(c) predicate
    # precedes a grant of §63(c)(1), and both precede the derived provisions.
    let outer_grants equals
      W.injections_for_3_12 of injections, P.pred_s63_c_3,
        taxpayer.id, W.num_key of taxable_year
    in if W.injected_holds of outer_grants
       then
         (match (W.injected_money of outer_grants, 3) with pattern
          -- Absent: $0
          -- Present content m: m)
       else
         let fallback_grants equals
           W.injections_for_3_12 of injections, P.pred_s63_c_1_3,
             taxpayer.id, W.num_key of taxable_year
         in if W.injected_holds of fallback_grants
            then
              (match (W.injected_money of fallback_grants, 3) with pattern
               -- Absent: $0
               -- Present content m: m)
            else
              let not_eligible equals
                (output of NotEligible with {
                   -- world: world -- taxpayer: taxpayer
                   -- taxable_year: taxable_year -- married: married
                   -- joint_return: joint_return
                   -- spouses: spouses_under_a }).not_eligible
              in if not_eligible then $0
                 else
                   let basic_uncapped equals
                     let grants equals
                       W.injections_for_3_12 of injections,
                         P.pred_s63_c_2_3, taxpayer.id,
                         W.num_key of taxable_year
                     in if W.injected_holds of grants
                        then
                          (match (W.injected_money of grants, 3) with pattern
                           -- Absent: $0
                           -- Present content m: m)
                        else
                          (output of BasicStandardDeduction with {
                             -- status: status
                             -- joint_return: joint_return
                             -- surviving_spouse: surviving_spouse
                             -- taxable_year: taxable_year }).amount
                   in let basic equals
                     if dependent_cap_applies of
                          injections, taxpayer, taxable_year,
                          individual_disallowed
                     then
                       Money.min of basic_uncapped,
                         (output of DependentCap with {
                            -- world: world -- injections: injections
                            -- taxpayer: taxpayer
                            -- taxable_year: taxable_year
                            -- dependent_of_another:
                                 individual_disallowed }).cap
                     else basic_uncapped
                   in let granted_exempt_spouses equals
                     (combine all r
                        among (map each inj among
                                ((W.injections_for_3_13 of injections,
                                    P.pred_s151_b_applies_3, taxpayer.id,
                                    W.num_key of taxable_year))
                               to (match (W.injection_entity of inj, 2) with pattern
                                   -- Absent: individual_all_spouses
                                   -- Present content sp: [sp]))
                        in acc initially [] with acc ++ r)
                   in let exempt_spouses equals
                     if W.pred_overridden of
                          injections, P.pred_s151_b_applies_3
                     then granted_exempt_spouses
                     else granted_exempt_spouses ++ individual_exempt_spouses
                   in let additional_grants equals
                     W.injections_for_3_13 of injections,
                       P.pred_s63_c_3_3, taxpayer.id,
                       W.num_key of taxable_year
                   in let additional equals
                     if W.injected_holds of additional_grants
                     then
                       (match (W.injected_money of additional_grants, 2) with pattern
                        -- Absent: $0
                        -- Present content m: m)
                     else
                       (output of AgedOrBlind with {
                          -- world: world -- injections: injections
                          -- taxpayer: taxpayer
                          -- taxable_year: taxable_year -- married: married
                          -- surviving_spouse: surviving_spouse
                          -- exempt_spouses: exempt_spouses }).additional
                   in basic + additional
```

        (A) the basic standard deduction, and


<!-- rtdf-block-id: sara/section63:b0009; role: provision; provision-id: sara/section63(c)(1)(A); source-lines: 23-23; relation: formalizes-preceding -->
```catala
scope StandardDeduction:
  definition basic equals
    if dependent_cap_applies of
         injections, taxpayer, taxable_year, individual_disallowed
    then
      # Gross income is needed to compute the cap only when §63(c)(5) applies.
      # Keeping the scope call in this arm avoids constructing that income on
      # every ordinary standard-deduction path.
      Money.min of basic_uncapped,
        (output of DependentCap with {
           -- world: world -- injections: injections -- taxpayer: taxpayer
           -- taxable_year: taxable_year
           -- dependent_of_another: individual_disallowed }).cap
    else basic_uncapped
```

        (B) the additional standard deduction.


<!-- rtdf-block-id: sara/section63:b0010; role: provision; provision-id: sara/section63(c)(1)(B); source-lines: 25-25; relation: formalizes-preceding -->
```catala
scope StandardDeduction:
  definition additional equals
    additional_under_c3
```

    (2) Basic standard deduction

    For purposes of paragraph (1), the basic standard deduction is-


<!-- rtdf-block-id: sara/section63:b0011; role: provision; provision-id: sara/section63(c)(2); source-lines: 27-29; relation: formalizes-preceding -->
```catala
scope BasicStandardDeduction:
  definition amount equals
    if doubled then doubled_amount
    else if status = St.Status.HeadOfHousehold
    then head_of_household_amount
    else residual_amount

scope StandardDeduction:
  definition basic_uncapped equals
    let grants equals
      W.injections_for_3_12 of injections, P.pred_s63_c_2_3, taxpayer.id, W.num_key of taxable_year in
    if W.injected_holds of grants
    then
      (match (W.injected_money of grants, 3) with pattern
       -- Absent: $0
       -- Present content m: m)
    else
      (output of BasicStandardDeduction with {
         -- status: status
         -- joint_return: filing_status.joint_return
         -- surviving_spouse: filing_status.surviving_spouse
         -- taxable_year: taxable_year }).amount
```

```catala-metadata
declaration scope BasicStandardDeduction:
  input status content St.Status
  input joint_return content boolean
  input surviving_spouse content boolean
  input taxable_year content integer
  output joint_return_case content boolean
  output surviving_spouse_case content boolean
  output doubled content boolean
  output doubled_amount content money
  output head_of_household_amount content money
  output residual_amount content money
  output amount content money
```



        (A) 200 percent of the dollar amount in effect under subparagraph (C) for the taxable year in the case of-


<!-- rtdf-block-id: sara/section63:b0012; role: provision; provision-id: sara/section63(c)(2)(A); source-lines: 31-31; relation: formalizes-preceding -->
```catala
scope BasicStandardDeduction:
  definition doubled equals joint_return_case or surviving_spouse_case

scope BasicStandardDeduction:
  definition doubled_amount equals
    (residual_basic of taxable_year) * (decimal of 2)
```

            (i) a joint return, or


<!-- rtdf-block-id: sara/section63:b0013; role: provision; provision-id: sara/section63(c)(2)(A)(i); source-lines: 33-33; relation: formalizes-preceding -->
