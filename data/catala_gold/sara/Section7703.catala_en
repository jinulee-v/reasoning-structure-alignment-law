            -- birth_events: [] -- death_events: Absent -- income_events: []
            -- payment_events: [] -- service_events: [] -- residence_events: []
            -- migration_events: Absent -- retirement_events: Absent -- deduction_events: []
            -- enrollment_events: Absent -- termination_events: Absent
