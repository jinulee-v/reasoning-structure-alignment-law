declaration structure NursesTrainingSchoolEvent:
  data ident content Entity
  data agents content optional of Entity

declaration structure InternationalOrganizationEvent:
  data ident content Entity
  data agents content optional of Entity

declaration structure AmericanEmployerEvent:
  data ident content Entity
  data agents content optional of Entity

declaration structure UnemploymentCompensationAgreementEvent:
  data ident content Entity
  data agents content optional of Entity

declaration structure AgentFact:
  data subject content Entity
  data value content Entity

declaration structure PatientFact:
  data subject content Entity
  data value content Entity

declaration structure StartFact:
  data subject content Entity
  data value content date

declaration structure EndFact:
  data subject content Entity
  data value content date

declaration structure AmountFact:
  data subject content Entity
  data value content money

declaration structure PurposeFact:
  data subject content Entity
  data value content Purpose

declaration structure PlaceFact:
  data subject content Entity
  data value content Place

declaration structure MediumFact:
  data subject content Entity
  data value content Medium

declaration structure ReasonFact:
  data subject content Entity
  data value content Entity

declaration structure BeneficiaryFact:
  data subject content Entity
  data value content Entity

declaration structure CountryFact:
  data subject content Entity
  data value content Entity

declaration structure TypeFact:
  data subject content Entity
  data value content Purpose

declaration structure DestinationFact:
  data subject content Entity
  data value content Place

## Scalar optional roles retain their scalar representation.  These helpers
## are internal compatibility views only; they do not introduce symbolic lists.
declaration date_values content list of date
  depends on value content optional of date
  equals match value with pattern
    -- Absent: []
    -- Present content x: [x]

declaration purpose_values content list of Purpose
  depends on value content optional of Purpose
  equals match value with pattern
    -- Absent: []
    -- Present content x: [x]

declaration entity_values content list of Entity
  depends on value content optional of Entity
  equals match value with pattern
    -- Absent: []
    -- Present content x: [x]

declaration place_values content list of Place
  depends on value content optional of Place
  equals match value with pattern
    -- Absent: []
    -- Present content x: [x]

## Direct predicates for scalar optional roles. Callers that only test one
## value should not materialize a singleton list and run a list membership
## relation over it.
declaration optional_date_equals content boolean
  depends on value content optional of date, wanted content date
  equals match value with pattern
    -- Absent: false
    -- Present content x: x = wanted

declaration optional_entity_equals content boolean
  depends on value content optional of Entity, wanted content Entity
  equals match value with pattern
    -- Absent: false
    -- Present content x: x = wanted

declaration optional_purpose_equals content boolean
  depends on value content optional of Purpose, wanted content Purpose
  equals match value with pattern
    -- Absent: false
    -- Present content x: x = wanted

declaration optional_place_equals content boolean
  depends on value content optional of Place, wanted content Place
  equals match value with pattern
    -- Absent: false
    -- Present content x: x = wanted

## A whole case. Category multiplicity is preserved independently of payload
## shape: corpus-singleton categories are options, not bounded lists.
declaration structure World:
  data marriage_events content list of MarriageEvent
  data birth_events content list of BirthEvent
  data death_events content optional of DeathEvent
  data income_events content list of IncomeEvent
  data payment_events content list of PaymentEvent
  data service_events content list of ServiceEvent
  data residence_events content list of ResidenceEvent
  data migration_events content optional of MigrationEvent
  data retirement_events content optional of RetirementEvent
  data deduction_events content list of DeductionEvent
  data enrollment_events content optional of EnrollmentEvent
  data termination_events content optional of TerminationEvent
  data incarceration_events content optional of IncarcerationEvent
  data legal_separation_events content optional of LegalSeparationEvent
  data joint_return_events content list of JointReturnEvent
  data itemize_deductions_events content optional of ItemizeDeductionsEvent
  data blindness_events content optional of BlindnessEvent
  data disability_events content optional of DisabilityEvent
  data attending_classes_events content optional of AttendingClassesEvent
  data medical_patient_events content optional of MedicalPatientEvent
  data nonresident_alien_events content optional of NonresidentAlienEvent
  data citizenship_events content list of CitizenshipEvent
  data son_events content list of SonEvent
  data daughter_events content optional of DaughterEvent
  data father_events content optional of FatherEvent
  data mother_events content optional of MotherEvent
  data brother_events content optional of BrotherEvent
  data sister_events content optional of SisterEvent
  data sibling_events content optional of SiblingEvent
  data business_events content optional of BusinessEvent
  data business_trust_events content optional of BusinessTrustEvent
  data plan_events content list of PlanEvent
  data hospital_events content optional of HospitalEvent
  data medical_institution_events content optional of MedicalInstitutionEvent
  data penal_institution_events content optional of PenalInstitutionEvent
  data educational_institution_events content optional of EducationalInstitutionEvent
  data nurses_training_school_events content optional of NursesTrainingSchoolEvent
  data international_organization_events content optional of InternationalOrganizationEvent
  data american_employer_events content optional of AmericanEmployerEvent
  data unemployment_compensation_agreement_events content optional of UnemploymentCompensationAgreementEvent
  data agent_facts content list of AgentFact
  data patient_facts content list of PatientFact
  data start_facts content list of StartFact
  data end_facts content list of EndFact
  data amount_facts content list of AmountFact
  data purpose_facts content list of PurposeFact
  data place_facts content list of PlaceFact
  data medium_facts content list of MediumFact
  data reason_facts content list of ReasonFact
  data beneficiary_facts content list of BeneficiaryFact
  data country_facts content list of CountryFact
  data type_facts content list of TypeFact
  data destination_facts content list of DestinationFact
  data universal_purposes content list of Purpose

declaration marriage_event_values content list of MarriageEvent
  depends on world content World
  equals world.marriage_events

declaration birth_event_values content list of BirthEvent
  depends on world content World
  equals world.birth_events

declaration death_event_values content list of DeathEvent
  depends on world content World
  equals match world.death_events with pattern
