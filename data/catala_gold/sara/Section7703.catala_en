declaration pred_s63_f_1_A_2 content integer equals 207

declaration pred_s63_f_1_B_3 content integer equals 208

declaration pred_s68_b_3 content integer equals 13

declaration pred_s7703_4 content integer equals 29

declaration pred_total_wages_employer_6 content integer equals 93

## The amounts one event contributes: its amount list, repeated once per start
## date falling inside the taxable year.

declaration event_contribution content money
  depends on amounts content list of money,
             starts content list of date,
             y content integer
  equals
    (Money.sum of amounts)
    * (decimal of (number of
        (list of d among starts
         such that (first_day_year of y) <= d and d <= (last_day_year of y))))

## `gross_income/3` with the *person* unbound. SARA collects the amounts with
## `findall(Amount, (income_(I), agent_(I,Person), amount_(I,Amount), ...))`,
## and an unbound `Person` is re-bound on every solution rather than fixed by
## the first: the call then sums the income of everyone in the world and leaves
## `Person` unbound at the end. That is not the individual test asked one
## person at a time, and a caller that reaches §152(d)(1)(B) before binding the
## dependant gets this reading -- see D34.

declaration everyone_income content money
  depends on world content World, y content integer
  equals
    (Money.sum of
      (map each ev among
        (list of e among (income_event_values of world)
         such that (first_day_year of y) <= e.start
                   and e.start <= (last_day_year of y))
       to ev.amount))
    + (Money.sum of
        (map each ev among
          (payment_event_values of world)
         to event_contribution of ev.amounts, ev.starts, y))

## How many times an entity appears in a role list. SARA's sums are `findall`s,
## so repeated patient or agent facts contribute repeatedly. Complete income
## occurrences already encode that Cartesian multiplicity; payment and
## deduction records retain role lists and use this helper. See D40.

declaration role_count content integer
  depends on l content list of Entity, e content Entity
  equals number of (list of x among l such that x.id = e.id)

declaration scope GrossIncomeIndividual:
  input world content World
  input person content Entity
  input taxable_year content integer
  output income content money
  output payments content money
  output total content money

declaration scope GrossIncome:
  input world content World
  input person content Entity
  input taxable_year content integer
  ## Present only when a joint return covering the full year was filed; the
  ## §7703 determination is stratified out of Layer 0.
  input joint_spouse content optional of Entity
  output total content money

declaration structure Window:
  data starts_on content optional of date
  data ends_on content optional of date

## One relationship instance: `subject` stands in the relation to `object`
## over `window`.

declaration structure Kinship:
  data subject content Entity
  data object content Entity
  data window content Window

## The `optional` lift of a role list: an empty list is "no constraint", a
## non-empty one contributes each of its values separately.

declaration opt_dates content list of optional of date
  depends on ds content list of date
  equals
    if (number of ds) = 0
    then [Absent]
    else map each d among ds to (Present content d)

## Every (start, end) pairing the Prolog's two disjunctions admit.

declaration windows content list of Window
  depends on starts content list of date,
             ends content optional of date
  equals
    combine all inner
      among (map each s among (opt_dates of starts) to
              (map each e among (opt_dates of (date_values of ends)) to
                Window { -- starts_on: s -- ends_on: e }))
      in acc initially []
      with acc ++ inner

## The pairs an event contributes to a relation, given which role holds the
## subject and which holds the object, with the `X \== Y` guard.

declaration pairs_from content list of Kinship
  depends on starts content list of date,
             ends content optional of date,
             subjects content list of Entity,
             objects content list of Entity
  equals
    combine all a
      among (map each x among subjects to
              (combine all b
                 among (map each y among
                         (list of o among objects such that o.id != x.id)
                        to (map each w among (windows of starts, ends) to
                             Kinship { -- subject: x -- object: y -- window: w }))
                 in acc2 initially []
                 with acc2 ++ b))
      in acc initially []
      with acc ++ a

declaration flatten_kinship content list of Kinship
  depends on nested content list of list of Kinship
  equals
    combine all inner among nested in acc initially [] with acc ++ inner

declaration scope Kinships:
  input world content World
  output child_of content list of Kinship
  output sibling_of content list of Kinship
  ## `is_descendent_of/4`, unrolled to depth 3. The longest ancestor chain in
  ## all 376 cases is 2 (measured), so depth 3 covers the suite with margin;
  ## Catala has no recursion, so the bound is explicit rather than implied.
  output descendent_of content list of Kinship

declaration relates content boolean
  depends on rel content list of Kinship,
             subject content Entity, object content Entity
  equals
    exists k among rel such that
      k.subject.id = subject.id and k.object.id = object.id

## The same query, but reporting *which* windows the relation holds over. A
## case that binds `Start_relationship`/`End_relationship` and then constrains
## them is asking about the solutions, not just whether one exists.

declaration windows_between content list of Window
  depends on rel content list of Kinship,
             subject content Entity, object content Entity
  equals
    map each k among
      (list of r among rel
       such that r.subject.id = subject.id and r.object.id = object.id)
    to k.window

## A case may grant a *windowed* relation outright --
## `s152_c_2(bob,alice,"2015-01-01","2020-12-31")` supplies the relationship and
## the window that §152(c)(1)(B) then measures the shared abode against. Date
## arguments are represented directly as `DateValue`; an unbound argument is
## the distinct `Unbound` constructor rather than a sentinel date.

declaration injected_opt_date content optional of date
  depends on inj content Injection, pos content integer
  equals injection_date of inj, pos

declaration s151_exemption_amounts_unbound content boolean
  depends on inj content Injection
  equals (injection_key of inj, 4) = -1

declaration injected_windows content list of Window
  depends on matching_injections content list of Injection,
             start_pos content integer, end_pos content integer
  equals
    map each inj among matching_injections
    to Window { -- starts_on: injected_opt_date of inj, start_pos
                -- ends_on: injected_opt_date of inj, end_pos }

declaration latest content optional of date
  depends on ds content list of optional of date
  equals
    combine all d among ds in acc initially Absent with
      (match d with pattern
       -- Absent: acc
       -- Present content x:
           (match acc with pattern
            -- Absent: Present content x
            -- Present content y: Present content (if x >= y then x else y)))

declaration earliest content optional of date
  depends on ds content list of optional of date
  equals
    combine all d among ds in acc initially Absent with
      (match d with pattern
       -- Absent: acc
       -- Present content x:
           (match acc with pattern
            -- Absent: Present content x
            -- Present content y: Present content (if x <= y then x else y)))

declaration join_windows content Window
  depends on a content Window, b content Window
  equals
    Window {
      -- starts_on: latest of [a.starts_on; b.starts_on]
      -- ends_on: earliest of [a.ends_on; b.ends_on]
    }

## The marriages joining `a` and `b`, with their windows.

declaration marriages_of content list of Window
  depends on world content World, a content Entity, b content Entity
  equals
    combine all ws
      among (map each ev among
              (list of e among (marriage_event_values of world)
               such that e.agents contains a and e.agents contains b)
             to windows of ev.starts, ev.ends)
      in acc initially []
      with acc ++ ws

## As above, but only marriages that carry a start date -- the extra condition
## `is_stepparent_of/4` imposes.

declaration dated_marriages_of content list of Window
  depends on world content World, a content Entity, b content Entity
  equals
    list of w among (marriages_of of world, a, b)
    such that (match w.starts_on with pattern
               -- Absent: false
               -- Present content d: true)

declaration scope InLaws:
  input world content World
  input child_of content list of Kinship
  input sibling_of content list of Kinship
  ## X is a stepsibling of Y: their respective parents are married.
  output stepsibling_of content list of Kinship
  ## X is the stepparent of Y: X married one of Y's parents.
  output stepparent_of content list of Kinship
  ## X married a child of Y.
  output child_in_law_of content list of Kinship
  ## X married a parent of Y.
  output parent_in_law_of content list of Kinship
  ## X married a sibling of Y, or vice versa.
  output sibling_in_law_of content list of Kinship

declaration scope DependantQualifies:
  input world content World
  input dependant content Entity
  input taxpayer content Entity
  input taxable_year content integer
  ## Present when the case injects this conclusion instead of deriving it.
  input injected content optional of boolean
  output qualifies content boolean

declaration scope RelationshipWindow:
  input starts content list of date
  input ends content optional of date
  output starts_on content optional of date
  output ends_on content optional of date
  output is_ongoing content boolean

declaration scope MaritalStatusStratified:
  input world content World
  input taxpayer content Entity
  input taxable_year content integer
  ## §7703 consults §152, and §152 consults §7703. This input carries the
  ## preliminary §152 verdict, computed first with the §7703 dependency
  ## defaulted. See sara_scripts/DEVIATIONS.md.
  input dependant_prelim content boolean
  output is_married content boolean

declaration scope Smoke:
  output derived content boolean
  output injected_wins content boolean
  output ongoing content boolean

declaration structure Candidate:
  data spouse content Entity
  data marriage content MarriageEvent

## Accumulate all §7703(a) observations in one pass. Without this record,
## every output below traverses the same candidates and re-runs both scopes.

declaration structure MaritalStatusASummary:
  data holds_a_1 content boolean
  data holds_a_2 content boolean
  data spouses content list of Entity

declaration scope MaritalStatusA:
  input world content World
  input taxpayer content Entity
  input taxable_year content integer
  ## Every (spouse, marriage) the taxpayer appears in.
  output candidates content list of Candidate
  internal summary content MaritalStatusASummary
  ## s7703_a_1/5 — some candidate satisfies (a)(1)
  output holds_a_1 content boolean
  ## s7703_a_2/5 — some candidate marriage is legally separated
  output holds_a_2 content boolean
  ## s7703_a/4
  output married content boolean
  ## Every spouse the taxpayer is married to under (a). `s7703_a/4` is a
  ## generator, and §151(b) asks about a *named* spouse, so the whole set is
  ## reported rather than only the first.
  output spouses content list of Entity
  output spouse content optional of Entity

declaration scope JointFilingSpouse:
  input world content World
  input injections content list of Injection
  input taxpayer content Entity
  input taxable_year content integer
  ## §152(a)(1) dependants, for (b)(1) — as `MaritalStatus` takes them.
  input qualifying_dependants content list of Entity
  ## Preserve the complete §7703 spouse relation for callers that also need
  ## filing-status classification; `spouse` below is the joint-filing subset.
  output spouses content list of Entity
  output spouse content optional of Entity
```


<!-- rtdf-block-id: sara/section7703:b0002; role: preamble-definitions; provision-id: none; source-lines: none; relation: preamble -->
```catala
scope GrossIncomeIndividual:
  definition income equals
    Money.sum of
      (map each ev among
        (list of e among (income_event_values of world)
         such that e.agent.id = person.id
                   and (first_day_year of taxable_year) <= e.start
                   and e.start <= (last_day_year of taxable_year))
       to ev.amount)

  ## payment_(P), patient_(P,Person)

scope GrossIncomeIndividual:
  definition payments equals
    Money.sum of
      (map each ev among
        (list of e among (payment_event_values of world)
         such that e.patients contains person)
       to (event_contribution of ev.amounts, ev.starts, taxable_year)
          * (decimal of (role_count of ev.patients, person)))

scope GrossIncomeIndividual:
  definition total equals income + payments

scope GrossIncome:

scope GrossIncome:
  definition total equals
    (output of GrossIncomeIndividual with {
       -- world: world -- person: person -- taxable_year: taxable_year }).total
    + (match joint_spouse with pattern
       -- Absent: $0
       -- Present content sp:
           (output of GrossIncomeIndividual with {
              -- world: world -- person: sp
              -- taxable_year: taxable_year }).total)

scope Kinships:

scope Kinships:
  definition child_of equals
    (flatten_kinship of
      (map each ev among
        (son_event_values of world)
       to pairs_from of ev.starts, Absent, ev.agents, ev.patients))
    ++ (flatten_kinship of
      (map each ev among
        (daughter_event_values of world)
       to pairs_from of [], Absent, (entity_values of ev.agents), (entity_values of ev.patients)))
    ++
    (flatten_kinship of
      (map each ev among
        (father_event_values of world)
       to pairs_from of (date_values of ev.starts), Absent, ev.patients, ev.agents))
    ++ (flatten_kinship of
      (map each ev among
        (mother_event_values of world)
       to pairs_from of ev.starts, Absent, (entity_values of ev.patients), (entity_values of ev.agents)))

  ## `is_sibling_of/4`: a brother_ or sister_ event in which both X and Y
  ## appear, in either role.

scope Kinships:
  definition sibling_of equals
    (flatten_kinship of
      (map each ev among
        (brother_event_values of world)
       to pairs_from of (date_values of ev.starts), Absent, (ev.agents ++ ev.patients),
                            (ev.agents ++ ev.patients)))
    ++ (flatten_kinship of
      (map each ev among
        (sister_event_values of world)
       to pairs_from of (date_values of ev.starts), Absent, ((entity_values of ev.agents) ++ (entity_values of ev.patients)),
                            ((entity_values of ev.agents) ++ (entity_values of ev.patients))))

  ## Base case plus two compositions. The recursive clause keeps the
  ## *descendant's* own window and discards the intermediate one, which is what
  ## `is_child_of(Z,Y,_,_), is_descendent_of(X,Z,Day_start,Day_end)` does.

scope Kinships:
  definition descendent_of equals
    child_of
    ++ (flatten_kinship of
         (map each mid among child_of to
           (map each lower among
             (list of c among child_of such that c.object.id = mid.subject.id)
            to Kinship { -- subject: lower.subject -- object: mid.object
                         -- window: lower.window })))
    ++ (flatten_kinship of
         (map each mid among child_of to
           (flatten_kinship of
             (map each mid2 among
               (list of c among child_of such that c.object.id = mid.subject.id)
              to (map each lower among
                   (list of c among child_of
                    such that c.object.id = mid2.subject.id)
                  to Kinship { -- subject: lower.subject -- object: mid.object
                               -- window: lower.window })))))

scope InLaws:

scope InLaws:
  definition stepsibling_of equals
    flatten_kinship of
      (map each cy among child_of to
        (flatten_kinship of
          (map each cx among
            (list of c among child_of such that c.subject.id != cy.subject.id)
           to (map each m among
                 (marriages_of of world, cy.object, cx.object)
               to Kinship {
                    -- subject: cx.subject -- object: cy.subject
                    -- window: join_windows of
                                 (join_windows of cx.window, cy.window), m }))))

  ## `is_stepparent_of` is the one in-law relation whose marriage must be
  ## *dated*. Its four siblings all write
  ## `( \+ start_(Marriage,_) ; start_(Marriage,Start_time) )`, so an undated
  ## marriage is no constraint for them; `utils.pl:262` writes a bare
  ## `start_(Marriage,Start_time)` with no such fallback, and an undated
  ## marriage makes the clause fail outright. The asymmetry is SARA's, not a
  ## reading of the statute, so the port reproduces it here and nowhere else.

scope InLaws:
  definition stepparent_of equals
    flatten_kinship of
      (map each cy among child_of to
        (flatten_kinship of
          (map each other among
            (list of e among (marriage_event_values of world)
             such that e.agents contains cy.object
                       and (number of e.starts) > 0)
           to (map each sp among
                 (list of a among other.agents such that a.id != cy.object.id
                                                and a.id != cy.subject.id)
               to Kinship {
                    -- subject: sp -- object: cy.subject
                    -- window: join_windows of cy.window,
                                 (match (List.first_element of
                                          (dated_marriages_of of world, cy.object, sp))
                                  with pattern
                                  -- Absent: Window { -- starts_on: Absent
                                                      -- ends_on: Absent }
                                  -- Present content w: w) }))))

  ## Each in-law relation runs only while *both* the kinship and the marriage
  ## do: SARA takes `latest([Start_marriage,Day_start_y],Day_start)` and
  ## `earliest([End_marriage,Day_end_y],Day_end)`. Taking the kinship window
  ## alone dropped a marriage that had ended. See D42.

scope InLaws:
  definition child_in_law_of equals
    flatten_kinship of
      (map each cy among child_of to
        (flatten_kinship of
          (map each ev among
            (list of e among (marriage_event_values of world)
             such that e.agents contains cy.subject)
           to (map each sp among
                 (list of a among ev.agents such that a.id != cy.subject.id
                                                and a.id != cy.object.id)
               to Kinship { -- subject: sp -- object: cy.object
                            -- window: join_windows of cy.window, (match (List.first_element of (windows of ev.starts, ev.ends)) with pattern
                                  -- Absent: Window { -- starts_on: Absent
                                                      -- ends_on: Absent }
                                  -- Present content mw: mw) }))))

scope InLaws:
  definition parent_in_law_of equals
    flatten_kinship of
      (map each cy among child_of to
        (flatten_kinship of
          (map each ev among
            (list of e among (marriage_event_values of world)
             such that e.agents contains cy.object)
           to (map each sp among
                 (list of a among ev.agents such that a.id != cy.object.id
                                                and a.id != cy.subject.id)
               to Kinship { -- subject: sp -- object: cy.subject
                            -- window: join_windows of cy.window, (match (List.first_element of (windows of ev.starts, ev.ends)) with pattern
                                  -- Absent: Window { -- starts_on: Absent
                                                      -- ends_on: Absent }
                                  -- Present content mw: mw) }))))

scope InLaws:
  definition sibling_in_law_of equals
    flatten_kinship of
      (map each sib among sibling_of to
        (flatten_kinship of
          (map each ev among
            (list of e among (marriage_event_values of world)
             such that e.agents contains sib.subject)
           to (map each sp among
                 (list of a among ev.agents such that a.id != sib.subject.id
                                                and a.id != sib.object.id)
               to Kinship { -- subject: sp -- object: sib.object
                            -- window: join_windows of sib.window, (match (List.first_element of (windows of ev.starts, ev.ends)) with pattern
                                  -- Absent: Window { -- starts_on: Absent
                                                      -- ends_on: Absent }
                                  -- Present content mw: mw) }))))

scope DependantQualifies:
  ## The derived reading: some birth event links the two in the taxable year.
  ## (Placeholder body -- the real 152(c)(1) test lands in the section port.)

scope DependantQualifies:
  definition qualifies equals
    match injected with pattern
    -- Present content v: v
    -- Absent:
        (exists ev among (son_event_values of world) such that
           ev.agents contains dependant
           and ev.patients contains taxpayer)
        or (exists ev among (daughter_event_values of world) such that
              (optional_entity_equals of ev.agents, dependant)
              and (optional_entity_equals of ev.patients, taxpayer))

scope RelationshipWindow:

scope RelationshipWindow:
  definition starts_on equals List.first_element of starts

scope RelationshipWindow:
  definition ends_on equals List.first_element of (date_values of ends)

scope RelationshipWindow:
  definition is_ongoing equals ends_on with pattern Absent

scope MaritalStatusStratified:

scope MaritalStatusStratified:
  definition is_married equals
    (exists ev among (marriage_event_values of world) such that
       ev.agents contains taxpayer)
    and not dependant_prelim

scope Smoke:

scope Smoke:
  definition derived equals
    (output of DependantQualifies with {
       -- world: World {
            -- marriage_events: [ MarriageEvent {
