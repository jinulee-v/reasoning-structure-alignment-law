            -- son_events: [] -- daughter_events: Absent -- father_events: Absent
            -- mother_events: Absent -- brother_events: Absent -- sister_events: Absent
            -- sibling_events: Absent -- business_events: Absent -- business_trust_events: Absent
            -- plan_events: [] -- hospital_events: Absent -- medical_institution_events: Absent
            -- penal_institution_events: Absent -- educational_institution_events: Absent
            -- nurses_training_school_events: Absent
            -- international_organization_events: Absent -- american_employer_events: Absent
            -- unemployment_compensation_agreement_events: Absent
            -- agent_facts: [] -- patient_facts: [] -- start_facts: [] -- end_facts: []
            -- amount_facts: [] -- purpose_facts: [] -- place_facts: [] -- medium_facts: []
            -- reason_facts: [] -- beneficiary_facts: [] -- country_facts: []
            -- type_facts: [] -- destination_facts: []
