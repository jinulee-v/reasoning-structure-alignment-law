## Every person named in an entity role. Duplicates are intentional:
## consumers either use existential membership or apply their own stable dedup.
declaration people_entities content list of Entity
  depends on world content World
  equals (combine all xs among (map each ev among (marriage_event_values of world) to ev.agents) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (birth_event_values of world) to ev.agents) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (death_event_values of world) to ev.agents) in acc initially [] with acc ++ xs)
    ++ (map each ev among (income_event_values of world) to ev.agent)
    ++ (combine all xs among (map each ev among (payment_event_values of world) to ev.agents) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (service_event_values of world) to ev.agents) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (residence_event_values of world) to ev.agents) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (migration_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (retirement_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (deduction_event_values of world) to ev.agents) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (enrollment_event_values of world) to ev.agents) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (termination_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (incarceration_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (legal_separation_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (joint_return_event_values of world) to ev.agents) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (blindness_event_values of world) to ev.agents) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (disability_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (attending_classes_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (medical_patient_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (nonresident_alien_event_values of world) to ev.agents) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (citizenship_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (son_event_values of world) to ev.agents) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (daughter_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (father_event_values of world) to ev.agents) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (mother_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (brother_event_values of world) to ev.agents) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (sister_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (sibling_event_values of world) to ev.agents) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (business_event_values of world) to ev.agents) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (business_trust_event_values of world) to ev.agents) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (plan_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (hospital_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (medical_institution_event_values of world) to ev.agents) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (penal_institution_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (educational_institution_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (nurses_training_school_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (international_organization_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (american_employer_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (unemployment_compensation_agreement_event_values of world) to (entity_values of ev.agents)) in acc initially [] with acc ++ xs)
    ++ (map each fact among world.agent_facts to fact.value)
    ++ (combine all xs among (map each ev among (payment_event_values of world) to ev.patients) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (service_event_values of world) to ev.patients) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (residence_event_values of world) to ev.patients) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (enrollment_event_values of world) to (entity_values of ev.patients)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (termination_event_values of world) to (entity_values of ev.patients)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (incarceration_event_values of world) to (entity_values of ev.patients)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (legal_separation_event_values of world) to (entity_values of ev.patients)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (medical_patient_event_values of world) to (entity_values of ev.patients)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (citizenship_event_values of world) to ev.patients) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (son_event_values of world) to ev.patients) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (daughter_event_values of world) to (entity_values of ev.patients)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (father_event_values of world) to ev.patients) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (mother_event_values of world) to (entity_values of ev.patients)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (brother_event_values of world) to ev.patients) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (sister_event_values of world) to (entity_values of ev.patients)) in acc initially [] with acc ++ xs)
    ++ (combine all xs among (map each ev among (sibling_event_values of world) to (entity_values of ev.patients)) in acc initially [] with acc ++ xs)
    ++ (map each fact among world.patient_facts to fact.value)
## first_day_year/2 and last_day_year/2. The Prolog builds these by string
## concatenation ("2017" ++ "-01-01"); dates are first class in Catala.
## `year` is a reserved duration unit, so the parameter is named `y`.

declaration first_day_year content date
  depends on y content integer
  equals Date.of_year_month_day of y, 1, 1

declaration last_day_year content date
  depends on y content integer
  equals Date.of_year_month_day of y, 12, 31

## A case may inject conclusions for predicates defined by the statute. The
## runtime representation stores each argument's already-tagged match key in
## a fixed tuple constructor for the predicate's arity. Entity ids occupy the
## low range, integers start at 1,000,000, dates at 2,000,000, -1 is an
## unbound Prolog variable, and -2 is an opaque value. Only positions which
## can be read back as dates carry a date companion. There is no nested Catala
## list and no per-position sum containing values that position can never use.

declaration structure InjectionArgs1:
  data one content integer

declaration structure InjectionArgs2:
  data one content integer
  data two content integer

declaration structure InjectionArgs3:
  data one content integer
  data two content integer
  data three content integer

declaration structure InjectionArgs4:
  data one content integer
  data two content integer
  data three content integer
  data four content integer
  ## §152(c)(2)'s relationship window.
  data three_date content optional of date
  data four_date content optional of date

declaration structure InjectionArgs5:
  data one content integer
  data two content integer
  data three content integer
  data four content integer
  data five content integer
  ## §3306(c)'s work day.
  data four_date content optional of date

declaration structure InjectionArgs6:
  data one content integer
  data two content integer
  data three content integer
  data four content integer
  data five content integer
  data six content integer
  ## §152(d)(2)(H)'s relationship window.
  data five_date content optional of date
  data six_date content optional of date

declaration structure InjectionArgs7:
  data one content integer
  data two content integer
  data three content integer
  data four content integer
  data five content integer
  data six content integer
  data seven content integer

declaration structure InjectionArgs8:
  data one content integer
  data two content integer
  data three content integer
  data four content integer
  data five content integer
  data six content integer
  data seven content integer
  data eight content integer

declaration enumeration InjectionArguments:
  -- Args1 content InjectionArgs1
  -- Args2 content InjectionArgs2
  -- Args3 content InjectionArgs3
  -- Args4 content InjectionArgs4
  -- Args5 content InjectionArgs5
  -- Args6 content InjectionArgs6
  -- Args7 content InjectionArgs7
  -- Args8 content InjectionArgs8

declaration structure Injection:
  data pred content integer
  ## True when this row comes from a Prolog definition that replaced, rather
  ## than extended, the statute's clauses for `pred`.
  data replaces_statute content boolean
  data arguments content InjectionArguments

## A single traversal result for injected numeric conclusions. `holds` keeps
## the distinction between no matching row and a matching row whose numeric
## argument is absent; `money` carries the first row's numeric argument.
declaration structure InjectedMoneyResult:
  data holds content boolean
  data amount content optional of money

declaration injection_key content integer
  depends on inj content Injection, pos content integer
  equals match inj.arguments with pattern
    -- Args1 content a: if pos = 1 then a.one else -2
    -- Args2 content a:
        if pos = 1 then a.one else if pos = 2 then a.two else -2
    -- Args3 content a:
        if pos = 1 then a.one else if pos = 2 then a.two
        else if pos = 3 then a.three else -2
    -- Args4 content a:
        if pos = 1 then a.one else if pos = 2 then a.two
        else if pos = 3 then a.three else if pos = 4 then a.four
        else -2
    -- Args5 content a:
        if pos = 1 then a.one else if pos = 2 then a.two
        else if pos = 3 then a.three else if pos = 4 then a.four
        else if pos = 5 then a.five else -2
    -- Args6 content a:
        if pos = 1 then a.one else if pos = 2 then a.two
        else if pos = 3 then a.three else if pos = 4 then a.four
        else if pos = 5 then a.five else if pos = 6 then a.six
        else -2
    -- Args7 content a:
        if pos = 1 then a.one else if pos = 2 then a.two
        else if pos = 3 then a.three else if pos = 4 then a.four
        else if pos = 5 then a.five else if pos = 6 then a.six
        else if pos = 7 then a.seven else -2
    -- Args8 content a:
        if pos = 1 then a.one else if pos = 2 then a.two
        else if pos = 3 then a.three else if pos = 4 then a.four
        else if pos = 5 then a.five else if pos = 6 then a.six
        else if pos = 7 then a.seven else if pos = 8 then a.eight
        else -2

declaration injection_pred content integer
  depends on inj content Injection
  equals inj.pred

declaration injection_arity content integer
  depends on inj content Injection
  equals match inj.arguments with pattern
    -- Args1 content ignored: 1
    -- Args2 content ignored: 2
    -- Args3 content ignored: 3
    -- Args4 content ignored: 4
    -- Args5 content ignored: 5
    -- Args6 content ignored: 6
    -- Args7 content ignored: 7
    -- Args8 content ignored: 8

## One argument position matches when either side is a don't-care.

declaration arg_matches content boolean
  depends on injected content integer, wanted content integer
  equals injected = -1 or wanted = -1 or injected = wanted

## Fixed-shape lookups avoid constructing wildcard-filled argument lists. Each
## helper accepts only the positions that its caller actually constrains.

declaration injections_for_1_1 content list of Injection
  depends on injections content list of Injection, pred content integer,
             wanted_1 content integer
  equals
    list of inj among injections such that
      inj.pred = pred
      and (injection_arity of inj) = 1
      and (arg_matches of (injection_key of inj, 1), wanted_1)

declaration injections_for_2_12 content list of Injection
  depends on injections content list of Injection, pred content integer,
             wanted_1 content integer, wanted_2 content integer
  equals
    list of inj among injections such that
      inj.pred = pred
      and (injection_arity of inj) = 2
      and (arg_matches of (injection_key of inj, 1), wanted_1)
      and (arg_matches of (injection_key of inj, 2), wanted_2)

declaration injections_for_3_123 content list of Injection
  depends on injections content list of Injection, pred content integer,
             wanted_1 content integer, wanted_2 content integer, wanted_3 content integer
  equals
    list of inj among injections such that
      inj.pred = pred
      and (injection_arity of inj) = 3
      and (arg_matches of (injection_key of inj, 1), wanted_1)
      and (arg_matches of (injection_key of inj, 2), wanted_2)
      and (arg_matches of (injection_key of inj, 3), wanted_3)

declaration injections_for_3_12 content list of Injection
  depends on injections content list of Injection, pred content integer,
             wanted_1 content integer, wanted_2 content integer
  equals
