> Module Section7703

<!-- rtdf-block-id: sara/section7703:b0001; role: preamble-metadata; provision-id: none; source-lines: none; relation: preamble -->
```catala-metadata
declaration enumeration EntityTag:
  -- PlainEntity
  ## atom_prefix(E, "state of ") -- a State employer under §3306(c)(7)
  -- StateEntity
  -- DecreeOfDivorce
  -- DecreeOfSeparateMaintenance
  -- UsaEntity
  ## E == "united states government" -- excluded by §3306(c)(6), and the one
  ## exception to §3306(c)(11).
  -- UnitedStatesGovernmentEntity
  ## sub_atom(E,_,11,0,' government') and not the above -- a foreign government
  ## under §3306(c)(11).
  -- ForeignGovernmentEntity

declaration structure Entity:
  data id content integer
  data tag content EntityTag

## The closed vocabulary the statutes branch on, from the 20 semantic string
## literals appearing in the Prolog. Anything outside it is Other, which no
## statute clause matches -- the same behaviour as a failed unification.

declaration enumeration Purpose:
  -- AgriculturalLabor
  -- DomesticService
  -- ProvisionSickness
  -- ProvisionAccidentDisability
  -- ProvisionDeath
  -- ProvisionEmployeesOrDependents
  -- PurposeEntity content Entity
  -- OtherPurpose

## means_/2: the medium a payment was made in. Section 3306(b)(7) turns on
## remuneration paid in a medium other than cash.

declaration enumeration Medium:
  -- Cash
  ## Any other medium, kept identified rather than collapsed: §3306(b)(2) and
  ## (b)(10)(B) read `means_(Remuneration,Plan)` and then require `plan_(Plan)`,
  ## so the medium has to be comparable with an event id.
  -- MediumEntity content Entity

## location_/2. A single event carries up to four of these at once
## (e.g. baltimore, maryland, usa, "private home"), hence a list downstream.

declaration enumeration Place:
  -- Usa
  -- PrivateHome
  -- LocalCollegeClub
  -- LocalCollegeFraternityChapter
  -- LocalCollegeSororityChapter
  -- UnitedStatesGovernment
  -- NamedPlace content Entity

## Category-specific event records.  There is deliberately no universal event
## record: keeping irrelevant roles out of each symbolic value is essential for
## tractable concolic execution.

declaration structure MarriageEvent:
  data ident content Entity
  data agents content list of Entity
  data starts content list of date
  data ends content optional of date

declaration structure BirthEvent:
  data ident content Entity
  data agents content list of Entity
  data starts content optional of date
  data ends content optional of date

declaration structure DeathEvent:
  data ident content Entity
  data agents content list of Entity
  data starts content optional of date
  data ends content optional of date

declaration structure IncomeEvent:
  data agent content Entity
  data start content date
  ## The statutory income amount represented by this occurrence. Keeping the
  ## value direct avoids an artificial coordinate transform in every income
  ## calculation.
  data amount content money

declaration structure PaymentEvent:
  data ident content Entity
  data agents content list of Entity
  data patients content list of Entity
  data starts content list of date
  data ends content optional of date
  data amounts content list of money
  data purposes content optional of Purpose
  data media content list of Medium
  data beneficiaries content list of Entity

declaration structure ServiceEvent:
  data ident content Entity
  data agents content list of Entity
  data patients content list of Entity
  data starts content list of date
  data ends content optional of date
  data purposes content optional of Purpose
  data places content list of Place
  data media content list of Medium
  data types content optional of Purpose

declaration structure ResidenceEvent:
  data ident content Entity
  data agents content list of Entity
  data patients content list of Entity
  data starts content list of date
  data ends content optional of date

declaration structure MigrationEvent:
  data ident content Entity
  data agents content optional of Entity
  data purposes content optional of Purpose
  data destinations content optional of Place

declaration structure RetirementEvent:
  data ident content Entity
  data agents content optional of Entity
  data starts content optional of date
  data reasons content optional of Entity

declaration structure DeductionOccurrence:
  data start content date
  data amount content money

declaration enumeration DeductionEvidence:
  -- Undated
  -- DatedClaim content date
  -- DatedAmount content DeductionOccurrence

declaration structure DeductionEvent:
  data agents content list of Entity
  data evidence content DeductionEvidence

declaration structure EnrollmentEvent:
  data ident content Entity
  data agents content list of Entity
  data patients content optional of Entity
  data starts content optional of date
  data ends content optional of date

declaration structure TerminationEvent:
  data ident content Entity
  data agents content optional of Entity
  data patients content optional of Entity
  data starts content optional of date
  data reasons content optional of Entity

