scope Smoke:
  definition injected_wins equals
    (output of DependantQualifies with {
       -- world: World {
            -- marriage_events: [] -- birth_events: [] -- death_events: Absent
            -- income_events: [] -- payment_events: [] -- service_events: []
            -- residence_events: [] -- migration_events: Absent -- retirement_events: Absent
            -- deduction_events: [] -- enrollment_events: Absent -- termination_events: Absent
            -- incarceration_events: Absent -- legal_separation_events: Absent
            -- joint_return_events: [] -- itemize_deductions_events: Absent
            -- blindness_events: Absent -- disability_events: Absent
            -- attending_classes_events: Absent -- medical_patient_events: Absent
            -- nonresident_alien_events: Absent -- citizenship_events: []
            -- son_events: [] -- daughter_events: Absent -- father_events: Absent
            -- mother_events: Absent -- brother_events: Absent -- sister_events: Absent
            -- sibling_events: Absent -- business_events: Absent -- business_trust_events: Absent
            -- plan_events: [] -- hospital_events: Absent -- medical_institution_events: Absent
            -- penal_institution_events: Absent -- educational_institution_events: Absent
            -- nurses_training_school_events: Absent
            -- international_organization_events: Absent -- american_employer_events: Absent
            -- unemployment_compensation_agreement_events: Absent
            -- agent_facts: [] -- patient_facts: [] -- start_facts: [] -- end_facts: []
            -- amount_facts: [] -- purpose_facts: [] -- place_facts: [] -- medium_facts: []
            -- reason_facts: [] -- beneficiary_facts: [] -- country_facts: []
            -- type_facts: [] -- destination_facts: []
            -- universal_purposes: [] }
       -- dependant: Entity { -- id: 2 -- tag: EntityTag.PlainEntity }
       -- taxpayer: Entity { -- id: 1 -- tag: EntityTag.PlainEntity }
       -- taxable_year: 2015
       -- injected: Present content true
     }).qualifies

scope Smoke:
  definition ongoing equals
    (output of RelationshipWindow with {
       -- starts: [ |2015-02-02| ] -- ends: Absent
     }).is_ongoing

scope MarriageStatus:

scope MaritalStatusA:
  definition candidates equals
    combine all cs
      among (map each ev among
              (list of e among (marriage_event_values of world)
               such that e.agents contains taxpayer)
             to (map each sp among
                   (list of a among ev.agents such that a.id != taxpayer.id)
                 to Candidate { -- spouse: sp -- marriage: ev }))
      in acc initially []
      with acc ++ cs

scope MaritalStatusA:
  definition summary equals
    combine all c among candidates
      in acc initially MaritalStatusASummary {
        -- holds_a_1: false -- holds_a_2: false -- spouses: [] }
      with
        (let holds equals
           (output of MarriageStatus with {
              -- world: world -- taxpayer: taxpayer -- spouse: c.spouse
              -- marriage: c.marriage -- taxable_year: taxable_year }).holds_a_1 in
         let separated equals
           (output of LegalSeparation with {
              -- world: world -- marriage: c.marriage
              -- taxable_year: taxable_year }).separated in
         MaritalStatusASummary {
           -- holds_a_1: acc.holds_a_1 or holds
           -- holds_a_2: acc.holds_a_2 or separated
           -- spouses:
                (if holds and not separated
                 then acc.spouses ++ [c.spouse]
                 else acc.spouses) })

scope MaritalStatusA:
  definition holds_a_1 equals summary.holds_a_1

scope MaritalStatusA:
  definition holds_a_2 equals summary.holds_a_2

scope MaritalStatusA:
  definition married equals (number of summary.spouses) > 0

scope MaritalStatusA:
  definition spouses equals summary.spouses

scope MaritalStatusA:
  definition spouse equals List.first_element of spouses

scope JointFilingSpouse:
  definition spouses equals
    (output of MaritalStatus with {
       -- world: world -- injections: injections -- taxpayer: taxpayer
       -- taxable_year: taxable_year
       -- qualifying_dependants: qualifying_dependants }).spouses

scope JointFilingSpouse:
  definition spouse equals
    List.first_element of
      (list of sp among
        spouses
       such that
         exists jr among (joint_return_event_values of world) such that
           jr.agents contains taxpayer
           and jr.agents contains sp
           and (optional_date_equals of jr.starts, (first_day_year of taxable_year))
           and (optional_date_equals of jr.ends, (last_day_year of taxable_year)))
```

§7703. Determination of marital status

(a) General rule

    (1) the determination of whether an individual is married shall be made as of the close of his taxable year; except that if his spouse dies during his taxable year such determination shall be made as of the time of such death; and


<!-- rtdf-block-id: sara/section7703:b0003; role: provision; provision-id: sara/section7703(a)(1); source-lines: 5-5; relation: formalizes-preceding -->
```catala
scope MarriageStatus:
  definition start_candidates equals
    if (number of marriage.starts) = 0
    then [first_day_year of taxable_year]
    else marriage.starts

scope MarriageStatus:
  definition spouse_died_on equals
    List.first_element of
      (combine all ds
        among (map each ev among
                (list of e among (death_event_values of world)
                 such that e.agents contains spouse)
               to (list of d among (date_values of ev.starts)
                   such that (first_day_year of taxable_year) <= d
                             and d <= (last_day_year of taxable_year)))
        in acc initially []
        with acc ++ ds)

scope MarriageStatus:
  definition holds_a_1 equals
    exists s among start_candidates such that
    s <= (last_day_year of taxable_year)
    and (match spouse_died_on with pattern
         -- Present content death:
             # determination made as of the time of death
             s <= death
             and ((number of (date_values of marriage.ends)) = 0
                  or (exists e among (date_values of marriage.ends) such that death <= e))
         -- Absent:
             # otherwise the marriage must run into the next year
             (if (number of (date_values of marriage.ends)) = 0
              then
                # No end date: the spouse's death is what ends the marriage, so
                # it must fall on or after 1 January next year for the marriage
                # to still be running at the close of the year.
                #
                # The test is on the death *event*, not on the death *dates*.
                # SARA writes
                #
                #     ( death_(D), agent_(D,Spouse) )
                #     ->  ( start_(D,End_time), is_before(First_day_next,End_time) )
                #     ;   true
                #
                # so a death event carrying no date does not fall through to
                # `true`: `start_/2` fails and the whole of (a)(1) fails with
                # it. Collecting the dates first and asking whether the list is
                # empty answers a different question, and made the port call a
                # taxpayer married whose spouse had an undated death.
                #
                # `->` also commits to the first solution of its condition, so
                # only the *first* such death event is consulted; a later dated
                # one cannot rescue an earlier undated one.
                (match (List.first_element of
                         (list of e among (death_event_values of world)
                           such that e.agents contains spouse)) with pattern
                 -- Absent: true
                 -- Present content dv:
                     exists d among (date_values of dv.starts) such that
                       (first_day_year of (taxable_year + 1)) <= d)
              else
                exists e among (date_values of marriage.ends) such that
                  (first_day_year of (taxable_year + 1)) <= e))
```

```catala-metadata
declaration scope MarriageStatus:
  input world content World
  input taxpayer content Entity
  input spouse content Entity
  input marriage content MarriageEvent
  input taxable_year content integer
  ## The marriage's candidate start dates. SARA writes the default as a
  ## *disjunction*, `( \+ start_(M,_), S = First_day_year ; start_(M,S) )`, so
  ## with several recorded starts it backtracks over every one of them and the
  ## clause holds if any satisfies the tests below. Reading one date here made
  ## the port answer false where SARA retries and succeeds (DEVIATIONS.md D74).
  output start_candidates content list of date
  ## The spouse's death, if it falls inside the taxable year.
  output spouse_died_on content optional of date
  output holds_a_1 content boolean
```



    (2) an individual legally separated from his spouse under a decree of divorce or of separate maintenance shall not be considered as married.


<!-- rtdf-block-id: sara/section7703:b0004; role: provision; provision-id: sara/section7703(a)(2); source-lines: 7-7; relation: formalizes-preceding -->
```catala
scope LegalSeparation:
  definition separated equals
    exists ev among (legal_separation_event_values of world) such that
      (optional_entity_equals of ev.patients, marriage.ident)
      and (exists a among (entity_values of ev.agents) such that
             a.tag = EntityTag.DecreeOfDivorce
             or a.tag = EntityTag.DecreeOfSeparateMaintenance)
      and (exists d among (date_values of ev.starts) such that
             d <= (last_day_year of taxable_year))
```

```catala-metadata
declaration scope LegalSeparation:
  input world content World
  input marriage content MarriageEvent
  input taxable_year content integer
  output separated content boolean
```



(b) Certain married individuals living apart

For purposes of those provisions of this title which refer to this subsection, if-


<!-- rtdf-block-id: sara/section7703:b0005; role: provision; provision-id: sara/section7703(b); source-lines: 9-11; relation: formalizes-preceding -->
```catala
scope MaritalStatus:
  definition households equals
    combine all ps
      among (map each ev among
              (list of e among (residence_event_values of world)
               such that e.agents contains taxpayer)
             to ev.patients)
      in acc initially []
      with acc ++ ps

scope MaritalStatus:
  definition derived_spouses equals
    list of sp among
      (output of MaritalStatusA with {
         -- world: world -- taxpayer: taxpayer
         -- taxable_year: taxable_year }).spouses
    such that
      not (exists h among households such that
             (output of LivingApartOne with {
                -- world: world -- taxpayer: taxpayer -- household: h
                -- taxable_year: taxable_year
                -- qualifying_dependants: qualifying_dependants }).holds
             and (output of LivingApartTwo with {
                    -- world: world -- taxpayer: taxpayer -- household: h
                    -- taxable_year: taxable_year }).holds
             and (output of LivingApartThree with {
                    -- world: world -- spouse: sp -- household: h
                    -- taxable_year: taxable_year }).holds)

scope MaritalStatus:
  definition granted_spouses equals
    list of e among
      (map each inj among
        ((injections_for_4_14 of injections, pred_s7703_4, taxpayer.id, num_key of taxable_year))
       to (match (injection_entity of inj, 2) with pattern
           -- Absent: taxpayer
           -- Present content sp: sp))
    such that e.id != taxpayer.id

scope MaritalStatus:
  definition spouses equals
    dedup_spouses of
      ((if pred_overridden of injections, pred_s7703_4
        then [] else derived_spouses)
       ++ granted_spouses)

scope MaritalStatus:
  definition spouse equals List.first_element of spouses

scope MaritalStatus:
  definition married equals (number of spouses) > 0

scope MaritalStatus:
  definition living_apart equals
    (output of MaritalStatusA with {
       -- world: world -- taxpayer: taxpayer
       -- taxable_year: taxable_year }).married
    and (number of derived_spouses) = 0
```

```catala-metadata
declaration dedup_spouses content list of Entity
  depends on l content list of Entity
  equals
    combine all x among l in acc initially []
    with (if (exists a among acc such that a.id = x.id) then acc else acc ++ [x])

declaration scope MaritalStatus:
  input world content World
  ## A case may *grant* `s7703/4` rather than model the marriage, and one that
  ## grants it without declaring the predicate discontiguous has replaced the
  ## whole of §7703: the derivation is gone and only the rows answer. See D65.
  input injections content list of Injection
  input taxpayer content Entity
  input taxable_year content integer
  ## §152(a)(1) dependants, from level 2.
  input qualifying_dependants content list of Entity
  ## Every household the taxpayer resides at.
  output households content list of Entity
  ## The (a) spouses that (b) does *not* take back out.
  output derived_spouses content list of Entity
  ## ... and the ones a case named outright.
  output granted_spouses content list of Entity
  output spouses content list of Entity
  output spouse content optional of Entity
  ## s7703_b/3 — true when (a) held but (b) removed every spouse.
  output living_apart content boolean
  ## s7703/4
  output married content boolean
```



    (1) an individual who is married (within the meaning of subsection (a)) and who files a separate return maintains as his home a household which constitutes for more than one-half of the taxable year the principal place of abode of a child with respect to whom such individual is entitled to a deduction for the taxable year under section 151,


<!-- rtdf-block-id: sara/section7703:b0006; role: provision; provision-id: sara/section7703(b)(1); source-lines: 13-13; relation: formalizes-preceding -->
```catala
scope LivingApartOne:
  definition holds equals
    # files a separate return
    (not (exists ev among (joint_return_event_values of world) such that
            ev.agents contains taxpayer
            and (optional_date_equals of ev.starts, (first_day_year of taxable_year))
            and (optional_date_equals of ev.ends, (last_day_year of taxable_year))))
    # maintains as his home the household
    and (exists rt among (residence_event_values of world) such that
           rt.agents contains taxpayer
           and rt.patients contains household)
    # which is the child's principal place of abode for more than half the year
    and (exists dep among qualifying_dependants such that
           (exists rc among
             (list of e among (residence_event_values of world)
              such that e.agents contains dep
                        and e.patients contains household)
            such that
              (exists st among rc.starts such that
                 (let span_start equals
                    (if st >= (first_day_year of taxable_year)
                     then st else (first_day_year of taxable_year)) in
                  let span_end equals
                    (match (earliest of
                             ((opt_dates of (date_values of rc.ends))
                              ++ [Present content (last_day_year of taxable_year)]))
                     with pattern
                     -- Absent: last_day_year of taxable_year
                     -- Present content d: d) in
                  (span_end - span_start) * 2
                    >= ((last_day_year of taxable_year)
                        - (first_day_year of taxable_year))))))
```

```catala-metadata
declaration scope LivingApartOne:
  input world content World
  input taxpayer content Entity
  input household content Entity
  input taxable_year content integer
  ## §152(a)(1) for some dependant residing in this household -- supplied by
  ## the caller at level 2 of the stratification.
  input qualifying_dependants content list of Entity
  output holds content boolean
```



    (2) such individual furnishes over one-half of the cost of maintaining such household during the taxable year, and


<!-- rtdf-block-id: sara/section7703:b0007; role: provision; provision-id: sara/section7703(b)(2); source-lines: 15-15; relation: formalizes-preceding -->
```catala
scope LivingApartTwo:
  definition cost equals
    Money.sum of
      (map each ev among
        (list of e among (payment_event_values of world)
         such that payment_for_household of e, world, household, taxable_year)
       to Money.sum of ev.amounts)

scope LivingApartTwo:
  definition furnished equals
    Money.sum of
      (map each ev among
        (list of e among (payment_event_values of world)
         such that (payment_for_household of e, world, household, taxable_year)
                   and e.agents contains taxpayer)
       to Money.sum of ev.amounts)

scope LivingApartTwo:
  definition holds equals cost > $0 and (furnished * (decimal of 2)) >= cost
```

```catala-metadata
declaration payment_for_household content boolean
  depends on ev content PaymentEvent, world content World,
             household content Entity, y content integer
  equals
    (if optional_purpose_equals of ev.purposes,
          (Purpose.PurposeEntity content household)
     then true
     else exists r among
            (list of e among (residence_event_values of world)
             such that e.patients contains household)
          such that optional_purpose_equals of ev.purposes,
                    (Purpose.PurposeEntity content r.ident))
    and (exists d among ev.starts such that Date.get_year of d = y)

declaration scope LivingApartTwo:
  input world content World
  input taxpayer content Entity
  input household content Entity
  input taxable_year content integer
  output cost content money
  output furnished content money
  output holds content boolean
```



    (3) during the last 6 months of the taxable year, such individual's spouse is not a member of such household,


<!-- rtdf-block-id: sara/section7703:b0008; role: provision; provision-id: sara/section7703(b)(3); source-lines: 17-17; relation: formalizes-preceding -->
```catala
scope LivingApartThree:
  definition window_start equals Date.of_year_month_day of taxable_year, 7, 2

scope LivingApartThree:
  definition window_end equals Date.of_year_month_day of (taxable_year + 1), 1, 1

scope LivingApartThree:
  definition any_membership equals
    exists ev among (residence_event_values of world) such that
      ev.agents contains spouse
      and ev.patients contains household
      and (exists st among ev.starts such that st <= window_end)
      and ((number of (date_values of ev.ends)) = 0
           or (exists en among (date_values of ev.ends) such that en >= window_start))

scope LivingApartThree:
  definition holds equals not any_membership
```

```catala-metadata
declaration scope LivingApartThree:
  input world content World
  input spouse content Entity
  input household content Entity
  input taxable_year content integer
  output window_start content date
  output window_end content date
  output any_membership content boolean
  output holds content boolean
```



such individual shall not be considered as married.

