                 -- agents: [ Entity { -- id: 1 -- tag: EntityTag.PlainEntity };
                              Entity { -- id: 3 -- tag: EntityTag.PlainEntity } ]
                 -- starts: [ |2015-02-02| ] -- ends: Absent
