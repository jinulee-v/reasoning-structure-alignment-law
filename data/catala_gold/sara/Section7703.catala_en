      inj.pred = pred
      and (injection_arity of inj) = 8
      and (arg_matches of (injection_key of inj, 2), wanted_2)
      and (arg_matches of (injection_key of inj, 3), wanted_3)
      and (arg_matches of (injection_key of inj, 4), wanted_4)
      and (arg_matches of (injection_key of inj, 5), wanted_5)
      and (arg_matches of (injection_key of inj, 6), wanted_6)
      and (arg_matches of (injection_key of inj, 7), wanted_7)

## A case that injects a conclusion *without* declaring the predicate
## `discontiguous` **replaces** the statute's clauses for it rather than adding
## to them: SWI reports "Redefined static procedure" and the statute's own
## definition is gone. The corpus always declares, so the difference is
## invisible there, but it decides whether a derivation still runs at all --
## `s151_b_applies/2` is the sharp case, because the clause a case overrides is
## the unconditionally-true one of D2.
##
declaration pred_overridden content boolean
  depends on injections content list of Injection, pred content integer
  equals
    exists inj among injections such that
      inj.pred = pred and inj.replaces_statute

## Is a predicate's *derivation* still available to this caller? A grant that
## was added leaves the statute's own clauses in place; one that replaced them
## leaves nothing but the rows, so the derivation is gone and only a matching
## row answers. Callers that need the distinction between "no value" and "the
## value zero" pair this with an `applies` output of their own.

declaration pred_available content boolean
  depends on injections content list of Injection, pred content integer,
             matching_injections content list of Injection
  equals
    (not (pred_overridden of injections, pred))
    or (injected_holds of matching_injections)

## Was this conclusion injected at all? This is the common case: a case grants
## a subsection and Layer 1 short-circuits its own derivation.

declaration injected_holds content boolean
  depends on matching_injections content list of Injection
  equals (number of matching_injections) > 0

## The numeric payload at position `pos` (1-based) of the first matching
## injection, as money. Absent when nothing matches.

declaration injected_money content optional of money
  depends on matching_injections content list of Injection, pos content integer
  equals
    match (List.first_element of matching_injections) with pattern
    -- Absent: Absent
    -- Present content inj:
        (match (injection_num of inj, pos) with pattern
         -- Absent: Absent
         -- Present content n: Present content (money of n))

declaration injected_money_result content InjectedMoneyResult
  depends on matching_injections content list of Injection, pos content integer
  equals
    match (List.first_element of matching_injections) with pattern
    -- Absent:
        InjectedMoneyResult {
          -- holds: false
          -- amount: Absent }
    -- Present content inj:
        InjectedMoneyResult {
          -- holds: true
          -- amount:
              (match (injection_num of inj, pos) with pattern
               -- Absent: Absent
               -- Present content n: Present content (money of n)) }

## A case may inject a *rule* rather than a fact -- `s3306_c(E,alice,Employee,Day,_)
## :- member(Day, ...))` -- which the grounder expands into one row per
## solution. Reading such a grant back means recovering each argument from the
## row it came from, not just asking whether some row matched, so these three
## project one position of one injection into its own space.

declaration injection_entity content optional of Entity
  depends on inj content Injection, pos content integer
  equals
    entity_of_key of (injection_key of inj, pos)

declaration injection_date content optional of date
  depends on inj content Injection, pos content integer
  equals match inj.arguments with pattern
    -- Args1 content ignored: Absent
    -- Args2 content ignored: Absent
    -- Args3 content ignored: Absent
    -- Args4 content a:
        if pos = 3 then a.three_date
        else if pos = 4 then a.four_date
        else Absent
    -- Args5 content a: if pos = 4 then a.four_date else Absent
    -- Args6 content a:
        if pos = 5 then a.five_date
        else if pos = 6 then a.six_date
        else Absent
    -- Args7 content ignored: Absent
    -- Args8 content ignored: Absent

declaration injection_num content optional of integer
  depends on inj content Injection, pos content integer
  equals
    (let k equals injection_key of inj, pos in
      if k < 1000000 or k >= 2000000 then Absent
      else Present content (k - 1000000))

## As above, but the raw integer payload.

declaration injected_num content optional of integer
  depends on matching_injections content list of Injection, pos content integer
  equals
    match (List.first_element of matching_injections) with pattern
    -- Absent: Absent
    -- Present content inj: injection_num of inj, pos

## The match key for an integer argument -- a taxable year, or a whole-dollar
## amount as the Prolog writes it.

declaration num_key content integer
  depends on n content integer
  equals 1000000 + n

## The match key for a money argument, which SARA always states in whole dollars.

declaration money_key content money
  depends on m content money
  equals m + (money of 1000000)

## The inverse, for the one direction that needs it: an injected argument that
## names a *person* can be turned back into an entity, since entity ids keep
## their small interned values and the numeric and date spaces start at
## 1,000,000. A don't-care (-1) has no entity. The tag is not recoverable, but
## every injected person argument in the corpus is a plain entity, and the
## reconstructed value is only ever compared by id.

declaration entity_of_key content optional of Entity
  depends on k content integer
  equals
    if k < 0 or k >= 1000000 then Absent
    else Present content (Entity { -- id: k -- tag: EntityTag.PlainEntity })

