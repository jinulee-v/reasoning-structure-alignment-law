        (B) such labor is not agricultural labor performed by an individual who is an alien admitted to the United States to perform agricultural labor pursuant to sections 214(c) and 101(a)(15)(H) of the Immigration and Nationality Act.


<!-- rtdf-block-id: sara/section3306:b0031; role: provision; provision-id: sara/section3306(c)(1)(B); source-lines: 73-73; relation: formalizes-preceding -->
```catala
scope AgriculturalAlien:
  definition holds equals
    not (exists eid among (service_ids of world) such that
           (ent_ok of service, eid)
           and (is_agricultural_id of world, eid)
           and (exists cz among (W.citizenship_event_values of world) such that
                  (exists person among (W.entity_values of cz.agents) such that
                         (exists country among cz.patients such that
                            country.tag != W.EntityTag.UsaEntity)
                         and (exists mg among (W.migration_event_values of world) such that
                                (W.optional_entity_equals of mg.agents, person)
                                and (exists dest among (W.place_values of mg.destinations) such that
                                       place_is_usa of dest)
                                and (has_purpose of world, mg.purposes,
                                       W.Purpose.AgriculturalLabor)))))

scope AgriculturalWages:
  # `findall(Amount, (payment for agricultural service in Caly or Caly-1))`,
  # then `sum_list` and a $20,000 threshold. The window spans two calendar
  # years: from the first day of the preceding year to the last of this one.
  #
  # The nesting is the Prolog's conjunction, in its order, so the list length
  # is the solution count rather than the number of distinct payments. Each
  # goal that can match more than one fact multiplies the row.

scope AgriculturalWages:
  definition rows equals
    flatten_agri of
      (map each pay among
        (W.payment_event_values of world)
       to (flatten_agri of
            (map each er among (ent_hits of employer, pay.agents)
             to (flatten_agri of
                  (map each ee among pay.patients
                   to (flatten_agri of
                        (map each svc among
                          (employment_events_for_payment of world, pay)
                         to (map each amt among pay.amounts
                               to AgriRow { -- amount: amt -- employee: ee
                                            -- service: svc.ident
                                            -- multiplicity:
                               ((number of (list of a among svc.agents
                                            such that a.id = ee.id))
                                * (number of (list of q among svc.patients
                                              such that q.id = er.id))
                                * (number of (agri_hits of world, svc.purposes, svc.types))
                                * (number of (purpose_hits of world, pay.purposes,
                                     (W.Purpose.PurposeEntity content svc.ident)))
                                * (number of (list of t among pay.starts such that
                                     (W.first_day_year of (caly - 1)) <= t
                                     and t <= (W.last_day_year of caly)))
                                * (cash_ways of pay)) }))))))))

scope AgriculturalWages:
  definition total equals
    Money.sum of
      (map each r among rows
       to (weighted_amount of r.amount, r.multiplicity))

scope AgriculturalWages:
  definition employees equals expand_agri_employees of rows

scope AgriculturalWages:
  definition holds equals total >= $20,000
```

```catala-metadata
declaration scope AgriculturalAlien:
  input world content W.World
  input service content optional of W.Entity
  # s3306_c_1_B/2, which is itself a negation: the labor is *not* performed by
  # an alien admitted to the United States to perform it.
  output holds content boolean

declaration scope AgriculturalWages:
  input world content W.World
  input employer content optional of W.Entity
  input caly content integer
  # The `(Amount, Employee, Service)` triples the findall collects, in order.
  output rows content list of AgriRow
  output total content money
  # The second and third findalls project the same triples, so the employee
  # list a case may name is this projection, duplicates and all.
  output employees content list of W.Entity
  # s3306_c_1_A_i/5
  output holds content boolean
```



