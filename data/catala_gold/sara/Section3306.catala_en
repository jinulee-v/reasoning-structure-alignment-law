    (A) performed by an employee for the person employing him, irrespective of the citizenship or residence of either, within the United States, and


<!-- rtdf-block-id: sara/section3306:b0025; role: provision; provision-id: sara/section3306(c)(A); source-lines: 61-61; relation: formalizes-preceding -->
```catala-metadata
## `((country_(G,C), C=="usa") ; (\+ country_(G,_), G=="usa"))`, counted.

declaration usa_ways content integer
  depends on world content W.World, g content W.Place
  equals
    (number of (list of c among (countries_of_place of world, g)
                such that c.tag = W.EntityTag.UsaEntity))
    + (if (number of (countries_of_place of world, g)) = 0 and (place_is_usa of g)
       then 1 else 0)

## Every entity carrying a `country_` row, once per row.

declaration country_rows content list of W.Entity
  depends on world content W.World
  equals
    map each fact among world.country_facts to fact.subject

## Is there an unemployment compensation agreement between the USA and this
## place? With `Location` unbound the third goal matches any agent at all.

declaration uca_with content boolean
  depends on world content W.World, loc content optional of W.Entity
  equals
    exists ag among (W.unemployment_compensation_agreement_event_values of world) such that
      (exists a among (W.entity_values of ag.agents) such that a.tag = W.EntityTag.UsaEntity)
      and (exists a among (W.entity_values of ag.agents) such that ent_ok of loc, a)

## The ways (B)'s location test can succeed.

declaration foreign_ways content integer
  depends on world content W.World
  equals
    (number of
      (list of fact among world.country_facts such that
         fact.value.tag != W.EntityTag.UsaEntity
         and not (uca_with of world, (Present content fact.subject))))
    + (if (number of (country_rows of world)) = 0
          and not (uca_with of world, Absent)
       then 1 else 0)

## `american_employer_(X), agent_(X,Employer)`, counted.

declaration american_employer_ways content integer
  depends on world content W.World, employer content W.Entity
  equals
    Integer.sum of
      (map each ev among
        (W.american_employer_event_values of world)
       to (number of (list of a among (W.entity_values of ev.agents) such that a.id = employer.id)))

## `citizenship_(X), agent_(X,Employee), patient_(X,"usa")`, counted.

declaration us_citizen_ways content integer
  depends on world content W.World, employee content W.Entity
  equals
    Integer.sum of
      (map each ev among
        (W.citizenship_event_values of world)
        to ((number of (list of a among (W.entity_values of ev.agents) such that a.id = employee.id))
           * (number of (list of q among ev.patients
                         such that q.tag = W.EntityTag.UsaEntity))))

declaration employment_from_a content list of Emp
  depends on world content W.World,
             service_role_events content list of W.Entity,
             employer content optional of W.Entity,
             employee content optional of W.Entity
  equals
    flatten_emp of
      (map each eid among service_role_events
       to (flatten_emp of
            (map each a among (ent_hits of employee, (service_agents of world, eid))
             to (flatten_emp of
                  (map each p among (ent_hits of employer, (service_patients of world, eid))
                   to (map each g among (places_of of (service_places of world, eid))
                       to Emp { -- service: eid -- employer: p
                                -- employee: a -- workday: Absent
                                -- caly: Absent
                                -- multiplicity: usa_ways of world, g }))))))

scope EmploymentCandidates:
  definition from_a equals
    employment_from_a of world, service_role_events, employer, employee

declaration abroad_ways content integer
  depends on world content W.World, employer content W.Entity, employee content W.Entity
  equals
    (foreign_ways of world)
    * (american_employer_ways of world, employer)
    * (us_citizen_ways of world, employee)
```

