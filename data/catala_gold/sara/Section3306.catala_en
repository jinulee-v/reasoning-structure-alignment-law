            (ii) by the spouse of such a student, or


<!-- rtdf-block-id: sara/section3306:b0039; role: provision; provision-id: sara/section3306(c)(10)(A)(ii); source-lines: 93-93; relation: formalizes-preceding -->
```catala
scope StudentSpouse:
  definition holds equals
    match workday with pattern
    -- Absent: false
    -- Present content d:
        (exists sp among
           (output of S7703.MaritalStatus with {
              -- injections: injections -- world: world -- taxpayer: student
              -- taxable_year: Date.get_year of d
              -- qualifying_dependants:
                   (output of S152.QualifyingChildrenOf with {
                      -- injections: injections -- world: world
                      -- taxpayer: student
                      -- taxable_year: Date.get_year of d
                      -- child_of: child_of -- sibling_of: sibling_of
                      -- descendent_of: descendent_of
                      -- stepsibling_of: stepsibling_of }).children }).spouses
         such that sp.id = spouse.id)
        and (exists c among
               (output of S7703.MaritalStatusA with {
                  -- world: world -- taxpayer: student
                  -- taxable_year: Date.get_year of d }).candidates
             such that
               c.spouse.id = spouse.id
               # `\+ start_(M,_) ; is_before(Start,Workday)`, and likewise the end
               and ((number of c.marriage.starts) = 0
                    or (exists s among c.marriage.starts such that s <= d))
               and ((number of (W.date_values of c.marriage.ends)) = 0
                    or (exists e among (W.date_values of c.marriage.ends) such that d <= e)))
        # and the spouse is themselves enrolled somewhere -- `Employer` is
        # left unbound at this call site, so any institution will do
        and (output of Student with {
               -- world: world -- student: Present content spouse
               -- employer: Absent -- workday: workday }).holds
```

