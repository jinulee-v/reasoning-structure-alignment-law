```catala
scope PlanPurpose:
  definition holds_a equals
    exists ev among world.events such that
      (ent_ok of plan, ev.ident)
      and ((has_purpose of world, ev, W.Purpose.ProvisionSickness)
           or (has_purpose of world, ev, W.Purpose.ProvisionAccidentDisability))

  definition holds_c equals
    exists ev among world.events such that
      (ent_ok of plan, ev.ident)
      and (has_purpose of world, ev, W.Purpose.ProvisionDeath)

scope ExcludedPlanPayment:
  definition holds equals
    (output of EmploymentLower with {
       -- world: world -- injections: injections
       -- child_of: child_of -- sibling_of: sibling_of
       -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
       -- service: service -- employer: employer -- employee: employee
       -- workday: Absent -- caly: Absent }).holds
    and (exists rem among world.events such that
           rem.kinds contains W.EventKind.Payment
           and (ent_ok of remuneration, rem.ident)
           and (exists er among rem.agents such that ent_ok of employer, er)
           and (exists pl among world.events such that
                  pl.kinds contains W.EventKind.Plan
                  and (ent_ok of plan, pl.ident)
                  and ((output of PlanPurpose with {
                          -- world: world
                          -- plan: Present content pl.ident }).holds_a
                       or (output of PlanPurpose with {
                             -- world: world
                             -- plan: Present content pl.ident }).holds_c)
                  and (exists ben among pl.beneficiaries such that
                         # `Employee == Payee` -- the §152 alternative raises an
                         # instantiation error in SWI, because it calls
                         # `s152/3` with the taxable year unbound. See
                         # DEVIATIONS.md; it is unreachable in the corpus.
                         (ent_ok of employee, ben)
                         and ((rem.patients contains pl.ident)
                              or ((exists m among rem.media such that
                                     m = (W.Medium.MediumEntity content pl.ident))
                                  and (exists q among rem.patients such that
                                         q.id = ben.id))))))

scope ExcludedNonCashOutsideBusiness:
  # `s3306_c(Service,Employer,Employee,_,_)` binds the service and the employer,
  # and the two goals after it reuse both: `agent_(Employers_business,Employer)`
  # and `type_(Service,Type_service)`. Asking each against the query's own
  # arguments -- unbound in every case that reaches this -- let a business run
  # by one person be weighed against an employment held by another. Same shape
  # as D36; see D52.
  definition holds equals
    exists emp among
      (output of EmploymentLower with {
         -- world: world -- injections: injections
         -- child_of: child_of -- sibling_of: sibling_of
         -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
         -- service: service -- employer: employer -- employee: employee
         -- workday: Absent -- caly: Absent }).solutions
    such that
      (exists rem among world.events such that
         (ent_ok of remuneration, rem.ident)
         and (exists m among rem.media such that m != W.Medium.Cash))
      and (exists biz among world.events such that
             biz.kinds contains W.EventKind.Business
             and biz.agents contains emp.employer
             and (exists bt among biz.types such that
                    exists svc among world.events such that
                      svc.ident.id = emp.service.id
                      and (exists st among svc.types such that st != bt)))

scope ExcludedTerminationPayment:
  definition holds equals
    exists rem among world.events such that
      (ent_ok of remuneration, rem.ident)
      and (exists sr among rem.starts such that
             exists term among world.events such that
               term.kinds contains W.EventKind.Termination
               and (exists a among term.agents such that ent_ok of employer, a)
               and (exists emp among term.patients such that
                      (ent_ok of employment, emp)
                      and (exists st among
                             (term.starts ++ (ends_of of world, emp))
                           such that st <= sr))
               and (exists reason among term.reasons such that
                      exists rev among world.events such that
                        rev.ident.id = reason.id
                        and (rev.kinds contains W.EventKind.Disability
                             or rev.kinds contains W.EventKind.Death)
                        and (exists a among rev.agents such that ent_ok of employee, a)))

scope ExcludedTerminationPlan:
  definition holds equals
    exists rem among world.events such that
      (ent_ok of remuneration, rem.ident)
      and (exists m among rem.media such that
             match m with pattern
             -- Cash: false
             -- MediumEntity content pl:
                 (ent_ok of plan, pl)
                 and (exists ev among world.events such that
                        ev.ident.id = pl.id
                        and ev.kinds contains W.EventKind.Plan
                        and (exists a among ev.agents such that ent_ok of employer, a)
                        and (has_purpose of world, ev,
                               W.Purpose.ProvisionEmployeesOrDependents)))

scope ExcludedDeathBenefit:
  definition holds equals
    (output of EmploymentLower with {
       -- world: world -- injections: injections
       -- child_of: child_of -- sibling_of: sibling_of
       -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
       -- service: service -- employer: employer -- employee: employee
       -- workday: Absent -- caly: Absent }).holds
    and (exists rem among world.events such that
           (ent_ok of remuneration, rem.ident)
           and (number of rem.starts) > 0
           and (exists a among rem.agents such that ent_ok of employer, a)
           and (exists q among rem.patients such that
                  (ent_ok of payee, q)
                  and ((ent_ok of employee, q)
                       or (exists rd among rem.starts such that
                             match employee with pattern
                             -- Absent: false
                             -- Present content ee:
                                 (output of S152.IsDependent with {
                                    -- injections: injections -- world: world
                                    -- dependant: ee -- taxpayer: q
                                    # the payee is bound from the remuneration
                                    # event before §152 is reached
                                    -- taxpayer_generated: false
                                    -- dependant_generated: false
                                    -- taxable_year: Date.get_year of rd
                                    -- child_of: child_of
                                    -- sibling_of: sibling_of
                                    -- descendent_of: descendent_of
                                    -- stepsibling_of: stepsibling_of
                                    -- stepparent_of: []
                                    -- child_in_law_of: child_in_law_of
                                    -- parent_in_law_of: parent_in_law_of
                                    -- sibling_in_law_of: sibling_in_law_of }).holds))))
    and (output of ExcludedTerminationPayment with {
           -- world: world -- remuneration: remuneration
           -- employment: service -- employee: employee
           -- employer: employer }).holds
    and (output of ExcludedTerminationPlan with {
           -- world: world -- employer: employer
           -- remuneration: remuneration -- plan: plan }).holds

scope ExcludedAgriculturalInKind:
  definition holds equals
    exists svc among world.events such that
      svc.kinds contains W.EventKind.Service
      and (ent_ok of service, svc.ident)
      and (has_purpose of world, svc, W.Purpose.AgriculturalLabor)
      and (exists er among svc.patients such that
             exists ee among svc.agents such that
               exists rem among world.events such that
                 (ent_ok of remuneration, rem.ident)
                 and rem.agents contains er
                 and rem.patients contains ee
                 and (has_purpose of world, rem,
                        (W.Purpose.PurposeEntity content svc.ident))
                 and (exists m among rem.media such that m != W.Medium.Cash))

scope ExcludedSurvivorPayment:
  # `s3306_c(_,Employer,Employee,_,_)` *binds* the employer and the employee,
  # and every later goal reuses those bindings: `agent_(Remuneration,Employer)`,
  # `agent_(Edeath,Employee)`, `agent_(Emar,Employee)`. Asking each of them
  # separately whether *some* agent fits the query's own (usually unbound)
  # employer and employee is a weaker question, and it let a remuneration paid
  # by one person count against an employment held by another. Iterating
  # `solutions` keeps one row's pair throughout, which is what the shared
  # variables mean. `holds` is `(number of solutions) > 0`, so the existential
  # subsumes the conjunct this replaced.
  definition holds equals
    exists emp among
      (output of EmploymentLower with {
         -- world: world -- injections: injections
         -- child_of: child_of -- sibling_of: sibling_of
         -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
         -- service: Absent -- employer: employer -- employee: employee
         -- workday: Absent -- caly: Absent }).solutions
    such that
      (exists rem among world.events such that
         (ent_ok of remuneration, rem.ident)
         and (rem.agents contains emp.employer)
         # `patient_(Remuneration,Payee)` *binds* the payee and
         # `agent_(Emar,Payee)` reuses it: the person paid has to be the one
         # the employee was married to. Testing each against the query's own
         # payee -- unbound in every case that reaches this -- asked only that
         # the employee was married to somebody. See D63.
         and (exists q among rem.patients such that
                (ent_ok of payee, q)
                and (exists sr among rem.starts such that
                       exists death among world.events such that
                         death.kinds contains W.EventKind.Death
                         and (death.agents contains emp.employee)
                         and (exists td among death.starts such that
                                (exists mar among world.events such that
                                   mar.kinds contains W.EventKind.Marriage
                                   and (mar.agents contains emp.employee)
                                   and (exists b among mar.agents such that
                                          b.id = q.id)
                                   and ((number of mar.ends) = 0
                                        or mar.ends contains td))
                                # `Year_remuneration @> Caly` compares the two
                                # year strings, which for four-digit years is
                                # the numeric comparison.
                                and (Date.get_year of sr)
                                      > (Date.get_year of td)))))
```

### (b) itself

```catala-metadata
## How many ways `s3306_c(Employment,_,_,_,Year)` succeeds for one service,
## summed over its end dates -- which is the pair of goals `end_(E,T),
## s3306_c(E,_,_,_,year(T))` in `s3306_b`. Hoisted out of the wage generator
## because it does not depend on the payment, and (c) is the expensive half of
## this module.
declaration structure ServiceYear:
  data service content W.Entity
  data ways content integer

declaration ways_of content integer
  depends on table content list of ServiceYear, target content W.Entity
  equals
    match (List.first_element of
             (list of r among table such that r.service.id = target.id)) with pattern
    -- Absent: 0
    -- Present content r: r.ways

## The rows a case grants outright. Eight cases assert `s3306_b/8` directly
## rather than supplying the payment and service it would be derived from.
declaration injected_wages content list of WageRow
  depends on injections content list of W.Injection,
             remuneration content optional of W.Entity,
             employment content optional of W.Entity,
             payer content optional of W.Entity,
             payee content optional of W.Entity,
             employer content optional of W.Entity,
             employee content optional of W.Entity
  equals
    map each inj among
      (W.injections_for of injections, P.pred_s3306_b_8,
        [-1; (key_of of remuneration); (key_of of employment); (key_of of payer);
         (key_of of payee); (key_of of employer); (key_of of employee); -1])
    to WageRow {
      -- wages:
           (match (W.injection_num of inj, 1) with pattern
            -- Present content n: money of n
            -- Absent: $0)
      -- remuneration: ent_from of (W.injection_entity of inj, 2), remuneration
      -- employment: ent_from of (W.injection_entity of inj, 3), employment
      -- payer: ent_from of (W.injection_entity of inj, 4), payer
      -- payee: ent_from of (W.injection_entity of inj, 5), payee
      -- employer: ent_from of (W.injection_entity of inj, 6), employer
      -- employee: ent_from of (W.injection_entity of inj, 7), employee }

declaration scope Wages:
  input world content W.World
  input injections content list of W.Injection
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input child_in_law_of content list of K.Kinship
  input parent_in_law_of content list of K.Kinship
  input sibling_in_law_of content list of K.Kinship
  input agri_employers content list of AgriYear
  input remuneration content optional of W.Entity
  input employment content optional of W.Entity
  input payer content optional of W.Entity
  input payee content optional of W.Entity
  input employer content optional of W.Entity
  input employee content optional of W.Entity
  ## `end_(E,T), s3306_c(E,_,_,_,year(T))` for every service in the world.
  output employment_ways content list of ServiceYear
  ## Before the five exclusions of (b)(2)–(b)(15).
  output raw_rows content list of WageRow
  ## One row per solution of `s3306_b/8`.
  output rows_available content boolean
  output rows content list of WageRow
  output holds content boolean
```

```catala
scope Wages:
  definition employment_ways equals
    map each emp among (events_with_kind of world, W.EventKind.Service)
    to ServiceYear {
         -- service: emp.ident
         -- ways:
              Integer.sum of
                (map each endd among emp.ends
                 to (number of
                      (output of Employment with {
                         -- world: world -- injections: injections
                         -- child_of: child_of -- sibling_of: sibling_of
                         -- descendent_of: descendent_of
                         -- stepsibling_of: stepsibling_of
                         -- agri_employers: agri_employers
                         -- service: Present content emp.ident
                         -- employer: Absent -- employee: Absent
                         -- workday: Absent
                         -- caly: Present content (Date.get_year of endd)
                       }).solutions)) }

  # The Prolog's conjunction, in its order. `purpose_(Remuneration,Employment)`
  # drives the search for the service rather than being checked after one: the
  # multiset is the same, since event ids are unique, and it turns a quadratic
  # scan into a linear one.
  definition raw_rows equals
    flatten_wage of
      (map each rem among
        (list of e among world.events
         such that e.kinds contains W.EventKind.Payment
                   and (ent_ok of remuneration, e.ident))
       to (flatten_wage of
            (map each pyr among (ent_hits of payer, rem.agents)
             to (flatten_wage of
                  (map each pr among
                    (list of x among (payee_rows of world, rem)
                     such that ent_ok of payee, x.payee)
                   to (flatten_wage of
                        (map each pu among rem.purposes
                         to (flatten_wage of
                              (map each emp among
                                (list of e among world.events such that
                                   e.kinds contains W.EventKind.Service
                                   and (ent_ok of employment, e.ident)
                                   and pu = (W.Purpose.PurposeEntity content e.ident))
                               to (flatten_wage of
                                    (map each ee among (ent_hits of employee, emp.agents)
                                     to (flatten_wage of
                                          (map each er among
                                            (ent_hits of employer, emp.patients)
                                           to (flatten_wage of
                                                (map each amt among rem.amounts
                                                 to (repeat_wage of
                                                      WageRow {
                                                        -- wages: Money.min of $7,000, amt
                                                        -- remuneration: rem.ident
                                                        -- employment: emp.ident
                                                        -- payer: pyr
                                                        -- payee: pr.payee
                                                        -- employer: er
                                                        -- employee: ee },
                                                      ((ways_of of employment_ways, emp.ident)
                                                       * (medium_ways of rem))))))))))))))))))

  definition rows equals
    (list of r among raw_rows such that
       not (output of ExcludedPlanPayment with {
              -- world: world -- injections: injections
              -- child_of: child_of -- sibling_of: sibling_of
              -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
              -- remuneration: Present content r.remuneration
              -- service: Present content r.employment
              -- employer: Present content r.payer
              -- employee: Present content r.payee
              -- plan: Absent }).holds
       and not (output of ExcludedNonCashOutsideBusiness with {
                  -- world: world -- injections: injections
                  -- child_of: child_of -- sibling_of: sibling_of
                  -- descendent_of: descendent_of
                  -- stepsibling_of: stepsibling_of
                  -- remuneration: Present content r.remuneration
                  -- service: Present content r.employment
                  -- employer: Present content r.payer
                  -- employee: Present content r.payee }).holds
       and not (output of ExcludedDeathBenefit with {
                  -- world: world -- injections: injections
                  -- child_of: child_of -- sibling_of: sibling_of
                  -- descendent_of: descendent_of
                  -- stepsibling_of: stepsibling_of
                  -- child_in_law_of: child_in_law_of
                  -- parent_in_law_of: parent_in_law_of
                  -- sibling_in_law_of: sibling_in_law_of
                  -- remuneration: Present content r.remuneration
                  -- service: Present content r.employment
                  -- employer: Present content r.payer
                  -- employee: Present content r.payee
                  -- payee: Present content r.payee
                  -- plan: Absent }).holds
       and not (output of ExcludedAgriculturalInKind with {
                  -- world: world
                  -- remuneration: Present content r.remuneration
                  -- service: Present content r.employment }).holds
       and not (output of ExcludedSurvivorPayment with {
                  -- world: world -- injections: injections
                  -- child_of: child_of -- sibling_of: sibling_of
                  -- descendent_of: descendent_of
                  -- stepsibling_of: stepsibling_of
                  -- remuneration: Present content r.remuneration
                  -- employer: Present content r.employer
                  -- payee: Present content r.payee
                  -- employee: Present content r.employee }).holds)
    ++ (injected_wages of injections, remuneration, employment, payer, payee,
          employer, employee)

  # A case that grants `s3306_b/8` without declaring the predicate
  # discontiguous has replaced (b) outright: the derived rows are gone and only
  # the granted ones are wages. See D69.
  definition rows_available equals
    not (W.pred_overridden of injections, P.pred_s3306_b_8)

  exception definition rows
    under condition (not rows_available)
    consequence equals
      injected_wages of injections, remuneration, employment, payer, payee,
        employer, employee

  definition holds equals (number of rows) > 0
```

## (a) Employer

Three independent routes to being an employer: paragraph (1) for employment
generally, (2) for agricultural labor, (3) for domestic service. Each of (1)
and (2) has a dollar test and a ten-day test; (3) has only a dollar test. Every
dollar test looks at the calendar year *and the one before it*, which the two
disjuncts of each `findall` cover as two adjacent windows.

```catala-metadata
declaration starts_of content list of date
  depends on world content W.World, e content W.Entity
  equals
    flatten_dates of
      (map each ev among (list of x among world.events such that x.ident.id = e.id)
       to ev.starts)

## `start_(Remuneration,Time)` where the row left `Remuneration` *unbound* --
## which is what `s3306_a_1_A_pos` does, injecting
## `s3306_b(3200,_,bob_works,alice,bob,alice,bob,_)`. An unbound first argument
## makes `start_/2` a generator over every start date in the world, and the
## wages are then counted once per date rather than once. A negative id is how
## an injected don't-care arrives here.
declaration starts_for content list of date
  depends on world content W.World, e content W.Entity
  equals
    if e.id < 0
    then flatten_dates of (map each ev among world.events to ev.starts)
    else starts_of of world, e

## The event a wage row's employment names, for reading its purposes back.
declaration purposes_of content list of W.Purpose
  depends on world content W.World, e content W.Entity
  equals
    combine all ps
      among (map each ev among
              (list of x among world.events such that x.ident.id = e.id)
             to ev.purposes)
      in acc initially [] with acc ++ ps

declaration scope EmployerWages:
  input world content W.World
  input injections content list of W.Injection
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input child_in_law_of content list of K.Kinship
  input parent_in_law_of content list of K.Kinship
  input sibling_in_law_of content list of K.Kinship
  input agri_employers content list of AgriYear
  input person content W.Entity
  input caly content integer
  ## Every `s3306_b/8` row this person paid.
  output paid content list of WageRow
  ## s3306_a_1_A/3
  output general_total content money
  output holds_1_A content boolean
  ## The (amount, employee, service) rows (a)(2)(A) and (a)(3) collect.
  internal agri_rows content list of AgriRow
  internal domestic_rows content list of AgriRow
  ## s3306_a_2_A/4
  output agri_total content money
  output agri_services content list of W.Entity
  output holds_2_A content boolean
  ## s3306_a_3/4
  output domestic_total content money
  output domestic_services content list of W.Entity
  output holds_3 content boolean
```

```catala
scope EmployerWages:
  definition paid equals
    (output of Wages with {
       -- world: world -- injections: injections
       -- child_of: child_of -- sibling_of: sibling_of
       -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
       -- child_in_law_of: child_in_law_of
       -- parent_in_law_of: parent_in_law_of
       -- sibling_in_law_of: sibling_in_law_of
       -- agri_employers: agri_employers
       -- remuneration: Absent -- employment: Absent
       -- payer: Present content person -- payee: Absent
       -- employer: Absent -- employee: Absent }).rows

  definition general_total equals
    Money.sum of
      (flatten_money of
        (map each r among
          (list of x among paid such that
             not ((purposes_of of world, x.employment)
                    contains W.Purpose.AgriculturalLabor)
             and not (world.universal_purposes
                        contains W.Purpose.AgriculturalLabor)
             and not ((purposes_of of world, x.employment)
                        contains W.Purpose.DomesticService)
             and not (world.universal_purposes
                        contains W.Purpose.DomesticService))
         to (map each t among (dates_in_window of
                                 (starts_for of world, r.remuneration), caly)
             to r.wages)))

  definition holds_1_A equals general_total >= $1,500

  definition agri_total equals
    Money.sum of (map each r among agri_rows to r.amount)

  definition agri_services equals map each r among agri_rows to r.service

  definition holds_2_A equals agri_total >= $20,000

  definition domestic_total equals
    Money.sum of (map each r among domestic_rows to r.amount)

  definition domestic_services equals map each r among domestic_rows to r.service

  definition holds_3 equals domestic_total >= $1,000
```

`agri_rows` and `domestic_rows` are the same shape, and the `Service` list the
two paragraphs report is the projection of those rows, so both are built once
below.

```catala-metadata
declaration dates_in_window content list of date
  depends on ds content list of date, caly content integer
  equals
    list of d among ds such that
      (W.first_day_year of (caly - 1)) <= d and d <= (W.last_day_year of caly)

## §3306(a)(1)(A) reaches back a year -- "during the calendar year or the
## preceding calendar year" -- but `total_wages_employer/6` does not: §3301 is
## handed `first_day_year(Caly)` and `last_day_year(Caly)` and tests the
## remuneration against those. A payment made in the year before the one taxed
## makes its payer an employer without being wages of that year. See D53.
declaration dates_in_year content list of date
  depends on ds content list of date, caly content integer
  equals
    list of d among ds such that
      (W.first_day_year of caly) <= d and d <= (W.last_day_year of caly)
```

```catala
scope EmployerWages:
  definition agri_rows equals
    flatten_agri of
      (map each r among paid
       to (flatten_agri of
            (map each t among (dates_in_window of
                                 (starts_for of world, r.remuneration), caly)
             to (repeat_agri of
                   AgriRow { -- amount: r.wages -- employee: r.payee
                             -- service: r.employment },
                   (number of (agri_purpose_hits of world, r.employment))))))

  definition domestic_rows equals
    flatten_agri of
      (map each r among paid
       to (flatten_agri of
            (map each t among (dates_in_window of
                                 (starts_for of world, r.remuneration), caly)
             to (repeat_agri of
                   AgriRow { -- amount: r.wages -- employee: r.payee
                             -- service: r.employment },
                   ((number of (domestic_purpose_hits of world, r.employment))
                    * (cash_ways_of of world, r.remuneration))))))
```

## (a) as a whole

```catala-metadata
declaration agri_purpose_hits content list of W.Purpose
  depends on world content W.World, e content W.Entity
  equals
    (list of x among (purposes_of of world, e)
     such that x = W.Purpose.AgriculturalLabor)
    ++ (list of x among world.universal_purposes
        such that x = W.Purpose.AgriculturalLabor)

declaration domestic_purpose_hits content list of W.Purpose
  depends on world content W.World, e content W.Entity
  equals
    (list of x among (purposes_of of world, e)
     such that x = W.Purpose.DomesticService)
    ++ (list of x among world.universal_purposes
        such that x = W.Purpose.DomesticService)

declaration cash_ways_of content integer
  depends on world content W.World, e content W.Entity
  equals
    match (event_named of world, e) with pattern
    -- Absent: 1
    -- Present content ev: cash_ways of ev

declaration scope Employer:
  input world content W.World
  input injections content list of W.Injection
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input child_in_law_of content list of K.Kinship
  input parent_in_law_of content list of K.Kinship
  input sibling_in_law_of content list of K.Kinship
  input agri_employers content list of AgriYear
  input person content W.Entity
  input caly content integer
  ## s3306_a_1/2
  output holds_1 content boolean
  ## s3306_a_2/2
  output holds_2 content boolean
  ## s3306_a_3/4
  output holds_3 content boolean
  ## s3306_a/2
  output holds content boolean
```

```catala
scope Employer:
  definition holds_1 equals
    (output of EmployerWages with {
       -- world: world -- injections: injections
       -- child_of: child_of -- sibling_of: sibling_of
       -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
       -- child_in_law_of: child_in_law_of
       -- parent_in_law_of: parent_in_law_of
       -- sibling_in_law_of: sibling_in_law_of
       -- agri_employers: agri_employers
       -- person: person -- caly: caly }).holds_1_A
    or (output of EmployerDays with {
          -- world: world -- injections: injections
          -- child_of: child_of -- sibling_of: sibling_of
          -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
          -- employer: person -- caly: caly }).holds_general

  definition holds_2 equals
    (output of EmployerWages with {
       -- world: world -- injections: injections
       -- child_of: child_of -- sibling_of: sibling_of
       -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
       -- child_in_law_of: child_in_law_of
       -- parent_in_law_of: parent_in_law_of
       -- sibling_in_law_of: sibling_in_law_of
       -- agri_employers: agri_employers
       -- person: person -- caly: caly }).holds_2_A
    or (output of EmployerDays with {
          -- world: world -- injections: injections
          -- child_of: child_of -- sibling_of: sibling_of
          -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
          -- employer: person -- caly: caly }).holds_agricultural

  definition holds_3 equals
    (output of EmployerWages with {
       -- world: world -- injections: injections
       -- child_of: child_of -- sibling_of: sibling_of
       -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
       -- child_in_law_of: child_in_law_of
       -- parent_in_law_of: parent_in_law_of
       -- sibling_in_law_of: sibling_in_law_of
       -- agri_employers: agri_employers
       -- person: person -- caly: caly }).holds_3

  # `s3306_a/2` granted by the case, as the two §3301 cases do — and a grant
  # made without `discontiguous` replaces the three paragraphs outright, so
  # nobody the rows do not name is an employer at all. See D73.
  definition holds equals
    (not (W.pred_overridden of injections, P.pred_s3306_a_2))
    and (holds_1 or holds_2 or holds_3)

  exception definition holds
    under condition
      W.injected_holds of injections, P.pred_s3306_a_2,
        [person.id; W.num_key of caly]
    consequence equals true
```

## The (a)(2)(B) table

`s3306_c_1_A_ii` is `s3306_a_2_B`, and every scope that reaches (c) therefore
needs to know which employers satisfy (a)(2)(B) in which year. Computing that
here, once, and threading it in as `agri_employers` is what keeps the module a
DAG — see "Cutting the two cycles".

The candidate employers are exactly those named in an injected `s3306_c/5`
row. That is not a shortcut: (a)(2)(B) counts days, `s3306_c` reads its
`Workday` argument and never binds it, and the generator that feeds the count
calls it with the workday unbound. So a day can only ever come from a case that
injects a clause for `s3306_c/5`, and only the employers in those rows can
qualify.

```catala-metadata
declaration scope AgriEmployerYears:
  input world content W.World
  input injections content list of W.Injection
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input taxable_year content integer
  ## The years any caller can ask about: the one named, and the year of every
  ## date the world mentions.
  output years content list of integer
  output candidates content list of W.Entity
  output pairs content list of AgriYear
```

```catala
scope AgriEmployerYears:
  definition years equals
    dedup_ints of
      ([taxable_year]
       ++ (map each d among
             (flatten_dates of
               (map each ev among world.events to (ev.starts ++ ev.ends)))
           to (Date.get_year of d))
       ++ (map each e among
             (injected_employment of injections, Absent, Absent, Absent,
                Absent, Absent)
           to (match e.workday with pattern
               -- Present content d: Date.get_year of d
               -- Absent: taxable_year)))

  definition candidates equals
    dedup_entities of
      (map each e among
        (injected_employment of injections, Absent, Absent, Absent, Absent, Absent)
       to e.employer)

  definition pairs equals
    flatten_agri_year of
      (map each p among candidates
       to (map each y among
             (list of y among years such that
                (output of EmployerDays with {
                   -- world: world -- injections: injections
                   -- child_of: child_of -- sibling_of: sibling_of
                   -- descendent_of: descendent_of
                   -- stepsibling_of: stepsibling_of
                   -- employer: p -- caly: y }).holds_agricultural)
           to AgriYear { -- employer: p -- caly: y }))
```

```catala-metadata
declaration flatten_agri_year content list of AgriYear
  depends on nested content list of list of AgriYear
  equals combine all inner among nested in acc initially [] with acc ++ inner
```

## §3301. Rate of tax

```catala-metadata
## `total_wages_employer/6`: the individuals an employer paid over a window,
## each one's wages summed and then capped at $7,000 by §3306(b)(1), and the
## capped totals added.
declaration structure IndividualWage:
  data individual content W.Entity
  data total content money

declaration scope TotalWages:
  input world content W.World
  input injections content list of W.Injection
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input child_in_law_of content list of K.Kinship
  input parent_in_law_of content list of K.Kinship
  input sibling_in_law_of content list of K.Kinship
  input agri_employers content list of AgriYear
  input employer content W.Entity
  input caly content integer
  ## The `(Individual, Wages, Service)` triples, in order.
  output rows content list of AgriRow
  output individuals content list of W.Entity
  output services content list of W.Entity
  output capped content list of IndividualWage
  output total content money
  ## Did the goal succeed at all? An injected grant answers this directly.
  output holds content boolean

declaration scope UnemploymentTax:
  input world content W.World
  input injections content list of W.Injection
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input child_in_law_of content list of K.Kinship
  input parent_in_law_of content list of K.Kinship
  input sibling_in_law_of content list of K.Kinship
  input employer content W.Entity
  input caly content integer
  ## s3306_a/2 — is this person an employer at all?
  output is_employer content boolean
  output wages content money
  ## `Tax is round(0.06*Wages)` — s3301/6
  output tax content money
  output holds content boolean
```

```catala
scope TotalWages:
  definition rows equals
    flatten_agri of
      (map each r among
        (output of Wages with {
           -- world: world -- injections: injections
           -- child_of: child_of -- sibling_of: sibling_of
           -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
           -- child_in_law_of: child_in_law_of
           -- parent_in_law_of: parent_in_law_of
           -- sibling_in_law_of: sibling_in_law_of
           -- agri_employers: agri_employers
           -- remuneration: Absent -- employment: Absent
           # `s3306_b(Wages,Rem,Service,Employer,Individual,Employer,_,_)`:
           # the payer and the employer are the same person.
           -- payer: Present content employer -- payee: Absent
           -- employer: Present content employer -- employee: Absent }).rows
       to (map each t among (dates_in_year of
                               (starts_for of world, r.remuneration), caly)
           to AgriRow { -- amount: r.wages -- employee: r.payee
                        -- service: r.employment }))

  definition individuals equals dedup_entities of (map each r among rows to r.employee)

  definition services equals map each r among rows to r.service

  definition capped equals
    map each ind among individuals
    to IndividualWage {
         -- individual: ind
         -- total:
              Money.min of $7,000,
                (Money.sum of
                  (map each r among
                    (list of x among rows such that x.employee.id = ind.id)
                   to r.amount)) }

  definition total equals Money.sum of (map each c among capped to c.total)

  definition holds equals true

  ## `total_wages_employer/6` granted by the case, which is how both §3301
  ## cases supply their figure. The window is the whole calendar year.
  exception definition total
    under condition
      W.injected_holds of injections, P.pred_total_wages_employer_6,
        [employer.id; -1; -1; -1;
         (date_key_of of (Present content (W.first_day_year of caly)));
         (date_key_of of (Present content (W.last_day_year of caly)))]
    consequence equals
      (match (W.injected_money of injections, P.pred_total_wages_employer_6,
                [employer.id; -1; -1; -1;
                 (date_key_of of (Present content (W.first_day_year of caly)));
                 (date_key_of of (Present content (W.last_day_year of caly)))],
                2) with pattern
       -- Absent: $0
       -- Present content m: m)

scope UnemploymentTax:
  definition is_employer equals
    (output of Employer with {
       -- world: world -- injections: injections
       -- child_of: child_of -- sibling_of: sibling_of
       -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
       -- child_in_law_of: child_in_law_of
       -- parent_in_law_of: parent_in_law_of
       -- sibling_in_law_of: sibling_in_law_of
       -- agri_employers:
            (output of AgriEmployerYears with {
               -- world: world -- injections: injections
               -- child_of: child_of -- sibling_of: sibling_of
               -- descendent_of: descendent_of
               -- stepsibling_of: stepsibling_of
               -- taxable_year: caly }).pairs
       -- person: employer -- caly: caly }).holds

  definition wages equals
    (output of TotalWages with {
       -- world: world -- injections: injections
       -- child_of: child_of -- sibling_of: sibling_of
       -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
       -- child_in_law_of: child_in_law_of
       -- parent_in_law_of: parent_in_law_of
       -- sibling_in_law_of: sibling_in_law_of
       -- agri_employers:
            (output of AgriEmployerYears with {
               -- world: world -- injections: injections
               -- child_of: child_of -- sibling_of: sibling_of
               -- descendent_of: descendent_of
               -- stepsibling_of: stepsibling_of
               -- taxable_year: caly }).pairs
       -- employer: employer -- caly: caly }).total

  definition tax equals money of (round of (decimal of (wages * 0.06)))

  definition holds equals is_employer
```
