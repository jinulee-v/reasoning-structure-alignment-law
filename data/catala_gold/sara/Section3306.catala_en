## Typed projections used when a Prolog rule names a role subject by id.  The
## old port rebuilt one universal event table here, forcing every category into
## every query.  A service id can now inspect only service records (and the
## the compatible payment category); payments and plans are equally narrow.

declaration service_ids content list of W.Entity
  depends on world content W.World
  equals (map each ev among (W.service_event_values of world) to ev.ident)
    ++ (map each ev among (W.payment_event_values of world) to ev.ident)
    ++ (map each fact among world.agent_facts to fact.subject)
    ++ (map each fact among world.patient_facts to fact.subject)
    ++ (map each fact among world.place_facts to fact.subject)
    ++ (map each fact among world.purpose_facts to fact.subject)
    ++ (map each fact among world.type_facts to fact.subject)

declaration service_agents content list of W.Entity
  depends on world content W.World, subject content W.Entity
  equals
    (flatten_entities of
      (map each ev among
        (list of ev among (W.service_event_values of world)
         such that ev.ident.id = subject.id)
       to ev.agents))
    ++ (flatten_entities of
      (map each ev among
        (list of ev among (W.payment_event_values of world)
         such that ev.ident.id = subject.id)
       to ev.agents))
    ++ (fact_agents of world, subject)

declaration service_patients content list of W.Entity
  depends on world content W.World, subject content W.Entity
  equals
    (flatten_entities of
      (map each ev among
        (list of ev among (W.service_event_values of world)
         such that ev.ident.id = subject.id)
       to ev.patients))
    ++ (flatten_entities of
      (map each ev among
        (list of ev among (W.payment_event_values of world)
         such that ev.ident.id = subject.id)
       to ev.patients))
    ++ (fact_patients of world, subject)

declaration service_places content list of W.Place
  depends on world content W.World, subject content W.Entity
  equals
    (combine all xs among
      (map each ev among
        (list of ev among (W.service_event_values of world)
         such that ev.ident.id = subject.id)
       to ev.places)
     in acc initially [] with acc ++ xs)
    ++ (fact_places of world, subject)

declaration service_purposes content list of W.Purpose
  depends on world content W.World, subject content W.Entity
  equals
    (combine all xs among
      (map each ev among
        (list of ev among (W.service_event_values of world)
         such that ev.ident.id = subject.id)
       to (W.purpose_values of ev.purposes))
     in acc initially [] with acc ++ xs)
    ++ (combine all xs among
      (map each ev among
        (list of ev among (W.payment_event_values of world)
         such that ev.ident.id = subject.id)
       to (W.purpose_values of ev.purposes))
     in acc initially [] with acc ++ xs)
    ++ (fact_purposes of world, subject)

declaration service_types content list of W.Purpose
  depends on world content W.World, subject content W.Entity
  equals
    (combine all xs among
      (map each ev among
        (list of ev among (W.service_event_values of world)
         such that ev.ident.id = subject.id)
       to (W.purpose_values of ev.types))
     in acc initially [] with acc ++ xs)
    ++ (fact_types of world, subject)

declaration payment_ids content list of W.Entity
  depends on world content W.World
  equals (map each ev among (W.payment_event_values of world) to ev.ident)
    ++ (map each ev among (W.service_event_values of world) to ev.ident)
    ++ (map each fact among world.agent_facts to fact.subject)
