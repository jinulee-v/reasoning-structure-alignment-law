scope UnemploymentTaxCalculation:
  definition wage_rows.sibling_in_law_of equals sibling_in_law_of

scope UnemploymentTaxCalculation:
  definition wage_rows.agri_employers equals agri_employer_years.pairs

scope UnemploymentTaxCalculation:
  definition wage_rows.remuneration equals Absent

scope UnemploymentTaxCalculation:
  definition wage_rows.employment equals Absent

scope UnemploymentTaxCalculation:
  definition wage_rows.payer equals Present content employer

scope UnemploymentTaxCalculation:
  definition wage_rows.payee equals Absent

scope UnemploymentTaxCalculation:
  definition wage_rows.employer equals Absent

scope UnemploymentTaxCalculation:
  definition wage_rows.employee equals Absent

scope UnemploymentTaxCalculation:
  definition employer_days.world equals world

scope UnemploymentTaxCalculation:
  definition employer_days.injections equals injections

scope UnemploymentTaxCalculation:
  definition employer_days.child_of equals child_of

scope UnemploymentTaxCalculation:
  definition employer_days.sibling_of equals sibling_of

scope UnemploymentTaxCalculation:
  definition employer_days.descendent_of equals descendent_of

scope UnemploymentTaxCalculation:
  definition employer_days.stepsibling_of equals stepsibling_of

scope UnemploymentTaxCalculation:
  definition employer_days.employer equals employer

scope UnemploymentTaxCalculation:
  definition employer_days.caly equals caly

scope UnemploymentTaxCalculation:
  definition is_employer equals
    # Check the explicit conclusion first. Besides matching Prolog's added
    # clause directly, this lets a symbolic run avoid expanding every
    # wage/day derivation merely to establish that the employer predicate
    # holds.
    if (W.injected_holds of (W.injections_for_2_12 of injections, P.pred_s3306_a_2, employer.id, W.num_key of caly))
    then true
    else
      (not (W.pred_overridden of injections, P.pred_s3306_a_2))
      and (((general_wages_total of world, wage_rows.rows, caly) >= $1,500)
           or employer_days.holds_general
           or ((agricultural_wages_total of world, wage_rows.rows, caly) >= $20,000)
           or employer_days.holds_agricultural
           or ((domestic_wages_total of world, wage_rows.rows, caly) >= $1,000))

scope UnemploymentTaxCalculation:
  definition wage_grant equals
    W.injected_money_result of
      (W.injections_for_6_156 of injections, P.pred_total_wages_employer_6,
         employer.id,
         (date_key_of of (Present content (W.first_day_year of caly))),
         (date_key_of of (Present content (W.last_day_year of caly)))), 2

scope UnemploymentTaxCalculation:
  definition wages equals
    if wage_grant.holds
    then
      (match wage_grant.amount with pattern
       -- Absent: $0
       -- Present content m: m)
    else total_wages_amount of world, wage_rows.rows, employer, caly

scope UnemploymentTaxCalculation:
  definition tax equals S3301.unemployment_tax of wages

scope UnemploymentTaxCalculation:
  definition holds equals is_employer

scope UnemploymentTaxCalculation:
  definition applicable_tax equals if holds then tax else $0

scope UnemploymentTax:
  definition result equals
    if not (has_unemployment_evidence of world, injections)
    then UnemploymentTaxResult {
           -- is_employer: false
           -- wages: $0
           -- tax: $0
           -- holds: false
           -- applicable_tax: $0 }
    else
      (let calculation equals
         (output of UnemploymentTaxCalculation with {
            -- world: world -- injections: injections
            -- child_of: child_of -- sibling_of: sibling_of
            -- descendent_of: descendent_of
            -- stepsibling_of: stepsibling_of
            -- child_in_law_of: child_in_law_of
            -- parent_in_law_of: parent_in_law_of
            -- sibling_in_law_of: sibling_in_law_of
            -- employer: employer -- caly: caly }) in
       UnemploymentTaxResult {
         -- is_employer: calculation.is_employer
         -- wages: calculation.wages
         -- tax: calculation.tax
         -- holds: calculation.holds
         -- applicable_tax: calculation.applicable_tax })

scope UnemploymentTax:
  definition is_employer equals result.is_employer

scope UnemploymentTax:
  definition wages equals result.wages

scope UnemploymentTax:
  definition tax equals result.tax

scope UnemploymentTax:
  definition holds equals result.holds

scope UnemploymentTax:
  definition applicable_tax equals result.applicable_tax

```

§3306. Definitions

(a) Employer

    (1) In general

    The term "employer" means, with respect to any calendar year, any person who-


<!-- rtdf-block-id: sara/section3306:b0003; role: provision; provision-id: sara/section3306(a)(1); source-lines: 5-7; relation: formalizes-preceding -->
```catala
scope Employer:
  definition holds_1 equals
    employer_wages.holds_1_A
    or employer_days.holds_general
```

        (A) during the calendar year or the preceding calendar year paid wages of $1,500 or more, or


<!-- rtdf-block-id: sara/section3306:b0004; role: provision; provision-id: sara/section3306(a)(1)(A); source-lines: 9-9; relation: formalizes-preceding -->
```catala
scope EmployerWages:
  definition holds_1_A equals general_total >= $1,500
```

        (B) on each of some 10 days during the calendar year or during the preceding calendar year, each day being in a different calendar week, employed at least one individual in employment for some portion of the day.


<!-- rtdf-block-id: sara/section3306:b0005; role: provision; provision-id: sara/section3306(a)(1)(B); source-lines: 11-11; relation: formalizes-preceding -->
```catala
scope GeneralDays:
  definition days equals
    map each e among
      (list of x among
        employment_solutions
       such that
         (match x.workday with pattern -- Absent: false -- Present content d: true)
         and not ((is_agricultural_id of world, x.service)
                  or (is_domestic_id of world, x.service)))
    to (match e.workday with pattern
        -- Present content d: d
        -- Absent: |0001-01-01|)

scope GeneralDays:
  definition employees equals
    map each e among
      (list of x among
        employment_solutions
       such that
         (match x.workday with pattern -- Absent: false -- Present content d: true)
         and not ((is_agricultural_id of world, x.service)
                  or (is_domestic_id of world, x.service)))
    to e.employee

scope EmployerDays:

scope EmployerDays:
  definition workdays equals
    list of d among
      general_days.days
    such that (W.first_day_year of (caly - 1)) <= d and d <= (W.last_day_year of caly)

scope EmployerDays:
  definition employees equals
    general_days.employees

scope EmployerDays:
  definition holds_general equals
    (number of (dedup_dates of workdays)) >= 10
    and (number of (dedup_ints of (map each d among workdays to (week_of of d)))) >= 10

```

```catala-metadata
declaration scope GeneralDays:
  input world content W.World
  input injections content list of W.Injection
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input employer content W.Entity
  employment_lower scope EmploymentLower
  ## Shared with EmployerDays' agricultural-day filtering. Keeping the raw
  ## rows here prevents three identical EmploymentLower evaluations.
  output employment_solutions content list of Emp
  output days content list of date
  output employees content list of W.Entity

## s3306_a_2_is_day_of_employment/4 — five or more individuals in agricultural
## labor on one day.

declaration scope AgriDay:
  input world content W.World
  input injections content list of W.Injection
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input employer content W.Entity
  input at content date
  output individuals content list of W.Entity
  output holds content boolean

declaration scope EmployerDays:
  input world content W.World
  input injections content list of W.Injection
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input employer content W.Entity
  input caly content integer
  general_days scope GeneralDays
  ## The candidate days, before the ten-day and ten-week tests.
  output workdays content list of date
  output employees content list of W.Entity
  ## s3306_a_1_B/4
  output holds_general content boolean
  ## s3306_a_2_B/6 — the agricultural variant, five individuals a day
  output agri_workdays content list of date
  output holds_agricultural content boolean
```



    For purposes of this paragraph, there shall not be taken into account any wages paid to, or employment of, an employee performing domestic services referred to in paragraph (3).


<!-- rtdf-block-id: sara/section3306:b0006; role: provision; provision-id: sara/section3306(a)(1):flush; source-lines: 13-13; relation: formalizes-preceding -->
```catala
# This is continuation prose; its legal effect is implemented in the preceding provision block.
```

    (2) Agricultural labor

    In the case of agricultural labor, the term "employer" means, with respect to any calendar year, any person who-


<!-- rtdf-block-id: sara/section3306:b0007; role: provision; provision-id: sara/section3306(a)(2); source-lines: 15-17; relation: formalizes-preceding -->
```catala
scope Employer:
  definition holds_2 equals
    employer_wages.holds_2_A
    or employer_days.holds_agricultural
```

        (A) during the calendar year or the preceding calendar year paid wages of $20,000 or more for agricultural labor, or


<!-- rtdf-block-id: sara/section3306:b0008; role: provision; provision-id: sara/section3306(a)(2)(A); source-lines: 19-19; relation: formalizes-preceding -->
```catala
scope EmployerWages:
  definition holds_2_A equals agri_total >= $20,000
```

        (B) on each of some 10 days during the calendar year or during the preceding calendar year, each day being in a different calendar week, employed at least 5 individuals in employment in agricultural labor for some portion of the day.


<!-- rtdf-block-id: sara/section3306:b0009; role: provision; provision-id: sara/section3306(a)(2)(B); source-lines: 21-21; relation: formalizes-preceding -->
```catala
scope AgriDay:
  definition individuals equals
    dedup_entities of
      (map each e among
        (list of x among
          (output of EmploymentLower with {
             -- world: world -- injections: injections
             -- child_of: child_of -- sibling_of: sibling_of
             -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
             -- service: Absent -- employer: Present content employer
             -- employee: Absent -- workday: Present content at
             -- caly: Absent }).solutions
         such that is_agricultural_id of world, x.service)
       to e.employee)

scope AgriDay:
  definition holds equals (number of individuals) >= 5

scope EmployerDays:
  definition agri_workdays equals
    list of d among
      (dedup_dates of
        (map each e among
          (list of x among general_days.employment_solutions
           such that
             (match x.workday with pattern
              -- Absent: false
              -- Present content d: true))
         to (match e.workday with pattern
             -- Present content d: d
             -- Absent: |0001-01-01|)))
    such that
      (W.first_day_year of (caly - 1)) <= d and d <= (W.last_day_year of caly)
      and (output of AgriDay with {
             -- world: world -- injections: injections
             -- child_of: child_of -- sibling_of: sibling_of
             -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
             -- employer: employer -- at: d }).holds

scope EmployerDays:
  definition holds_agricultural equals
    (number of agri_workdays) >= 10
    and (number of (dedup_ints of
          (map each d among agri_workdays to (week_of of d)))) >= 10
```

    (3) Domestic service

    In the case of domestic service in a private home, local college club, or local chapter of a college fraternity or sorority, the term "employer" means, with respect to any calendar year, any person who during the calendar year or the preceding calendar year paid wages in cash of $1,000 or more for such service.


<!-- rtdf-block-id: sara/section3306:b0010; role: provision; provision-id: sara/section3306(a)(3); source-lines: 23-25; relation: formalizes-preceding -->
```catala
scope EmployerWages:
  definition holds_3 equals domestic_total >= $1,000

scope Employer:
  definition holds_3 equals employer_wages.holds_3
```

    (4) Special rule

    A person treated as an employer under paragraph (3) shall not be treated as an employer with respect to wages paid for any service other than domestic service referred to in paragraph (3) unless such person is treated as an employer under paragraph (1) or (2) with respect to such other service.


<!-- rtdf-block-id: sara/section3306:b0011; role: provision; provision-id: sara/section3306(a)(4); source-lines: 27-29; relation: formalizes-preceding -->
```catala
# This structural heading introduces no rule independently of its immediately following subprovisions.
```

(b) Wages

For purposes of this chapter, the term "wages" means all remuneration for employment, including the cash value of all remuneration (including benefits) paid in any medium other than cash; except that such term shall not include-


<!-- rtdf-block-id: sara/section3306:b0012; role: provision; provision-id: sara/section3306(b); source-lines: 31-33; relation: formalizes-preceding -->
```catala
scope Wages:
  definition employment_ways equals
    map each emp among (W.service_event_values of world)
    to ServiceYear {
         -- service: emp.ident
         -- ways:
              Integer.sum of
                (map each endd among (W.date_values of emp.ends)
                 to (Integer.sum of
                      (map each e among
                        (output of Employment with {
                         -- world: world -- injections: injections
                         -- child_of: child_of -- sibling_of: sibling_of
                         -- descendent_of: descendent_of
                         -- stepsibling_of: stepsibling_of
                         -- agri_employers: agri_employers
                         -- service: Present content emp.ident
                         -- employer: Absent -- employee: Absent
                         -- workday: Absent
                         -- caly: Present content (Date.get_year of endd)
                       }).solutions
                       to e.multiplicity))) }

  # The Prolog's conjunction, in its order. `purpose_(Remuneration,Employment)`
  # drives the search for the service rather than being checked after one: the
  # multiset is the same, since event ids are unique, and it turns a quadratic
  # scan into a linear one.

scope Wages:
  definition raw_rows equals
    flatten_wage of
      (map each rem among
        (list of e among (W.payment_event_values of world)
         such that (ent_ok of remuneration, e.ident))
       to (flatten_wage of
            (map each pyr among (weighted_ent_hits of payer, rem.agents)
             to (flatten_wage of
                  (map each pr among
                    (list of x among (payee_rows of world, rem)
                     such that ent_ok of payee, x.payee)
                   to (flatten_wage of
                        (map each emp among
                          (list of e among
                             (employment_events_for_payment of world, rem)
                           such that ent_ok of employment, e.ident)
                         to (flatten_wage of
                              (map each ee among (ent_hits of employee, emp.agents)
                               to (flatten_wage of
                                    (map each er among
                                      (ent_hits of employer, emp.patients)
                                     to (map each amt among rem.amounts
                                         to WageRow {
                                              -- wages: wage_base_cap of amt
                                              -- remuneration: rem.ident
                                              -- employment: emp.ident
                                              -- payer: pyr.entity
                                              -- payee: pr.payee
                                              -- employer: er
                                              -- employee: ee
                                              -- multiplicity:
                                                   pyr.multiplicity
                                                   * (ways_of of employment_ways, emp.ident)
                                                   * (medium_ways of rem) }))))))))))))

scope Wages:
  definition rows equals
    if not rows_available then
      injected_wages of injections, remuneration, employment, payer, payee,
        employer, employee
    else
      (list of r among raw_rows such that
         r.multiplicity > 0
         and not (output of ExcludedPlanPayment with {
              -- world: world -- injections: injections
              -- child_of: child_of -- sibling_of: sibling_of
              -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
              -- remuneration: Present content r.remuneration
              -- service: Present content r.employment
              -- employer: Present content r.payer
              -- employee: Present content r.payee
              -- plan: Absent }).legal_holds
       and not (output of ExcludedNonCashOutsideBusiness with {
                  -- world: world -- injections: injections
                  -- child_of: child_of -- sibling_of: sibling_of
                  -- descendent_of: descendent_of
                  -- stepsibling_of: stepsibling_of
                  -- remuneration: Present content r.remuneration
                  -- service: Present content r.employment
                  -- employer: Present content r.payer
                  -- employee: Present content r.payee }).legal_holds
       and not (output of ExcludedDeathBenefit with {
                  -- world: world -- injections: injections
                  -- child_of: child_of -- sibling_of: sibling_of
                  -- descendent_of: descendent_of
                  -- stepsibling_of: stepsibling_of
                  -- child_in_law_of: child_in_law_of
                  -- parent_in_law_of: parent_in_law_of
                  -- sibling_in_law_of: sibling_in_law_of
                  -- remuneration: Present content r.remuneration
                  -- service: Present content r.employment
                  -- employer: Present content r.payer
                  -- employee: Present content r.payee
                  -- payee: Present content r.payee
                  -- plan: Absent }).legal_holds
       and not (output of ExcludedAgriculturalInKind with {
                  -- world: world
                  -- remuneration: Present content r.remuneration
                  -- service: Present content r.employment }).legal_holds
       and not (output of ExcludedSurvivorPayment with {
                  -- world: world -- injections: injections
                  -- child_of: child_of -- sibling_of: sibling_of
                  -- descendent_of: descendent_of
                  -- stepsibling_of: stepsibling_of
                  -- remuneration: Present content r.remuneration
                  -- employer: Present content r.employer
                  -- payee: Present content r.payee
                  -- employee: Present content r.employee }).legal_holds)
      ++ (injected_wages of injections, remuneration, employment, payer, payee,
            employer, employee)

  # A case that grants `s3306_b/8` without declaring the predicate
  # discontiguous has replaced (b) outright: the derived rows are gone and only
  # the granted ones are wages. See D69.

scope Wages:
  definition rows_available equals
    not (W.pred_overridden of injections, P.pred_s3306_b_8)

scope Wages:
  definition holds equals (number of rows) > 0
```

```catala-metadata
declaration structure WageRow:
  data wages content money
  data remuneration content W.Entity
  data employment content W.Entity
  data payer content W.Entity
  data payee content W.Entity
  data employer content W.Entity
  data employee content W.Entity
  data multiplicity content integer

declaration flatten_wage content list of WageRow
  depends on nested content list of list of WageRow
  equals combine all inner among nested in acc initially [] with acc ++ inner

## `((\+ means_(R,_)) ; means_(R,Medium))` with `Medium` unbound: one solution
## when the payment names no medium, otherwise one per medium named.

declaration medium_ways content integer
  depends on r content W.PaymentEvent
  equals if (number of r.media) = 0 then 1 else (number of r.media)

## A payment names its service through its single purpose.  Resolve that
## functional link once instead of forming a payment-by-purpose-by-service
## Cartesian product and constraining it afterwards.

declaration employment_events_for_payment content list of W.ServiceEvent
  depends on world content W.World, payment content W.PaymentEvent
  equals
    match payment.purposes with pattern
    -- Absent: []
    -- Present content purpose:
        (match purpose with pattern
         -- PurposeEntity content service:
             list of ev among (W.service_event_values of world)
             such that ev.ident.id = service.id
         -- AgriculturalLabor: []
         -- DomesticService: []
         -- ProvisionSickness: []
         -- ProvisionAccidentDisability: []
         -- ProvisionDeath: []
         -- ProvisionEmployeesOrDependents: []
         -- OtherPurpose: [])

declaration is_plan content boolean
  depends on world content W.World, e content W.Entity
  equals
    exists ev among (W.plan_event_values of world) such that ev.ident.id = e.id

declaration beneficiaries_of content list of W.Entity
  depends on world content W.World, e content W.Entity
  equals
    plan_beneficiaries of world, e

## `(patient_(R,Payee), \+ plan_(Payee)) ; (patient_(R,Plan), plan_(Plan),
## beneficiary_(Plan,Payee))` -- a payment made to somebody, or into a plan
## somebody benefits from.

declaration structure PayeeRow:
  data payee content W.Entity
  data plan content optional of W.Entity

declaration flatten_payee content list of PayeeRow
  depends on nested content list of list of PayeeRow
  equals combine all inner among nested in acc initially [] with acc ++ inner

declaration payee_rows content list of PayeeRow
  depends on world content W.World, r content W.PaymentEvent
  equals
    (map each q among (list of x among r.patients such that not (is_plan of world, x))
     to PayeeRow { -- payee: q -- plan: Absent })
    ++ (flatten_payee of
         (map each pl among (list of x among r.patients such that is_plan of world, x)
          to (map each b among (beneficiaries_of of world, pl)
              to PayeeRow { -- payee: b -- plan: Present content pl })))

## `end_(E,T)` for an event named by id rather than held in hand.

declaration ends_of content list of date
  depends on world content W.World, e content W.Entity
  equals
    (flatten_dates of
      (map each ev among
        (list of ev among (W.service_event_values of world)
         such that ev.ident.id = e.id)
       to (W.date_values of ev.ends)))
    ++ (fact_ends of world, e)

declaration structure ServiceYear:
  data service content W.Entity
  data ways content integer

declaration ways_of content integer
  depends on table content list of ServiceYear, target content W.Entity
  equals
    match (List.first_element of
             (list of r among table such that r.service.id = target.id)) with pattern
    -- Absent: 0
    -- Present content r: r.ways

## The rows a case grants outright. Eight cases assert `s3306_b/8` directly
## rather than supplying the payment and service it would be derived from.

declaration injected_wages content list of WageRow
  depends on injections content list of W.Injection,
             remuneration content optional of W.Entity,
             employment content optional of W.Entity,
             payer content optional of W.Entity,
             payee content optional of W.Entity,
             employer content optional of W.Entity,
             employee content optional of W.Entity
  equals
    map each inj among
      ((W.injections_for_8_234567 of injections, P.pred_s3306_b_8, (key_of of remuneration), (key_of of employment), (key_of of payer), (key_of of payee), (key_of of employer), (key_of of employee)))
    to WageRow {
      -- wages:
           (match (W.injection_num of inj, 1) with pattern
            -- Present content n: money of n
            -- Absent: $0)
      -- remuneration: ent_from of (W.injection_entity of inj, 2), remuneration
      -- employment: ent_from of (W.injection_entity of inj, 3), employment
      -- payer: ent_from of (W.injection_entity of inj, 4), payer
      -- payee: ent_from of (W.injection_entity of inj, 5), payee
      -- employer: ent_from of (W.injection_entity of inj, 6), employer
      -- employee: ent_from of (W.injection_entity of inj, 7), employee
      -- multiplicity: 1 }

declaration scope Wages:
  input world content W.World
  input injections content list of W.Injection
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input child_in_law_of content list of K.Kinship
  input parent_in_law_of content list of K.Kinship
  input sibling_in_law_of content list of K.Kinship
  input agri_employers content list of AgriYear
  input remuneration content optional of W.Entity
  input employment content optional of W.Entity
  input payer content optional of W.Entity
  input payee content optional of W.Entity
  input employer content optional of W.Entity
  input employee content optional of W.Entity
  ## `end_(E,T), s3306_c(E,_,_,_,year(T))` for every service in the world.
  output employment_ways content list of ServiceYear
  ## Before the five exclusions of (b)(2)–(b)(15).
  output raw_rows content list of WageRow
  ## One row per solution of `s3306_b/8`.
  output rows_available content boolean
  output rows content list of WageRow
  output holds content boolean
```



    (1) that part of the remuneration which, after remuneration (other than remuneration referred to in the succeeding paragraphs of this subsection) equal to $7,000 with respect to employment has been paid to an individual by an employer during any calendar year, is paid to such individual by such employer during such calendar year;


<!-- rtdf-block-id: sara/section3306:b0013; role: provision; provision-id: sara/section3306(b)(1); source-lines: 35-35; relation: formalizes-preceding -->
```catala
declaration wage_base_cap content money
  depends on remuneration content money
  equals Money.min of $7,000, remuneration
```

    (2) the amount of any payment (including any amount paid by an employer for insurance or annuities, or into a fund, to provide for any such payment) made to, or on behalf of, an employee or any of his dependents under a plan or system established by an employer which makes provision for his employees generally (or for his employees generally and their dependents) or for a class or classes of his employees (or for a class or classes of his employees and their dependents), on account of-


<!-- rtdf-block-id: sara/section3306:b0014; role: provision; provision-id: sara/section3306(b)(2); source-lines: 37-37; relation: formalizes-preceding -->
```catala
scope ExcludedPlanPayment:
  definition legal_holds equals holds

scope ExcludedPlanPayment:
  definition holds equals
    (output of EmploymentLower with {
       -- world: world -- injections: injections
       -- child_of: child_of -- sibling_of: sibling_of
       -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
       -- service: service -- employer: employer -- employee: employee
       -- workday: Absent -- caly: Absent }).holds
    and (exists rem among (W.payment_event_values of world) such that
           (ent_ok of remuneration, rem.ident)
           and (exists er among rem.agents such that ent_ok of employer, er)
           and (exists pl among (W.plan_event_values of world) such that
                  (ent_ok of plan, pl.ident)
                  and (let plan_purpose equals
                         (output of PlanPurpose with {
                            -- world: world
                            -- plan: Present content pl.ident }) in
                       plan_purpose.holds_a or plan_purpose.holds_c)
                  and (exists ben among pl.beneficiaries such that
                         # `Employee == Payee` -- the §152 alternative raises an
                         # instantiation error in SWI, because it calls
                         # `s152/3` with the taxable year unbound. See
                         # DEVIATIONS.md; it is unreachable in the corpus.
                         (ent_ok of employee, ben)
                         and ((rem.patients contains pl.ident)
                              or ((exists m among rem.media such that
                                     m = (W.Medium.MediumEntity content pl.ident))
                                  and (exists q among rem.patients such that
                                         q.id = ben.id))))))

scope ExcludedNonCashOutsideBusiness:
  # `s3306_c(Service,Employer,Employee,_,_)` binds the service and the employer,
  # and the two goals after it reuse both: `agent_(Employers_business,Employer)`
  # and `type_(Service,Type_service)`. Asking each against the query's own
  # arguments -- unbound in every case that reaches this -- let a business run
  # by one person be weighed against an employment held by another. Same shape
  # as D36; see D52.

scope ExcludedNonCashOutsideBusiness:
  definition holds equals
    exists emp among
      (output of EmploymentLower with {
         -- world: world -- injections: injections
         -- child_of: child_of -- sibling_of: sibling_of
         -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
         -- service: service -- employer: employer -- employee: employee
         -- workday: Absent -- caly: Absent }).solutions
    such that
      (exists rem among (payment_ids of world) such that
         (ent_ok of remuneration, rem)
         and (exists m among (payment_media of world, rem) such that m != W.Medium.Cash))
      and (exists biz among (W.business_event_values of world) such that
             biz.agents contains emp.employer
             and (exists bt among (W.purpose_values of biz.types) such that
                    exists st among (service_types of world, emp.service)
                    such that st != bt))

scope ExcludedTerminationPayment:

scope ExcludedTerminationPayment:
  definition holds equals
    exists rem among (payment_ids of world) such that
      (ent_ok of remuneration, rem)
      and (exists sr among (payment_starts of world, rem) such that
             exists term among (W.termination_event_values of world) such that
               (exists a among (W.entity_values of term.agents) such that ent_ok of employer, a)
               and (exists emp among (W.entity_values of term.patients) such that
                      (ent_ok of employment, emp)
                      and (exists st among
                             ((W.date_values of term.starts) ++ (ends_of of world, emp))
                           such that st <= sr))
               and (exists reason among (W.entity_values of term.reasons) such that
                      (exists rev among (W.disability_event_values of world) such that
                         rev.ident.id = reason.id
                         and (exists a among (W.entity_values of rev.agents) such that ent_ok of employee, a))
                      or (exists rev among (W.death_event_values of world) such that
                         rev.ident.id = reason.id
                         and (exists a among rev.agents such that ent_ok of employee, a))))

scope ExcludedTerminationPlan:

scope ExcludedTerminationPlan:
  definition holds equals
    exists rem among (payment_ids of world) such that
      (ent_ok of remuneration, rem)
      and (exists m among (payment_media of world, rem) such that
             match m with pattern
             -- Cash: false
             -- MediumEntity content pl:
                 (ent_ok of plan, pl)
                 and (exists ev among (W.plan_event_values of world) such that
                        ev.ident.id = pl.id
                        and (exists a among (W.entity_values of ev.agents) such that ent_ok of employer, a)
                        and (has_purpose of world, ev.purposes,
                               W.Purpose.ProvisionEmployeesOrDependents)))

scope ExcludedDeathBenefit:

scope ExcludedDeathBenefit:
  definition holds equals
    (output of EmploymentLower with {
       -- world: world -- injections: injections
       -- child_of: child_of -- sibling_of: sibling_of
       -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
       -- service: service -- employer: employer -- employee: employee
       -- workday: Absent -- caly: Absent }).holds
    and (exists rem among (payment_ids of world) such that
           (ent_ok of remuneration, rem)
           and (number of (payment_starts of world, rem)) > 0
           and (exists a among (payment_agents of world, rem) such that ent_ok of employer, a)
           and (exists q among (payment_patients of world, rem) such that
                  (ent_ok of payee, q)
                  and ((ent_ok of employee, q)
                       or (exists rd among (payment_starts of world, rem) such that
                             match employee with pattern
                             -- Absent: false
                             -- Present content ee:
                                 (output of S152.IsDependent with {
                                    -- injections: injections -- world: world
                                    -- dependant: ee -- taxpayer: q
                                    # the payee is bound from the remuneration
                                    # event before §152 is reached
                                    -- taxpayer_generated: false
                                    -- dependant_generated: false
                                    -- taxable_year: Date.get_year of rd
                                    -- child_of: child_of
                                    -- sibling_of: sibling_of
                                    -- descendent_of: descendent_of
                                    -- stepsibling_of: stepsibling_of
                                    -- stepparent_of: []
                                    -- child_in_law_of: child_in_law_of
                                    -- parent_in_law_of: parent_in_law_of
                                    -- sibling_in_law_of: sibling_in_law_of }).holds))))
    and (output of ExcludedTerminationPayment with {
           -- world: world -- remuneration: remuneration
           -- employment: service -- employee: employee
           -- employer: employer }).legal_holds
    and (output of ExcludedTerminationPlan with {
           -- world: world -- employer: employer
           -- remuneration: remuneration -- plan: plan }).legal_holds

scope ExcludedAgriculturalInKind:

scope ExcludedAgriculturalInKind:
  definition holds equals
    exists svc among (W.service_event_values of world) such that
      (ent_ok of service, svc.ident)
      and (has_purpose of world, svc.purposes, W.Purpose.AgriculturalLabor)
      and (exists er among svc.patients such that
             exists ee among svc.agents such that
               exists rem among (payment_ids of world) such that
                 (ent_ok of remuneration, rem)
                 and (payment_agents of world, rem) contains er
                 and (payment_patients of world, rem) contains ee
                 and (payment_purposes of world, rem) contains
                       (W.Purpose.PurposeEntity content svc.ident)
                 and (exists m among (payment_media of world, rem)
                      such that m != W.Medium.Cash))

scope ExcludedSurvivorPayment:
  # `s3306_c(_,Employer,Employee,_,_)` *binds* the employer and the employee,
  # and every later goal reuses those bindings: `agent_(Remuneration,Employer)`,
  # `agent_(Edeath,Employee)`, `agent_(Emar,Employee)`. Asking each of them
  # separately whether *some* agent fits the query's own (usually unbound)
  # employer and employee is a weaker question, and it let a remuneration paid
  # by one person count against an employment held by another. Iterating
  # `solutions` keeps one row's pair throughout, which is what the shared
  # variables mean. `holds` is `(number of solutions) > 0`, so the existential
  # subsumes the conjunct this replaced.

scope ExcludedSurvivorPayment:
  definition holds equals
    exists emp among
      (output of EmploymentLower with {
         -- world: world -- injections: injections
         -- child_of: child_of -- sibling_of: sibling_of
         -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
         -- service: Absent -- employer: employer -- employee: employee
         -- workday: Absent -- caly: Absent }).solutions
    such that
      (exists rem among (payment_ids of world) such that
         (ent_ok of remuneration, rem)
         and ((payment_agents of world, rem) contains emp.employer)
         # `patient_(Remuneration,Payee)` *binds* the payee and
         # `agent_(Emar,Payee)` reuses it: the person paid has to be the one
         # the employee was married to. Testing each against the query's own
         # payee -- unbound in every case that reaches this -- asked only that
         # the employee was married to somebody. See D63.
         and (exists q among (payment_patients of world, rem) such that
                (ent_ok of payee, q)
                and (exists sr among (payment_starts of world, rem) such that
                       exists death among (W.death_event_values of world) such that
                         (death.agents contains emp.employee)
                         and (exists td among (W.date_values of death.starts) such that
                                (exists mar among (W.marriage_event_values of world) such that
                                   (mar.agents contains emp.employee)
                                   and (exists b among mar.agents such that
                                          b.id = q.id)
                                   and ((number of (W.date_values of mar.ends)) = 0
                                        or (W.optional_date_equals of mar.ends, td)))
                                # `Year_remuneration @> Caly` compares the two
                                # year strings, which for four-digit years is
                                # the numeric comparison.
                                and (Date.get_year of sr)
                                      > (Date.get_year of td)))))
```

