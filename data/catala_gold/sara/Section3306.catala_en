    (1) agricultural labor unless-


<!-- rtdf-block-id: sara/section3306:b0027; role: provision; provision-id: sara/section3306(c)(1); source-lines: 65-65; relation: formalizes-preceding -->
```catala
scope AgriculturalExcluded:
  definition holds equals
    (exists eid among (service_ids of world) such that
       (ent_ok of service, eid)
       and (is_agricultural_id of world, eid))
    and not (subparagraph_a
             and (output of AgriculturalAlien with {
                    -- world: world -- service: service }).holds)

scope Employment:

scope Employment:
  definition effective_caly equals
    match workday with pattern
    -- Present content d: Present content (Date.get_year of d)
    -- Absent: caly

scope Employment:
  definition solutions equals
    (if (caly_conflict of workday, caly)
        # A grant made without `discontiguous` replaces (c) and the derived
        # solutions are gone. See D69.
        or (W.pred_overridden of injections, P.pred_s3306_c_5) then [] else
      (list of e among
         (output of DeclaredEmploymentCandidates with {
            -- world: world -- service: service
            -- employer: employer -- employee: employee }).every
       such that
         e.multiplicity > 0
         and (exists ev among (W.service_event_values of world) such that ev.ident.id = e.service.id)
         and not (output of AgriculturalExcluded with {
                    -- world: world -- service: Present content e.service
                    -- caly: effective_caly
                    -- agri_employers: agri_employers }).holds
         and not (output of Excluded with {
                    -- world: world -- injections: injections
                    -- child_of: child_of -- sibling_of: sibling_of
                    -- descendent_of: descendent_of
                    -- stepsibling_of: stepsibling_of
                    -- service: Present content e.service
                    -- employer: Present content e.employer
                    -- employee: Present content e.employee
                    -- workday: workday }).holds))
    ++ (injected_employment of injections, service, employer, employee,
          workday, caly)

scope Employment:
  definition holds equals (number of solutions) > 0
```

```catala-metadata
declaration caly_conflict content boolean
  depends on workday content optional of date, caly content optional of integer
  equals
    match workday with pattern
    -- Absent: false
    -- Present content d:
        (match caly with pattern
         -- Absent: false
         -- Present content y: y != (Date.get_year of d))

## An employer who satisfies (a)(2)(B) in a given calendar year. Threaded into
## (c)(1)(A)(ii) from outside so that (c) and (a)(2) stay a DAG.

declaration structure AgriYear:
  data employer content W.Entity
  data caly content integer

declaration scope AgriculturalExcluded:
  input world content W.World
  input service content optional of W.Entity
  input caly content optional of integer
  input agri_employers content list of AgriYear
  ## s3306_c_1_A/3
  output wage_exception content boolean
  output days_exception content boolean
  output subparagraph_a content boolean
  ## s3306_c_1/2
  output holds content boolean

declaration scope Employment:
  input world content W.World
  input injections content list of W.Injection
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input agri_employers content list of AgriYear
  input service content optional of W.Entity
  input employer content optional of W.Entity
  input employee content optional of W.Entity
  input workday content optional of date
  input caly content optional of integer
  output effective_caly content optional of integer
  ## s3306_c/5
  output solutions content list of Emp
  output holds content boolean
```



