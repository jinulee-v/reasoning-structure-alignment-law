scope Student:
  definition students equals
    dedup_entities of
      (flatten_entities of
        (map each en among
          (list of e among (W.enrollment_event_values of world)
           such that (open_at of (W.date_values of e.starts), (W.date_values of e.ends), workday))
         to (list of st among en.agents such that
               (ent_ok of student, st)
               # enrolled at the employer ...
               and (exists p among (W.entity_values of en.patients) such that ent_ok of employer, p)
               # ... and regularly attending classes there
               and (exists ac among (W.attending_classes_event_values of world) such that
                      (W.optional_entity_equals of ac.agents, st)
                      and (exists g among (W.place_values of ac.places) such that
                             (place_ok of g, employer)
                             and (exists p among (W.entity_values of en.patients) such that
                                    place_is of g, p))
                      and (open_at of (W.date_values of ac.starts), (W.date_values of ac.ends), workday)))))

# `s7703(Student,Spouse,Marriage,Year)` requires the reported marriage, not
# merely married status, because subparagraph (ii) checks its active window.

scope ExclStudent:
  definition holds_a equals
    exists eid among (service_ids of world) such that
      (ent_ok of service, eid)
      and (exists p among (service_patients of world, eid) such that
             (ent_ok of employer, p)
             and (exists ei among (W.educational_institution_event_values of world) such that
                    (W.optional_entity_equals of ei.agents, p))
             and (exists a among (service_agents of world, eid) such that
                    (ent_ok of employee, a)
                    and (exists st among
                           (output of Student with {
                              -- world: world -- student: Absent
                              -- employer: Present content p
                              -- workday: workday }).students
                         such that
                           st.id = a.id
                           or (output of StudentSpouse with {
                                 -- world: world -- injections: injections
                                 -- child_of: child_of
                                 -- sibling_of: sibling_of
                                 -- descendent_of: descendent_of
                                 -- stepsibling_of: stepsibling_of
                                 -- spouse: a -- student: st
                                 -- workday: workday }).holds)))

scope ExclStudent:
  definition holds equals holds_a or holds_b
```

