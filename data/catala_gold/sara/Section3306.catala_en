scope ExclInternationalOrganization:
  definition holds equals
    exists ev among (W.service_event_values of world) such that
      (ent_ok of service, ev.ident)
      and (exists p among ev.patients such that
             (ent_ok of employer, p)
             and (exists io among (W.international_organization_event_values of world) such that
                    (W.optional_entity_equals of io.agents, p)))
