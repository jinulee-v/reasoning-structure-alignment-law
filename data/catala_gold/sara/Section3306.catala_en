(c) Employment

For purposes of this chapter, the term "employment" means any service, of whatever nature,


<!-- rtdf-block-id: sara/section3306:b0024; role: provision; provision-id: sara/section3306(c); source-lines: 57-59; relation: formalizes-preceding -->
```catala
scope Excluded:
  definition holds equals
    domestic_excluded
    or (output of ExclFamily with {
          -- world: world -- child_of: child_of -- service: service
          -- agent: employee -- patient: employer
          -- workday: workday }).holds
    or (output of ExclUsGovernment with {
          -- world: world -- service: service }).holds
    or (output of ExclState with {
          -- world: world -- service: service -- employer: Absent }).holds
    or (output of ExclStudent with {
          -- world: world -- injections: injections
          -- child_of: child_of -- sibling_of: sibling_of
          -- descendent_of: descendent_of -- stepsibling_of: stepsibling_of
          -- service: service -- employer: employer -- employee: employee
          -- workday: workday }).holds
    or (output of ExclForeignGovernment with {
          -- world: world -- service: service -- employer: employer }).holds
    or (output of ExclStudentNurse with {
          -- world: world -- service: service -- employer: employer
          -- employee: employee -- workday: workday }).holds
    or (output of ExclInternationalOrganization with {
          -- world: world -- service: service -- employer: employer }).holds
    or (output of ExclPenalInstitution with {
          -- world: world -- service: service -- employee: employee
          -- workday: workday }).holds

scope EmploymentCandidates:
  definition every equals
    (list of e among from_a such that e.multiplicity > 0)
    ++ (list of e among from_b such that e.multiplicity > 0)

scope DeclaredEmploymentCandidates:
  definition every equals
    (list of e among
       (employment_from_a of world, service_role_events, employer, employee)
     such that e.multiplicity > 0)
    ++ (list of e among
          (employment_from_b of world, service_role_events, employer, employee)
        such that e.multiplicity > 0)

scope EmploymentCandidates:
  definition holds_a equals
    exists e among from_a such that e.multiplicity > 0

scope EmploymentCandidates:
  definition holds_b equals
    exists e among from_b such that e.multiplicity > 0

scope EmploymentLower:

scope EmploymentLower:
  definition effective_caly equals
    match workday with pattern
    -- Present content d: Present content (Date.get_year of d)
    -- Absent: caly

scope EmploymentLower:
  definition solutions equals
    (if (caly_conflict of workday, caly)
        # A grant made without `discontiguous` replaces (c) and the derived
        # solutions are gone. See D69.
        or (W.pred_overridden of injections, P.pred_s3306_c_5) then [] else
      (list of e among
         (output of DeclaredEmploymentCandidates with {
            -- world: world -- service: service
            -- employer: employer -- employee: employee }).every
       such that
         e.multiplicity > 0
         and (exists ev among (W.service_event_values of world) such that ev.ident.id = e.service.id)
         and not (output of AgriculturalExcluded with {
                    -- world: world -- service: Present content e.service
                    -- caly: effective_caly
                    # This is the lower level: `s3306_c_1_A_ii` is
                    # `s3306_a_2_B`, which asks (c) back. See "Cutting the two
                    # cycles"; here it is hardwired false.
                    -- agri_employers: [] }).holds
         and not (output of Excluded with {
                    -- world: world -- injections: injections
                    -- child_of: child_of -- sibling_of: sibling_of
                    -- descendent_of: descendent_of
                    -- stepsibling_of: stepsibling_of
                    -- service: Present content e.service
                    -- employer: Present content e.employer
                    -- employee: Present content e.employee
                    -- workday: workday }).holds))
    ++ (injected_employment of injections, service, employer, employee,
          workday, caly)

scope EmploymentLower:
  definition holds equals (number of solutions) > 0
```

