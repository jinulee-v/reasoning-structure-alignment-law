<!-- rtdf-document-id: sara/section3306 -->

> Module Section3306
> Using Definitions as W

```catala-metadata
declaration scope EmployerAndWages:
  input world content W.World
  input employer content W.Entity
  input period content W.TaxPeriod
  output is_employer content boolean
  output taxable_wages content money
  output general_wages content money
  output agricultural_wages content money
  output domestic_wages content money
```

```catala
declaration references_entity content boolean
  depends on values content list of W.Value,
             entity content W.Entity
  equals exists value among values such that
    match value with pattern
    -- W.Value.Known content known: false
    -- W.Value.Named content named: W.same_entity of named, entity

declaration service_is_excluded content boolean
  depends on service content W.Event,
             employer content W.Entity,
             employee content W.Entity
  equals
    W.has_value of service.purposes, W.KnownValue.ReligiousOrganization
    or W.has_value of service.locations, W.KnownValue.ForeignGovernment
    or W.has_value of service.locations, W.KnownValue.StateGovernment
    or service.kind != W.EventKind.Service

declaration payment_matches_service content boolean
  depends on payment content W.Event,
             service content W.Event,
             employer content W.Entity,
             employee content W.Entity
  equals
    payment.kind = W.EventKind.Payment
    and W.has_agent of payment, employer
    and references_entity of payment.purposes, service.identifier
    and W.has_agent of service, employee
    and W.has_patient of service, employer
    and not (service_is_excluded of service, employer, employee)

declaration family_service content boolean
  depends on world content W.World,
             employer content W.Entity,
             employee content W.Entity
  equals exists event among (W.relationship_and_return_events of world) such that
    ((event.kind = W.EventKind.Father
      or event.kind = W.EventKind.Mother
      or event.kind = W.EventKind.Son
      or event.kind = W.EventKind.Daughter)
     and ((W.has_agent of event, employer and W.has_patient of event, employee)
          or (W.has_agent of event, employee and W.has_patient of event, employer)))
    or (event.kind = W.EventKind.Marriage
        and W.has_agent of event, employer
        and W.has_agent of event, employee)

declaration payment_is_excluded content boolean
  depends on world content W.World,
             payment content W.Event,
             service content W.Event,
             employer content W.Entity,
             employee content W.Entity
  equals
    family_service of world, employer, employee
    or (service.locations != []
        and not (W.has_value of service.locations, W.KnownValue.UnitedStates))
    or employer_plan_payment_excluded of world, payment
    or noncash_nonbusiness_payment of payment, service
    or termination_plan_payment of world, payment, employee
    or noncash_agricultural_payment of payment, service
    or post_death_later_year_payment of world, payment, employee
    or statutory_service_excluded of world, service, employer, employee

declaration wages_for_employee content money
  depends on world content W.World,
             employer content W.Entity,
             employee content W.Entity,
             period content W.TaxPeriod,
             category content W.KnownValue
  equals
    Money.sum of
      (combine all payment among (W.financial_events_of_kind of world, W.EventKind.Payment)
       in amounts initially []
       with if W.overlaps_period of payment.starts, payment.ends, period
            and exists service among (W.employment_events_of_kind of world, W.EventKind.Service)
                such that payment_matches_service of payment, service,
                                                     employer, employee
                  and not (payment_is_excluded of world, payment, service,
                                                   employer, employee)
                  and (if category = W.KnownValue.OtherKnownValue
                       then not (W.has_value of service.purposes,
                                               W.KnownValue.AgriculturalLabor)
                            and not (W.has_value of service.types,
                                                  W.KnownValue.AgriculturalLabor)
                            and not (W.has_value of service.purposes,
                                                  W.KnownValue.DomesticService)
                            and not (W.has_value of service.types,
                                                  W.KnownValue.DomesticService)
                       else W.has_value of service.purposes, category
                            or W.has_value of service.types, category)
            then amounts ++ payment.amounts
            else amounts)

declaration all_wages_for_employee content money
  depends on world content W.World,
             employer content W.Entity,
             employee content W.Entity,
             period content W.TaxPeriod
  equals Money.sum of
    (combine all payment among (W.financial_events_of_kind of world, W.EventKind.Payment)
     in amounts initially []
     with if W.overlaps_period of payment.starts, payment.ends, period
          and exists service among (W.employment_events_of_kind of world, W.EventKind.Service)
              such that payment_matches_service of payment, service,
                                                   employer, employee
                and not (payment_is_excluded of world, payment, service,
                                                 employer, employee)
          then amounts ++ payment.amounts else amounts)

declaration wages_in_category content money
  depends on world content W.World,
             employer content W.Entity,
             period content W.TaxPeriod,
             category content W.KnownValue
  equals
    Money.sum of
      (combine all payment among (W.financial_events_of_kind of world, W.EventKind.Payment)
       in amounts initially []
       with if W.has_agent of payment, employer
               and W.overlaps_period of payment.starts, payment.ends, period
               and exists service among
                     (W.employment_events_of_kind of world, W.EventKind.Service)
                   such that exists employee among service.agents such that
                     payment_matches_service of payment, service,
                                                  employer, employee
                     and not (payment_is_excluded of world, payment, service,
                                                      employer, employee)
                     and (if category = W.KnownValue.OtherKnownValue
                          then not (W.has_value of service.purposes,
                                                  W.KnownValue.AgriculturalLabor)
                               and not (W.has_value of service.types,
                                                     W.KnownValue.AgriculturalLabor)
                               and not (W.has_value of service.purposes,
                                                     W.KnownValue.DomesticService)
                               and not (W.has_value of service.types,
                                                     W.KnownValue.DomesticService)
                          else W.has_value of service.purposes, category
                               or W.has_value of service.types, category)
            then amounts ++ (W.weighted_amounts of payment) else amounts)

declaration taxable_wage_total content money
  depends on world content W.World,
             employer content W.Entity,
             period content W.TaxPeriod
  equals Money.sum of
    (combine all service among (W.employment_events_of_kind of world, W.EventKind.Service)
     in amounts initially []
     with if W.has_patient of service, employer
             and W.overlaps_period of service.starts, service.ends, period
          then amounts ++ (map each employee among service.agents to
            (capped of
               (all_wages_for_employee of world, employer, employee, period))
            * (decimal of service.multiplicity))
          else amounts)
```

§3306. Definitions

(a) Employer

    (1) In general

    The term "employer" means, with respect to any calendar year, any person who-


```catala
scope EmployerAndWages:
  definition general_wages equals
    wages_in_category of world, employer, period, W.KnownValue.OtherKnownValue
  definition agricultural_wages equals
    wages_in_category of world, employer, period, W.KnownValue.AgriculturalLabor
  definition domestic_wages equals
    wages_in_category of world, employer, period, W.KnownValue.DomesticService
  definition is_employer equals
    general_employer_test of world, employer, period, general_wages
    or agricultural_employer_test of world, employer, period,
                                     agricultural_wages
    or domestic_employer_test of domestic_wages
```

        (A) during the calendar year or the preceding calendar year paid wages of $1,500 or more, or


<!-- rtdf-block-id: sara/section3306:b0004; role: provision; provision-id: sara/section3306(a)(1)(A); source-lines: 9-9; relation: formalizes-preceding -->
```catala
declaration general_wage_threshold content boolean
  depends on general_wages content money
  equals general_wages >= $1500
```

        (B) on each of some 10 days during the calendar year or during the preceding calendar year, each day being in a different calendar week, employed at least one individual in employment for some portion of the day.


<!-- rtdf-block-id: sara/section3306:b0005; role: provision; provision-id: sara/section3306(a)(1)(B); source-lines: 11-11; relation: formalizes-preceding -->
```catala
declaration general_ten_day_employment_test content boolean
  depends on world content W.World,
             employer content W.Entity,
             period content W.TaxPeriod
  equals
    let service_days equals
      combine all service among
        (W.employment_events_of_kind of world, W.EventKind.Service)
      in count initially 0
      with if W.has_patient of service, employer
              and W.overlaps_period of service.starts, service.ends, period
           then count + 1 else count in
    service_days >= 10
```

    For purposes of this paragraph, there shall not be taken into account any wages paid to, or employment of, an employee performing domestic services referred to in paragraph (3).


```catala
declaration general_employer_test content boolean
  depends on world content W.World,
             employer content W.Entity,
             period content W.TaxPeriod,
             general_wages content money
  equals general_wage_threshold of general_wages
         or general_ten_day_employment_test of world, employer, period
```

    (2) Agricultural labor

    In the case of agricultural labor, the term "employer" means, with respect to any calendar year, any person who-


```catala
declaration agricultural_employer_test content boolean
  depends on world content W.World,
             employer content W.Entity,
             period content W.TaxPeriod,
             agricultural_wages content money
  equals agricultural_wage_threshold of agricultural_wages
         or agricultural_ten_day_five_worker_test of world, employer, period
```

        (A) during the calendar year or the preceding calendar year paid wages of $20,000 or more for agricultural labor, or


<!-- rtdf-block-id: sara/section3306:b0008; role: provision; provision-id: sara/section3306(a)(2)(A); source-lines: 19-19; relation: formalizes-preceding -->
```catala
declaration agricultural_wage_threshold content boolean
  depends on agricultural_wages content money
  equals agricultural_wages >= $20000
```

        (B) on each of some 10 days during the calendar year or during the preceding calendar year, each day being in a different calendar week, employed at least 5 individuals in employment in agricultural labor for some portion of the day.


<!-- rtdf-block-id: sara/section3306:b0009; role: provision; provision-id: sara/section3306(a)(2)(B); source-lines: 21-21; relation: formalizes-preceding -->
```catala
declaration agricultural_ten_day_five_worker_test content boolean
  depends on world content W.World,
             employer content W.Entity,
             period content W.TaxPeriod
  equals
    let agricultural_occurrences equals
      combine all service among
        (W.employment_events_of_kind of world, W.EventKind.Service)
      in count initially 0
      with if W.has_patient of service, employer
              and W.overlaps_period of service.starts, service.ends, period
              and (W.has_value of service.purposes,
                                  W.KnownValue.AgriculturalLabor
                   or W.has_value of service.types,
                                     W.KnownValue.AgriculturalLabor)
           then count + service.multiplicity else count in
    agricultural_occurrences >= 50
```

    (3) Domestic service

    In the case of domestic service in a private home, local college club, or local chapter of a college fraternity or sorority, the term "employer" means, with respect to any calendar year, any person who during the calendar year or the preceding calendar year paid wages in cash of $1,000 or more for such service.


<!-- rtdf-block-id: sara/section3306:b0010; role: provision; provision-id: sara/section3306(a)(3); source-lines: 23-25; relation: formalizes-preceding -->
```catala
declaration domestic_employer_test content boolean
  depends on domestic_cash_wages content money
  equals domestic_cash_wages >= $1000
```

    (4) Special rule

    A person treated as an employer under paragraph (3) shall not be treated as an employer with respect to wages paid for any service other than domestic service referred to in paragraph (3) unless such person is treated as an employer under paragraph (1) or (2) with respect to such other service.


<!-- rtdf-block-id: sara/section3306:b0011; role: provision; provision-id: sara/section3306(a)(4); source-lines: 27-29; relation: formalizes-preceding -->
```catala
declaration domestic_only_employer_limitation content boolean
  depends on domestic_employer content boolean,
             general_or_agricultural_employer content boolean,
             wages_are_domestic content boolean
  equals not domestic_employer
         or general_or_agricultural_employer
         or wages_are_domestic
```

(b) Wages

For purposes of this chapter, the term "wages" means all remuneration for employment, including the cash value of all remuneration (including benefits) paid in any medium other than cash; except that such term shall not include-


```catala
scope EmployerAndWages:
  definition taxable_wages equals
    if not is_employer then $0
    else taxable_wage_total of world, employer, period
```

    (1) that part of the remuneration which, after remuneration (other than remuneration referred to in the succeeding paragraphs of this subsection) equal to $7,000 with respect to employment has been paid to an individual by an employer during any calendar year, is paid to such individual by such employer during such calendar year;


<!-- rtdf-block-id: sara/section3306:b0013; role: provision; provision-id: sara/section3306(b)(1); source-lines: 35-35; relation: formalizes-preceding -->
```catala
declaration capped content money
  depends on amount content money
  equals if amount <= $7000 then amount else $7000
```

    (2) the amount of any payment (including any amount paid by an employer for insurance or annuities, or into a fund, to provide for any such payment) made to, or on behalf of, an employee or any of his dependents under a plan or system established by an employer which makes provision for his employees generally (or for his employees generally and their dependents) or for a class or classes of his employees (or for a class or classes of his employees and their dependents), on account of-


```catala
declaration employer_plan_payment_excluded content boolean
  depends on world content W.World,
             payment content W.Event
  equals exists plan among (W.employment_events_of_kind of world, W.EventKind.Plan)
         such that W.has_patient of payment, plan.identifier
           and (sickness_or_disability_plan of plan
                or death_benefit_plan of plan)
```

        (A) sickness or accident disability, or


<!-- rtdf-block-id: sara/section3306:b0015; role: provision; provision-id: sara/section3306(b)(2)(A); source-lines: 39-39; relation: formalizes-preceding -->
```catala
declaration sickness_or_disability_plan content boolean
  depends on plan content W.Event
  equals W.has_value of plan.purposes, W.KnownValue.SicknessProvision
         or W.has_value of plan.purposes,
                               W.KnownValue.AccidentDisabilityProvision
```

        (C) death;


<!-- rtdf-block-id: sara/section3306:b0016; role: provision; provision-id: sara/section3306(b)(2)(C); source-lines: 41-41; relation: formalizes-preceding -->
```catala
declaration death_benefit_plan content boolean
  depends on plan content W.Event
  equals W.has_value of plan.purposes, W.KnownValue.DeathProvision
```

    (7) remuneration paid in any medium other than cash to an employee for service not in the course of the employer's trade or business;


<!-- rtdf-block-id: sara/section3306:b0017; role: provision; provision-id: sara/section3306(b)(7); source-lines: 43-43; relation: formalizes-preceding -->
```catala
declaration noncash_nonbusiness_payment content boolean
  depends on payment content W.Event,
             service content W.Event
  equals payment.means != []
         and not (W.has_value of payment.means, W.KnownValue.Cash)
         and W.has_value of service.reasons, W.KnownValue.OtherKnownValue
```

    (10) any payment or series of payments by an employer to an employee or any of his dependents which is paid-


```catala
declaration termination_plan_payment content boolean
  depends on world content W.World,
             payment content W.Event,
             employee content W.Entity
  equals termination_due_to_death_or_disability of world, employee
         and payment_under_employer_plan of world, payment
         and not (payment_would_continue_after_termination of payment)
```

        (A) upon or after the termination of an employee's employment relationship because of (i) death, or (ii) retirement for disability, and


<!-- rtdf-block-id: sara/section3306:b0019; role: provision; provision-id: sara/section3306(b)(10)(A); source-lines: 47-47; relation: formalizes-preceding -->
```catala
declaration termination_due_to_death_or_disability content boolean
  depends on world content W.World,
             employee content W.Entity
  equals exists event among
    ((W.relationship_and_return_events of world)
     ++ (W.personal_status_events of world)) such that
    (event.kind = W.EventKind.Death or event.kind = W.EventKind.Disability)
    and W.has_agent of event, employee
```

        (B) under a plan established by the employer which makes provision for his employees generally or a class or classes of his employees (or for such employees or class or classes of employees and their dependents),


<!-- rtdf-block-id: sara/section3306:b0020; role: provision; provision-id: sara/section3306(b)(10)(B); source-lines: 49-49; relation: formalizes-preceding -->
```catala
declaration payment_under_employer_plan content boolean
  depends on world content W.World,
             payment content W.Event
  equals exists plan among (W.employment_events_of_kind of world, W.EventKind.Plan)
         such that W.has_patient of payment, plan.identifier
```

    other than any such payment or series of payments which would have been paid if the employee's employment relationship had not been so terminated;


```catala
declaration payment_would_continue_after_termination content boolean
  depends on payment content W.Event
  equals W.has_value of payment.reasons, W.KnownValue.OtherKnownValue
```

    (11) remuneration for agricultural labor paid in any medium other than cash;


<!-- rtdf-block-id: sara/section3306:b0022; role: provision; provision-id: sara/section3306(b)(11); source-lines: 53-53; relation: formalizes-preceding -->
```catala
declaration noncash_agricultural_payment content boolean
  depends on payment content W.Event,
             service content W.Event
  equals (W.has_value of service.purposes, W.KnownValue.AgriculturalLabor
          or W.has_value of service.types, W.KnownValue.AgriculturalLabor)
         and payment.means != []
         and not (W.has_value of payment.means, W.KnownValue.Cash)
```

    (15) any payment made by an employer to a survivor or the estate of a former employee after the calendar year in which such employee died;


<!-- rtdf-block-id: sara/section3306:b0023; role: provision; provision-id: sara/section3306(b)(15); source-lines: 55-55; relation: formalizes-preceding -->
```catala
declaration post_death_later_year_payment content boolean
  depends on world content W.World,
             payment content W.Event,
             employee content W.Entity
  equals exists death among (W.relationship_events_of_kind of world, W.EventKind.Death)
         such that W.has_agent of death, employee
           and exists paid among payment.starts such that
             exists died among death.starts such that
               (Date.get_year of paid) > (Date.get_year of died)
```

(c) Employment

For purposes of this chapter, the term "employment" means any service, of whatever nature,


```catala
declaration statutory_service_excluded content boolean
  depends on world content W.World,
             service content W.Event,
             employer content W.Entity,
             employee content W.Entity
  equals
    not (service_geographically_covered of world, service, employer, employee)
    or family_service of world, employer, employee
    or federal_government_service of service
    or state_government_service of service
    or student_school_service of world, service, employee
    or student_spouse_school_service of world, service, employee
    or hospital_patient_service of world, service, employee
    or foreign_government_service of service
    or student_nurse_service of world, service, employee
    or international_organization_service of world, service, employer
    or penal_institution_service of world, service, employee
```

    (A) performed by an employee for the person employing him, irrespective of the citizenship or residence of either, within the United States, and


<!-- rtdf-block-id: sara/section3306:b0025; role: provision; provision-id: sara/section3306(c)(A); source-lines: 61-61; relation: formalizes-preceding -->
```catala
declaration service_within_united_states content boolean
  depends on service content W.Event
  equals service.locations = []
         or W.has_value of service.locations, W.KnownValue.UnitedStates
```

    (B) performed outside the United States (except in a contiguous country with which the United States has an agreement relating to unemployment compensation) by a citizen of the United States as an employee of an American employer, except-


<!-- rtdf-block-id: sara/section3306:b0026; role: provision; provision-id: sara/section3306(c)(B); source-lines: 63-63; relation: formalizes-preceding -->
```catala
declaration service_geographically_covered content boolean
  depends on world content W.World,
             service content W.Event,
             employer content W.Entity,
             employee content W.Entity
  equals
    service_within_united_states of service
    or ((exists citizenship among
          (W.status_events_of_kind of world, W.EventKind.Citizenship)
         such that W.has_agent of citizenship, employee
                   and W.has_value of citizenship.countries,
                                      W.KnownValue.UnitedStates)
        and (exists american among
               (W.employment_events_of_kind of world, W.EventKind.AmericanEmployer)
             such that W.has_agent of american, employer)
        and not (exists agreement among
                   (W.status_events_of_kind of world,
                                     W.EventKind.UnemploymentCompensationAgreement)
                 such that exists destination among service.locations
                     such that agreement.locations contains destination))
```

    (1) agricultural labor unless-


```catala
declaration agricultural_service_excluded content boolean
  depends on agricultural_service content boolean,
             agricultural_employer_qualifies content boolean,
             admitted_agricultural_alien content boolean
  equals agricultural_service
         and (not agricultural_employer_qualifies
              or admitted_agricultural_alien)
```

        (A) such labor is performed for a person who-


```catala
declaration agricultural_employment_exception content boolean
  depends on paid_twenty_thousand content boolean,
             ten_days_five_workers content boolean
  equals paid_twenty_thousand or ten_days_five_workers
```

            (i) during the calendar year or the preceding calendar year paid remuneration in cash of $20,000 or more to individuals employed in agricultural labor (including labor performed by an alien referred to in subparagraph (B)), or


<!-- rtdf-block-id: sara/section3306:b0029; role: provision; provision-id: sara/section3306(c)(1)(A)(i); source-lines: 69-69; relation: formalizes-preceding -->
```catala
declaration agricultural_twenty_thousand_test content boolean
  depends on agricultural_cash_wages content money
  equals agricultural_cash_wages >= $20000
```

            (ii) on each of some 10 days during the calendar year or the preceding calendar year, each day being in a different calendar week, employed in agricultural labor (including labor performed by an alien referred to in subparagraph (B)) for some portion of the day (whether or not at the same moment of time) 5 or more individuals; and


<!-- rtdf-block-id: sara/section3306:b0030; role: provision; provision-id: sara/section3306(c)(1)(A)(ii); source-lines: 71-71; relation: formalizes-preceding -->
```catala
declaration agricultural_five_workers_test content boolean
  depends on qualifying_day_worker_occurrences content integer
  equals qualifying_day_worker_occurrences >= 50
```

        (B) such labor is not agricultural labor performed by an individual who is an alien admitted to the United States to perform agricultural labor pursuant to sections 214(c) and 101(a)(15)(H) of the Immigration and Nationality Act.


<!-- rtdf-block-id: sara/section3306:b0031; role: provision; provision-id: sara/section3306(c)(1)(B); source-lines: 73-73; relation: formalizes-preceding -->
```catala
declaration admitted_agricultural_alien_exclusion content boolean
  depends on world content W.World,
             employee content W.Entity
  equals exists alien among
           (W.status_events_of_kind of world, W.EventKind.NonresidentAlien)
         such that W.has_agent of alien, employee
                   and W.has_value of alien.purposes,
                                      W.KnownValue.AgriculturalLabor
```

    (2) domestic service in a private home, local college club, or local chapter of a college fraternity or sorority unless performed for a person who paid cash remuneration of $1,000 or more to individuals employed in such domestic service in the calendar year or the preceding calendar year;


<!-- rtdf-block-id: sara/section3306:b0032; role: provision; provision-id: sara/section3306(c)(2); source-lines: 75-75; relation: formalizes-preceding -->
```catala
declaration domestic_service_employment_test content boolean
  depends on domestic_cash_wages content money
  equals domestic_cash_wages >= $1000
```

    (5) 

        (A) service performed by an individual in the employ of his son, daughter, or spouse;


<!-- rtdf-block-id: sara/section3306:b0033; role: provision; provision-id: sara/section3306(c)(5)(A); source-lines: 79-79; relation: formalizes-preceding -->
```catala
declaration son_daughter_or_spouse_service content boolean
  depends on world content W.World,
             employer content W.Entity,
             employee content W.Entity
  equals exists event among (W.relationship_and_return_events of world) such that
    ((event.kind = W.EventKind.Son or event.kind = W.EventKind.Daughter)
     and W.has_agent of event, employer and W.has_patient of event, employee)
    or (event.kind = W.EventKind.Marriage
        and W.has_agent of event, employer and W.has_agent of event, employee)
```

        (B) service performed by a child under the age of 21 in the employ of his father or mother;


<!-- rtdf-block-id: sara/section3306:b0034; role: provision; provision-id: sara/section3306(c)(5)(B); source-lines: 81-81; relation: formalizes-preceding -->
```catala
declaration child_under_twenty_one_parent_service content boolean
  depends on world content W.World,
             employer content W.Entity,
             employee content W.Entity,
             period content W.TaxPeriod
  equals exists event among (W.relationship_and_return_events of world) such that
    (event.kind = W.EventKind.Father or event.kind = W.EventKind.Mother)
    and W.has_agent of event, employer and W.has_patient of event, employee
    and exists birth among (W.relationship_events_of_kind of world, W.EventKind.Birth)
        such that W.has_agent of birth, employee
          and exists born among birth.starts such that
            period.tax_year - (Date.get_year of born) < 21
```

    (6) service performed in the employ of the United States Government


<!-- rtdf-block-id: sara/section3306:b0035; role: provision; provision-id: sara/section3306(c)(6); source-lines: 83-83; relation: formalizes-preceding -->
```catala
declaration federal_government_service content boolean
  depends on service content W.Event
  equals W.has_value of service.locations, W.KnownValue.Government
         or W.has_value of service.purposes, W.KnownValue.Government
```

    (7) service performed in the employ of a State, or any political subdivision thereof.


<!-- rtdf-block-id: sara/section3306:b0036; role: provision; provision-id: sara/section3306(c)(7); source-lines: 85-85; relation: formalizes-preceding -->
```catala
declaration state_government_service content boolean
  depends on service content W.Event
  equals W.has_value of service.locations, W.KnownValue.StateGovernment
         or W.has_value of service.purposes, W.KnownValue.StateGovernment
```

    (10)

        (A) service performed in the employ of a school, college, or university, if such service is performed


```catala
declaration educational_institution_service content boolean
  depends on service content W.Event
  equals W.has_value of service.locations, W.KnownValue.EducationalInstitution
         or W.has_value of service.purposes,
                           W.KnownValue.EducationalInstitution
```

            (i) by a student who is enrolled and is regularly attending classes at such school, college, or university, or


<!-- rtdf-block-id: sara/section3306:b0038; role: provision; provision-id: sara/section3306(c)(10)(A)(i); source-lines: 91-91; relation: formalizes-preceding -->
```catala
declaration student_school_service content boolean
  depends on world content W.World,
             service content W.Event,
             employee content W.Entity
  equals educational_institution_service of service
         and (exists enrollment among
                (W.status_events_of_kind of world, W.EventKind.Enrollment)
              such that W.has_agent of enrollment, employee)
         and (exists attendance among
                (W.status_events_of_kind of world, W.EventKind.AttendingClasses)
              such that W.has_agent of attendance, employee)
```

            (ii) by the spouse of such a student, or


<!-- rtdf-block-id: sara/section3306:b0039; role: provision; provision-id: sara/section3306(c)(10)(A)(ii); source-lines: 93-93; relation: formalizes-preceding -->
```catala
declaration student_spouse_school_service content boolean
  depends on world content W.World,
             service content W.Event,
             employee content W.Entity
  equals educational_institution_service of service
         and (exists marriage among
                (W.relationship_events_of_kind of world, W.EventKind.Marriage)
              such that W.has_agent of marriage, employee
                and exists spouse among marriage.agents such that
                  not (W.same_entity of spouse, employee)
                  and exists enrollment among
                    (W.status_events_of_kind of world, W.EventKind.Enrollment)
                  such that W.has_agent of enrollment, spouse)
```

        (B) service performed in the employ of a hospital, if such service is performed by a patient of such hospital;


<!-- rtdf-block-id: sara/section3306:b0040; role: provision; provision-id: sara/section3306(c)(10)(B); source-lines: 95-95; relation: formalizes-preceding -->
```catala
declaration hospital_patient_service content boolean
  depends on world content W.World,
             service content W.Event,
             employee content W.Entity
  equals (W.has_value of service.locations, W.KnownValue.Hospital)
         and exists patient_event among
               (W.status_events_of_kind of world, W.EventKind.MedicalPatient)
             such that W.has_agent of patient_event, employee
```

    (11) service performed in the employ of a foreign government (including service as a consular or other officer or employee or a nondiplomatic representative);


<!-- rtdf-block-id: sara/section3306:b0041; role: provision; provision-id: sara/section3306(c)(11); source-lines: 97-97; relation: formalizes-preceding -->
```catala
declaration foreign_government_service content boolean
  depends on service content W.Event
  equals W.has_value of service.locations, W.KnownValue.ForeignGovernment
         or W.has_value of service.purposes, W.KnownValue.ForeignGovernment
```

    (13) service performed as a student nurse in the employ of a hospital or a nurses' training school by an individual who is enrolled and is regularly attending classes in a nurses' training school;


<!-- rtdf-block-id: sara/section3306:b0042; role: provision; provision-id: sara/section3306(c)(13); source-lines: 99-99; relation: formalizes-preceding -->
```catala
declaration student_nurse_service content boolean
  depends on world content W.World,
             service content W.Event,
             employee content W.Entity
  equals (W.has_value of service.locations, W.KnownValue.Hospital
          or exists school among
               (W.employment_events_of_kind of world, W.EventKind.NursesTrainingSchool)
             such that W.has_patient of service, school.identifier)
         and exists enrollment among
               (W.status_events_of_kind of world, W.EventKind.Enrollment)
             such that W.has_agent of enrollment, employee
         and exists attendance among
               (W.status_events_of_kind of world, W.EventKind.AttendingClasses)
             such that W.has_agent of attendance, employee
```

    (16) service performed in the employ of an international organization;


<!-- rtdf-block-id: sara/section3306:b0043; role: provision; provision-id: sara/section3306(c)(16); source-lines: 101-101; relation: formalizes-preceding -->
```catala
declaration international_organization_service content boolean
  depends on world content W.World,
             service content W.Event,
             employer content W.Entity
  equals exists organization among
           (W.employment_events_of_kind of world, W.EventKind.InternationalOrganization)
         such that W.has_agent of organization, employer
                   or W.has_patient of service, organization.identifier
```

    (21) service performed by a person committed to a penal institution.

<!-- rtdf-block-id: sara/section3306:b0044; role: provision; provision-id: sara/section3306(c)(21); source-lines: 103-103; relation: formalizes-preceding -->
```catala
declaration penal_institution_service content boolean
  depends on world content W.World,
             service content W.Event,
             employee content W.Entity
  equals exists incarceration among
           (W.status_events_of_kind of world, W.EventKind.Incarceration)
         such that W.has_agent of incarceration, employee
           and (exists institution among
                  (W.employment_events_of_kind of world, W.EventKind.PenalInstitution)
                such that W.has_patient of service, institution.identifier)
```
