declaration scope EmploymentLower:
  input world content W.World
  input injections content list of W.Injection
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input service content optional of W.Entity
  input employer content optional of W.Entity
  input employee content optional of W.Entity
  input workday content optional of date
  input caly content optional of integer
  ## The calendar year the clause actually uses: named by the caller, unless a
  ## workday was named, in which case it is that day's year.
  output effective_caly content optional of integer
  output solutions content list of Emp
  output holds content boolean
