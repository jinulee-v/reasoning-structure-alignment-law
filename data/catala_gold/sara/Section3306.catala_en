## One row of a `findall` that collects an amount together with the employee
## and service it was paid for -- §3306(a)(2)(A), (a)(3) and (c)(1)(A)(i) all
## collect that shape.

declaration structure AgriRow:
  data amount content money
  data employee content W.Entity
  data service content W.Entity
  data multiplicity content integer

declaration flatten_agri content list of AgriRow
  depends on nested content list of list of AgriRow
  equals combine all inner among nested in acc initially [] with acc ++ inner

## `n` copies of one solution. Several goals in a §3306 conjunction can match
## more than one fact, and `sum_list` over a `findall` counts every one of
## them; collapsing to a set would understate the wages.

declaration weighted_amount content money
  depends on amount content money, multiplicity content integer
  equals amount * (decimal of multiplicity)

## Only direct compatibility tests need the duplicate-preserving employee
## projection.  The tax computation consumes scalar multiplicities instead.

declaration expand_agri_employees content list of W.Entity
  depends on rows content list of AgriRow
  equals
    combine all r among rows in acc initially []
    with acc ++
      (map each i among (List.sequence of 1, (r.multiplicity + 1))
       to r.employee)

## `(\+ means_(P,_)) ; means_(P,"cash")` -- the number of ways a payment
## counts as made in cash.

declaration cash_ways content integer
  depends on pay content W.PaymentEvent
  equals
    if (number of pay.media) = 0
    then 1
    else (number of (list of m among pay.media such that m = W.Medium.Cash))

declaration entity_of_place content optional of W.Entity
  depends on world content W.World, g content W.Place
  equals
    match g with pattern
    -- NamedPlace content e: Present content e
    -- Usa:
        List.first_element of
          (list of e among (map each fact among world.country_facts to fact.subject)
           such that e.tag = W.EntityTag.UsaEntity)
    -- PrivateHome: Absent
    -- LocalCollegeClub: Absent
    -- LocalCollegeFraternityChapter: Absent
    -- LocalCollegeSororityChapter: Absent
    -- UnitedStatesGovernment: Absent

## `country_(G,C)` for a place.

declaration countries_of_place content list of W.Entity
  depends on world content W.World, g content W.Place
  equals
    match (entity_of_place of world, g) with pattern
    -- Absent: []
    -- Present content e: fact_countries of world, e

## `G == "usa"`, the atom comparison the Prolog falls back on when the place
## has no `country_` row at all.

declaration place_is_usa content boolean
  depends on g content W.Place
  equals
    match g with pattern
    -- Usa: true
    -- NamedPlace content e: e.tag = W.EntityTag.UsaEntity
    -- PrivateHome: false
    -- LocalCollegeClub: false
    -- LocalCollegeFraternityChapter: false
    -- LocalCollegeSororityChapter: false
    -- UnitedStatesGovernment: false

## `((country_(G,C), C=="usa") ; (\+ country_(G,_), G=="usa"))`.

declaration place_in_usa content boolean
  depends on world content W.World, g content W.Place
  equals
    (let countries equals countries_of_place of world, g in
     (exists c among countries such that c.tag = W.EntityTag.UsaEntity)
     or ((number of countries) = 0 and (place_is_usa of g)))

## The same test with the sign flipped, as (B) writes it: a place that is in
## some country other than the USA, or that is not the atom "usa".

declaration place_outside_usa content boolean
  depends on world content W.World, g content W.Place
  equals
    (let countries equals countries_of_place of world, g in
     (exists c among countries such that c.tag != W.EntityTag.UsaEntity)
     or ((number of countries) = 0 and not (place_is_usa of g)))

## `location_(Service,G) ; (\+ location_(Service,_), G = "usa")` -- the places
## a service was performed at, defaulting to the USA.

declaration places_of content list of W.Place
  depends on places content list of W.Place
  equals if (number of places) = 0 then [W.Place.Usa] else places

declaration place_is content boolean
  depends on g content W.Place, e content W.Entity
  equals
    match g with pattern
    -- NamedPlace content x: x.id = e.id
    -- Usa: e.tag = W.EntityTag.UsaEntity
    -- PrivateHome: false
    -- LocalCollegeClub: false
    -- LocalCollegeFraternityChapter: false
    -- LocalCollegeSororityChapter: false
    -- UnitedStatesGovernment: e.tag = W.EntityTag.UnitedStatesGovernmentEntity

declaration place_ok content boolean
  depends on g content W.Place, want content optional of W.Entity
  equals
    match want with pattern
    -- Absent: true
    -- Present content e: place_is of g, e

## The four places §3306(c)(2) names as private domestic settings.

declaration is_private_setting content boolean
  depends on g content W.Place
  equals
    g = W.Place.PrivateHome or g = W.Place.LocalCollegeClub
    or g = W.Place.LocalCollegeFraternityChapter
    or g = W.Place.LocalCollegeSororityChapter

declaration structure Emp:
  data service content W.Entity
  data employer content W.Entity
  data employee content W.Entity
  data workday content optional of date
  data caly content optional of integer
  data multiplicity content integer

declaration flatten_emp content list of Emp
  depends on nested content list of list of Emp
  equals combine all inner among nested in acc initially [] with acc ++ inner

## An argument recovered from an injected row, falling back on what the query
## asked for when the row left that position a don't-care.

declaration ent_from content W.Entity
  depends on got content optional of W.Entity, want content optional of W.Entity
  equals
    match got with pattern
    -- Present content e: e
    -- Absent:
        (match want with pattern
         -- Present content e: e
         -- Absent: W.Entity { -- id: -1 -- tag: W.EntityTag.PlainEntity })

## The match key for a (possibly unbound) entity argument.

declaration key_of content integer
  depends on want content optional of W.Entity
  equals
    match want with pattern
    -- Absent: -1
    -- Present content e: e.id

declaration date_key_of content integer
  depends on want content optional of date
  equals
    match want with pattern
    -- Absent: -1
    -- Present content d: 2000000 + (integer of ((d - |0001-01-01|) / 1 day)) + 1

declaration num_key_of content integer
  depends on want content optional of integer
  equals
    match want with pattern
    -- Absent: -1
    -- Present content n: W.num_key of n

declaration injected_employment content list of Emp
  depends on injections content list of W.Injection,
             service content optional of W.Entity,
             employer content optional of W.Entity,
             employee content optional of W.Entity,
             workday content optional of date,
             caly content optional of integer
  equals
    map each inj among
      ((W.injections_for_5_12345 of injections, P.pred_s3306_c_5, (key_of of service), (key_of of employer), (key_of of employee), (date_key_of of workday), (num_key_of of caly)))
    to Emp {
      -- service: ent_from of (W.injection_entity of inj, 1), service
      -- employer: ent_from of (W.injection_entity of inj, 2), employer
      -- employee: ent_from of (W.injection_entity of inj, 3), employee
      -- workday:
           (match (W.injection_date of inj, 4) with pattern
            -- Present content d: Present content d
            -- Absent: workday)
      -- caly:
           (match (W.injection_num of inj, 5) with pattern
            -- Present content n: Present content n
            -- Absent: caly)
      -- multiplicity: 1 }

declaration starts_of content list of date
  depends on world content W.World, e content W.Entity
  equals
    payment_starts of world, e

## `start_(Remuneration,Time)` where the row left `Remuneration` *unbound* --
## which is what `s3306_a_1_A_pos` does, injecting
## `s3306_b(3200,_,bob_works,alice,bob,alice,bob,_)`. An unbound first argument
## makes `start_/2` a generator over every start date in the world, and the
## wages are then counted once per date rather than once. A negative id is how
## an injected don't-care arrives here.

declaration starts_for content list of date
  depends on world content W.World, e content W.Entity
  equals
    if e.id < 0
    then
      (flatten_dates of
        (map each ev among (W.payment_event_values of world) to ev.starts))
      ++ (flatten_dates of
           (map each ev among (W.service_event_values of world) to ev.starts))
      ++ (map each fact among world.start_facts to fact.value)
    else starts_of of world, e

## The event a wage row's employment names, for reading its purposes back.

declaration purposes_of content list of W.Purpose
  depends on world content W.World, e content W.Entity
  equals
    service_purposes of world, e

declaration scope EmployerWages:
  input world content W.World
  input injections content list of W.Injection
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input child_in_law_of content list of K.Kinship
  input parent_in_law_of content list of K.Kinship
  input sibling_in_law_of content list of K.Kinship
  input agri_employers content list of AgriYear
  input person content W.Entity
  input caly content integer
  ## Every `s3306_b/8` row this person paid.
  output paid content list of WageRow
  ## s3306_a_1_A/3
  output general_total content money
  output holds_1_A content boolean
  ## The (amount, employee, service) rows (a)(2)(A) and (a)(3) collect.
  internal agri_rows content list of AgriRow
  internal domestic_rows content list of AgriRow
  ## s3306_a_2_A/4
  output agri_total content money
  output agri_services content list of W.Entity
  output holds_2_A content boolean
  ## s3306_a_3/4
  output domestic_total content money
  output domestic_services content list of W.Entity
  output holds_3 content boolean

declaration dates_in_window content list of date
  depends on ds content list of date, caly content integer
  equals
    list of d among ds such that
      (W.first_day_year of (caly - 1)) <= d and d <= (W.last_day_year of caly)

## §3306(a)(1)(A) reaches back a year -- "during the calendar year or the
## preceding calendar year" -- but `total_wages_employer/6` does not: §3301 is
## handed `first_day_year(Caly)` and `last_day_year(Caly)` and tests the
## remuneration against those. A payment made in the year before the one taxed
## makes its payer an employer without being wages of that year. See D53.

declaration dates_in_year content list of date
  depends on ds content list of date, caly content integer
  equals
    list of d among ds such that
      (W.first_day_year of caly) <= d and d <= (W.last_day_year of caly)

declaration agri_purpose_hits content list of W.Purpose
  depends on world content W.World, e content W.Entity
  equals
    (list of x among (purposes_of of world, e)
     such that x = W.Purpose.AgriculturalLabor)
    ++ (list of x among world.universal_purposes
        such that x = W.Purpose.AgriculturalLabor)

declaration domestic_purpose_hits content list of W.Purpose
  depends on world content W.World, e content W.Entity
  equals
    (list of x among (purposes_of of world, e)
     such that x = W.Purpose.DomesticService)
    ++ (list of x among world.universal_purposes
        such that x = W.Purpose.DomesticService)

declaration cash_ways_of content integer
  depends on world content W.World, e content W.Entity
  equals
    (let media equals payment_media of world, e in
     if (number of media) = 0
     then 1
     else number of (list of m among media such that m = W.Medium.Cash))

declaration scope Employer:
  input world content W.World
  input injections content list of W.Injection
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input child_in_law_of content list of K.Kinship
  input parent_in_law_of content list of K.Kinship
  input sibling_in_law_of content list of K.Kinship
  input agri_employers content list of AgriYear
  input person content W.Entity
  input caly content integer
  employer_wages scope EmployerWages
  employer_days scope EmployerDays
  ## s3306_a_1/2
  output holds_1 content boolean
  ## s3306_a_2/2
  output holds_2 content boolean
  ## s3306_a_3/4
  output holds_3 content boolean
  ## s3306_a/2
  output holds content boolean

declaration scope AgriEmployerYears:
  input world content W.World
  input injections content list of W.Injection
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input taxable_year content integer
  ## The years any caller can ask about: the one named, and the year of every
  ## date the world mentions.
  output years content list of integer
  output candidates content list of W.Entity
  output pairs content list of AgriYear

declaration flatten_agri_year content list of AgriYear
  depends on nested content list of list of AgriYear
  equals combine all inner among nested in acc initially [] with acc ++ inner

declaration structure IndividualWage:
  data individual content W.Entity
  data total content money

declaration scope TotalWages:
  input world content W.World
  input injections content list of W.Injection
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input child_in_law_of content list of K.Kinship
  input parent_in_law_of content list of K.Kinship
  input sibling_in_law_of content list of K.Kinship
  input agri_employers content list of AgriYear
  input employer content W.Entity
  input caly content integer
  ## The `(Individual, Wages, Service)` triples, in order.
  output rows content list of AgriRow
  output individuals content list of W.Entity
  output services content list of W.Entity
  output capped content list of IndividualWage
  internal total_grant content W.InjectedMoneyResult
  output total content money
  ## Did the goal succeed at all? An injected grant answers this directly.
  output holds content boolean

declaration structure UnemploymentTaxResult:
  data is_employer content boolean
  data wages content money
  data tax content money
  data holds content boolean
  data applicable_tax content money

## The four injected predicates that can create an employer, employment, wage,
## or total-wage solution without a declared payment/service occurrence.
declaration has_unemployment_evidence content boolean
  depends on world content W.World,
             injections content list of W.Injection
  equals
    (number of (W.payment_event_values of world)) > 0
    or (number of (W.service_event_values of world)) > 0
    or (exists inj among injections such that
          inj.pred = P.pred_s3306_a_2
          or inj.pred = P.pred_s3306_b_8
          or inj.pred = P.pred_s3306_c_5
          or inj.pred = P.pred_total_wages_employer_6)

## Full §3306 calculation, entered only when the world has evidence capable of
## producing one of its conclusions.
declaration scope UnemploymentTaxCalculation:
  input world content W.World
  input injections content list of W.Injection
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input child_in_law_of content list of K.Kinship
  input parent_in_law_of content list of K.Kinship
  input sibling_in_law_of content list of K.Kinship
  input employer content W.Entity
  input caly content integer
  agri_employer_years scope AgriEmployerYears
  ## Shared by the employer-threshold and taxable-wage calculations.  Before
  ## this cache, both child scopes independently expanded the complete
  ## payment/employment relation with identical inputs.
  wage_rows scope Wages
  employer_days scope EmployerDays
  internal wage_grant content W.InjectedMoneyResult
  ## s3306_a/2 — is this person an employer at all?
  output is_employer content boolean
  output wages content money
  ## `Tax is round(0.06*Wages)` — s3301/6
  output tax content money
  output holds content boolean
  ## §1's employment-tax contribution: no tax unless §3306(a) holds.
  output applicable_tax content money

## Stable public interface. `result` is a semantic fast path for a world in
## which the full calculation can only return false and zero values.
declaration scope UnemploymentTax:
  input world content W.World
  input injections content list of W.Injection
  input child_of content list of K.Kinship
  input sibling_of content list of K.Kinship
  input descendent_of content list of K.Kinship
  input stepsibling_of content list of K.Kinship
  input child_in_law_of content list of K.Kinship
  input parent_in_law_of content list of K.Kinship
  input sibling_in_law_of content list of K.Kinship
  input employer content W.Entity
  input caly content integer
  internal result content UnemploymentTaxResult
  output is_employer content boolean
  output wages content money
  output tax content money
  output holds content boolean
  output applicable_tax content money

## Row aggregations shared by the public component scopes and the fused
## UnemploymentTax path.  Keeping multiplicity scalar here avoids rebuilding
## or expanding the same wage relation merely to project a different total.

declaration general_wages_total content money
  depends on world content W.World,
             paid content list of WageRow,
             caly content integer
  equals
    Money.sum of
      (map each r among
        (list of x among paid such that
           (let purposes equals purposes_of of world, x.employment in
              not (purposes contains W.Purpose.AgriculturalLabor)
              and not (world.universal_purposes
                         contains W.Purpose.AgriculturalLabor)
              and not (purposes contains W.Purpose.DomesticService)
              and not (world.universal_purposes
                         contains W.Purpose.DomesticService)))
       to (weighted_amount of r.wages,
             (r.multiplicity
              * (number of (dates_in_window of
                               (starts_for of world, r.remuneration), caly)))))

declaration agricultural_wage_rows content list of AgriRow
  depends on world content W.World,
             paid content list of WageRow,
             caly content integer
  equals
    map each r among
      (list of r among paid such that
         (r.multiplicity
          * (number of (dates_in_window of
                           (starts_for of world, r.remuneration), caly))
          * (number of (agri_purpose_hits of world, r.employment))) > 0)
    to AgriRow {
         -- amount: r.wages -- employee: r.payee -- service: r.employment
         -- multiplicity:
              r.multiplicity
              * (number of (dates_in_window of
                               (starts_for of world, r.remuneration), caly))
              * (number of (agri_purpose_hits of world, r.employment)) }

declaration agricultural_wages_total content money
  depends on world content W.World,
             paid content list of WageRow,
             caly content integer
  equals
    Money.sum of
      (map each r among (agricultural_wage_rows of world, paid, caly)
       to (weighted_amount of r.amount, r.multiplicity))

declaration domestic_wage_rows content list of AgriRow
  depends on world content W.World,
             paid content list of WageRow,
             caly content integer
  equals
    map each r among
      (list of r among paid such that
         (r.multiplicity
          * (number of (dates_in_window of
                           (starts_for of world, r.remuneration), caly))
          * (number of (domestic_purpose_hits of world, r.employment))
          * (cash_ways_of of world, r.remuneration)) > 0)
    to AgriRow {
         -- amount: r.wages -- employee: r.payee -- service: r.employment
         -- multiplicity:
              r.multiplicity
              * (number of (dates_in_window of
                               (starts_for of world, r.remuneration), caly))
              * (number of (domestic_purpose_hits of world, r.employment))
              * (cash_ways_of of world, r.remuneration) }

declaration domestic_wages_total content money
  depends on world content W.World,
             paid content list of WageRow,
             caly content integer
  equals
    Money.sum of
      (map each r among (domestic_wage_rows of world, paid, caly)
       to (weighted_amount of r.amount, r.multiplicity))

declaration taxable_wage_rows content list of AgriRow
  depends on world content W.World,
             paid content list of WageRow,
             employer content W.Entity,
             caly content integer
  equals
    map each r among
      (list of r among paid such that
         r.employer.id = employer.id
         and (number of (dates_in_year of
                           (starts_for of world, r.remuneration), caly)) > 0)
    to AgriRow {
         -- amount: r.wages -- employee: r.payee -- service: r.employment
         -- multiplicity:
              r.multiplicity
              * (number of (dates_in_year of
                               (starts_for of world, r.remuneration), caly)) }

declaration total_wages_amount content money
  depends on world content W.World,
             paid content list of WageRow,
             employer content W.Entity,
             caly content integer
  equals
    (let rows equals taxable_wage_rows of world, paid, employer, caly in
     let individuals equals
       dedup_entities of (map each r among rows to r.employee) in
     Money.sum of
       (map each ind among individuals
        to Money.min of $7,000,
             (Money.sum of
               (map each r among
                 (list of x among rows such that x.employee.id = ind.id)
                to (weighted_amount of r.amount, r.multiplicity)))))
```


