<!-- rtdf-block-id: sara/section3306:b0042; role: provision; provision-id: sara/section3306(c)(13); source-lines: 99-99; relation: formalizes-preceding -->
```catala
scope ExclStudentNurse:
  definition holds equals
    exists eid among (service_ids of world) such that
      (ent_ok of service, eid)
      and (exists p among (service_patients of world, eid) such that
             (ent_ok of employer, p)
             # the employer is a nurses' training school or a hospital
             and ((exists h among (W.nurses_training_school_event_values of world)
                   such that W.optional_entity_equals of h.agents, p)
                  or (exists h among (W.hospital_event_values of world)
                      such that W.optional_entity_equals of h.agents, p)))
      and (exists a among (service_agents of world, eid) such that
             (ent_ok of employee, a)
             # enrolled at, and attending classes at, *some* nurses' training
             # school -- not necessarily the employer, as the Prolog writes it
             and (exists nts among (W.nurses_training_school_event_values of world) such that
                    (exists school among (W.entity_values of nts.agents) such that
                           (exists en among (W.enrollment_event_values of world) such that
                              en.agents contains a
                              and (W.optional_entity_equals of en.patients, school)
                              and (open_at of (W.date_values of en.starts), (W.date_values of en.ends), workday))
                           and (exists ac among (W.attending_classes_event_values of world) such that
                                  (W.optional_entity_equals of ac.agents, a)
                                  and (exists g among (W.place_values of ac.places) such that
                                         place_is of g, school)
                                  and (open_at of (W.date_values of ac.starts), (W.date_values of ac.ends), workday)))))
```

