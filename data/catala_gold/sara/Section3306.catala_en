    (5)

        (A) service performed by an individual in the employ of his son, daughter, or spouse;


<!-- rtdf-block-id: sara/section3306:b0033; role: provision; provision-id: sara/section3306(c)(5)(A); source-lines: 79-79; relation: formalizes-preceding -->
```catala
scope ExclFamily:
  definition holds_a equals
    exists ev among (W.service_event_values of world) such that
      (ent_ok of service, ev.ident)
      and (exists a among ev.agents such that
             (ent_ok of agent, a)
             and (exists p among ev.patients such that
                    (ent_ok of patient, p)
                    and (
                      # the employer is a child of the employee ...
                      (exists k among child_of such that
                         k.subject.id = p.id and k.object.id = a.id)
                      # ... or they are married, on the workday
                      or (exists m among (W.marriage_event_values of world) such that
                            m.agents contains p and m.agents contains a
                            and p.id != a.id
                            and (open_at of m.starts, (W.date_values of m.ends), workday)))))

scope ExclFamily:
  definition holds equals holds_a or holds_b
```

```catala-metadata
declaration scope ExclFamily:
  input world content W.World
  input child_of content list of K.Kinship
  input service content optional of W.Entity
  #  `agent_(Service,Employee)` and `patient_(Service,Employer)`: the person
  #  doing the work and the person they do it for. Named after the roles they
  #  read rather than after the statute, because (A) and (B) swap which of the
  #  two has to be the child.
  input agent content optional of W.Entity
  input patient content optional of W.Entity
  input workday content optional of date
  # s3306_c_5_A/4
  output holds_a content boolean
  # s3306_c_5_B/4
  output holds_b content boolean
  output holds content boolean
```



