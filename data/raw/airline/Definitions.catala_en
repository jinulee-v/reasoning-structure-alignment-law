declaration enumeration EliteStatus: # Passenger loyalty tier, including equivalent partner-program statuses.
  -- NoStatus # No elite loyalty status.
  -- Gold # AAdvantage Gold, oneworld Ruby, or GOL Diamond Smiles status.
  -- Platinum # AAdvantage Platinum or oneworld Sapphire status.
  -- PlatinumPro # AAdvantage Platinum Pro or oneworld Emerald status.
  -- ExecutivePlatinum # AAdvantage Executive Platinum status.

declaration enumeration MilitaryStatus: # Active U.S. military affiliation and travel purpose.
  -- NotMilitary # No qualifying active U.S. military affiliation recorded.
  -- OnOrders # Active U.S. military member or dependent with ID traveling on military orders.
  -- PersonalTravel # Active U.S. military member with ID traveling for personal reasons.

declaration enumeration ItemKind: # Type of baggage or other item accompanying the passenger.
  -- OrdinaryBag # Standard suitcase or other ordinary bag.
  -- SoftSidedGarmentBag # Soft-sided bag for transporting clothing on hangers.
  -- DiaperBag # Bag containing diapers and other child-care supplies.
  -- BreastPump # Breast pump equipment.
  -- BreastMilkCooler # Small soft-sided cooler containing breast milk.
  -- ChildSafetySeat # Child safety seat.
  -- Stroller # Child stroller.
  -- MedicalOrMobilityDevice # Medical equipment or a device assisting mobility.

declaration structure Item: # One piece of baggage or other item accompanying the passenger.
  data kind content ItemKind # Type of item.
  data length content integer # Outside length in inches; nonnegative.
  data width content integer # Outside width in inches; nonnegative.
  data height content integer # Outside height in inches; nonnegative.
  data weight content integer # Weight in pounds; nonnegative.

declaration size_sum content integer # Sum of an item's outside length, width, and height, in inches.
  depends on it content Item
  equals it.length + it.width + it.height

declaration structure Itinerary: # Passenger travel details, accompanying items, and recorded eligibility attributes.
  data origin content City # City of departure.
  data destination content City # City of arrival.
  data cabin content Cabin # Passenger's ticketed cabin or fare category.
  data ticket content money # Base ticket price in U.S. dollars before baggage fees; nonnegative.
  data items content list of Item # Items accompanying the passenger, in their recorded order.
  data status_at_ticketing content EliteStatus # Passenger loyalty status when the ticket was issued.
  data status_at_checkin content EliteStatus # Passenger loyalty status at check-in.
  data cardmember content boolean # True if the passenger is an eligible AAdvantage Aviator or Citi / AAdvantage cardmember.
  data military content MilitaryStatus # Passenger's active U.S. military affiliation and travel purpose.
  data flagship content boolean # True if the passenger has a confirmed Flagship First or Flagship Business Plus fare.
  data children content integer # Number of children traveling with the passenger; nonnegative.

declaration origin_country content Country # Country, territory, or region of departure.
  depends on t content Itinerary
  equals country_of of t.origin

declaration destination_country content Country # Country, territory, or region of arrival.
  depends on t content Itinerary
  equals country_of of t.destination

declaration touches content boolean # True if at least one itinerary endpoint belongs to the supplied set of countries, territories, or regions.
  depends on t content Itinerary, cs content list of Country
  equals (cs contains (origin_country of t)) or (cs contains (destination_country of t))

declaration within content boolean # True if both itinerary endpoints belong to the supplied set of countries, territories, or regions.
  depends on t content Itinerary, cs content list of Country
  equals (cs contains (origin_country of t)) and (cs contains (destination_country of t))
```
