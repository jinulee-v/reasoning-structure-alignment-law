# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Userspace toolchain: micromamba envs (swipl, ocaml) and the opam switch that
# carries Catala 1.2.  Rebuilt by `install_toolchain.sh`.
/.toolchain/

# Everything generated lives here: the two differential-testing ports, written
# by `python3 prolog_to_catala/<port>/generate_test_cases.py`, and the two
# concolic trees, written by `python3 cutecat_scripts/generate_dataset.py` ---
# build directories, the raw capture of CUTECat's output and the JSONL alike.
# `rm -rf .port` is always safe: every script here puts its own back.
/.port/

# The compiled Catala modules of either port; the sources are tracked.
/data/catala_gold/*/_build/
/data/catala_gold/*/_targets/
/data/catala_gold/*/cases/

# Editor and OS files
.idea/
.vscode/
*.swp
*~
.DS_Store

# Snapshots of the SARA port taken before git existed here.  Kept on disk,
# out of history: git is the backup now.
/sara_catala_backup/

# Left over from a rebuild of the toolchain; safe to delete.
/.toolchain.old/
/logs/
