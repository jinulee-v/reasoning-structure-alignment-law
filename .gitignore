.idea/
.vscode/
*.swp
*~
.DS_Store

# Snapshots of sara_catala/ taken before git existed here.  Kept on disk,
# out of history: git is the backup now.
/sara_catala_backup/

# Left over from a rebuild of the toolchain; safe to delete.
/.toolchain.old/
/logs/
